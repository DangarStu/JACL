# Generated by configure from Makefile.in

CC = @CC@
CFLAGS = @CFLAGS@

# Directories
CGIHTML_DIR = @CGIHTML_DIR@
GLKTERM_DIR = @GLKTERM_DIR@

# Detected library flags
NCURSES_CFLAGS = @NCURSES_CFLAGS@
NCURSES_LIBS = @NCURSES_LIBS@
FCGI_CFLAGS = @FCGI_CFLAGS@
FCGI_LIBS = @FCGI_LIBS@

# Source files
COMMON_SRC = @COMMON_SRC@

# Targets determined by configure
BUILD_TARGETS = @BUILD_TARGETS@

all: $(BUILD_TARGETS)

# Bjorb target
bjorb: bjorb.c
	$(CC) $(CFLAGS) -o bjorb bjorb.c

# Jacl target (GlkTerm console, requires ncurses)
jacl: libglkterm.a
	$(CC) $(CFLAGS) -DGLK jacl.c glk_startup.c $(COMMON_SRC) glk_saver.c -I$(GLKTERM_DIR) -L$(GLKTERM_DIR) -lglkterm -lm $(NCURSES_LIBS) -o jacl

# Cgijacl target (CGI web)
cgijacl: libcgihtml.a webjacl.o
	$(CC) $(CFLAGS) -DWEBJACL cgijacl.c $(COMMON_SRC) saver.c webjacl.o -I$(CGIHTML_DIR) -Iwebjacl -L$(CGIHTML_DIR) -lcgihtml -lm -o cgijacl

# Fcgijacl target (FastCGI web, requires libfcgi)
fcgijacl: libcgihtml.a
	$(CC) $(CFLAGS) -DFCGIJACL cgijacl.c $(COMMON_SRC) saver.c -I$(CGIHTML_DIR) -L$(CGIHTML_DIR) -lcgihtml $(FCGI_CFLAGS) $(FCGI_LIBS) -lm -o fcgijacl

# webjacl.o target
webjacl.o: webjacl.c webjacl.h language.h
	$(CC) $(CFLAGS) -c webjacl.c -o webjacl.o

# External libraries targets
libglkterm.a:
	cd $(GLKTERM_DIR) && $(MAKE) libglkterm.a

libcgihtml.a:
	cd $(CGIHTML_DIR) && $(MAKE) libcgihtml.a

# Install binaries and libraries
install: all
	@mkdir -p ../bin
	@INSTALL_CMDS@
	@mkdir -p /usr/local/jacl/projects/include
	@mkdir -p /usr/local/jacl/projects/temp
	@mkdir -p /usr/local/jacl/logs
	cp ../projects/include/*.library /usr/local/jacl/projects/include/
	cp ../projects/include/*.css /usr/local/jacl/projects/include/
	@mkdir -p /usr/local/jacl/projects/data
	cp ../projects/data/*.csv /usr/local/jacl/projects/data/
	cp ../etc/cgijacl.conf /usr/local/jacl/
	cp ../etc/cgijacl.conf /etc/cgijacl.conf 2>/dev/null || true

# Apache2 + mod_fcgid setup (Ubuntu/Debian)
apache: install
	@echo "=== JACL Apache2 + mod_fcgid Setup ==="
	@which apache2ctl > /dev/null 2>&1 || { echo "ERROR: apache2ctl not found. Install Apache2 first: sudo apt install apache2"; exit 1; }
	@if ! apache2ctl -M 2>/dev/null | grep -q fcgid_module; then \
		echo "Installing and enabling mod_fcgid..."; \
		apt-get install -y libapache2-mod-fcgid || { echo "ERROR: Could not install libapache2-mod-fcgid. Run: sudo apt install libapache2-mod-fcgid"; exit 1; }; \
		a2enmod fcgid; \
	else \
		echo "mod_fcgid already enabled."; \
	fi
	@mkdir -p /usr/local/jacl/fcgi-bin
	@echo "Creating wrapper scripts..."
	@cp ../projects/*.jacl /usr/local/jacl/projects/ 2>/dev/null || true
	@cp ../projects/*.blorb /usr/local/jacl/projects/ 2>/dev/null || true
	@cp ../projects/*.media /usr/local/jacl/projects/ 2>/dev/null || true
	@if [ -d ../projects/www ]; then cp -r ../projects/www /usr/local/jacl/projects/; fi
	@if [ -d ../projects/images ]; then cp -r ../projects/images /usr/local/jacl/projects/; fi
	@for game in /usr/local/jacl/projects/*.jacl; do \
		name=$$(basename "$$game" .jacl); \
		wrapper="/usr/local/jacl/fcgi-bin/$$name.fcgi"; \
		printf '#!/bin/sh\nexec /usr/local/bin/fcgijacl %s\n' "$$game" > "$$wrapper"; \
		chmod 755 "$$wrapper"; \
		echo "  $$name.fcgi"; \
	done
	@echo "Building landing-page index.html..."
	@mkdir -p /var/www/html
	@{ \
	  printf '%s\n' '<!DOCTYPE html>'; \
	  printf '%s\n' '<html lang="en">'; \
	  printf '%s\n' '<head>'; \
	  printf '%s\n' '  <meta charset="UTF-8">'; \
	  printf '%s\n' '  <meta name="viewport" content="width=device-width, initial-scale=1">'; \
	  printf '%s\n' '  <title>JACL Interactive Fiction</title>'; \
	  printf '%s\n' '  <style>'; \
	  printf '%s\n' '    body { font-family: Georgia, Palatino, Times, serif; max-width: 640px; margin: 2em auto; padding: 0 1em; color: #333; line-height: 1.5; }'; \
	  printf '%s\n' '    h1 { border-bottom: 1px solid #ccc; padding-bottom: 0.3em; }'; \
	  printf '%s\n' '    ul.games { list-style: none; padding: 0; }'; \
	  printf '%s\n' '    ul.games li { margin: 0.4em 0; padding: 0.3em 0; }'; \
	  printf '%s\n' '    ul.games a { text-decoration: none; color: #42596d; font-weight: bold; }'; \
	  printf '%s\n' '    ul.games a:hover { text-decoration: underline; }'; \
	  printf '%s\n' '    footer { margin-top: 3em; color: #888; font-size: 0.85em; border-top: 1px solid #eee; padding-top: 1em; }'; \
	  printf '%s\n' '  </style>'; \
	  printf '%s\n' '</head>'; \
	  printf '%s\n' '<body>'; \
	  printf '%s\n' '  <h1>JACL Interactive Fiction</h1>'; \
	  printf '%s\n' '  <p><strong>Interactive fiction</strong> is a genre of text-based computer games where'; \
	  printf '%s\n' '     you read a description of a scene and type simple commands (for example'; \
	  printf '%s\n' '     <em>go north</em>, <em>take lamp</em>, or <em>examine desk</em>) to move'; \
	  printf '%s\n' '     through a story and solve its puzzles. It is a direct descendant of the'; \
	  printf '%s\n' '     text adventures of the 1970s and 80s &mdash; titles like <em>Zork</em>,'; \
	  printf '%s\n' '     <em>Adventure</em>, and <em>The Hitchhiker&rsquo;s Guide to the Galaxy</em>'; \
	  printf '%s\n' '     &mdash; and has a thriving modern community of authors and players.</p>'; \
	  printf '%s\n' '  <p>Choose a game below to start playing:</p>'; \
	  printf '%s\n' '  <ul class="games">'; \
	  for game in /usr/local/jacl/projects/*.jacl; do \
	    [ -e "$$game" ] || continue; \
	    name=$$(basename "$$game" .jacl); \
	    title=$$(grep '^constant game_title' "$$game" 2>/dev/null | head -1 | sed -E 's/.*"([^"]+)".*/\1/'); \
	    if [ -z "$$title" ] || [ "$$title" = "$$(grep '^constant game_title' "$$game" | head -1)" ]; then \
	      continue; \
	    fi; \
	    printf '    <li><a href="/jacl/%s.fcgi">%s</a></li>\n' "$$name" "$$title"; \
	  done; \
	  printf '%s\n' '  </ul>'; \
	  printf '%s\n' '  <footer>Served by JACL. Each link runs a game via the fcgijacl interpreter.</footer>'; \
	  printf '%s\n' '</body></html>'; \
	} > /var/www/html/index.html
	@echo "Installing Apache configuration..."
	cp ../etc/jacl-apache.conf /etc/apache2/conf-available/jacl.conf
	a2enconf jacl
	@echo "Setting permissions..."
	chown -R www-data:www-data /usr/local/jacl/projects/temp
	chown -R www-data:www-data /usr/local/jacl/logs
	chmod 755 /usr/local/jacl/projects
	chmod 775 /usr/local/jacl/projects/temp
	chmod 775 /usr/local/jacl/projects/data
	chmod 775 /usr/local/jacl/logs
	@echo "Restarting Apache..."
	apache2ctl graceful
	@echo ""
	@echo "=== JACL Apache Setup Complete ==="
	@echo ""
	@echo "Configuration: /etc/apache2/conf-available/jacl.conf"
	@echo "Wrapper scripts: /usr/local/jacl/fcgi-bin/"
	@echo "Game files: /usr/local/jacl/projects/"
	@echo "Logs: /usr/local/jacl/logs/"
	@echo ""
	@echo "Landing page: http://localhost/"
	@echo "Games are available at: http://localhost/jacl/<gamename>.fcgi"
	@echo ""

# Clean up
clean:
	rm -f *.o
	rm -f cgijacl fcgijacl bjorb jacl
	cd $(CGIHTML_DIR) && $(MAKE) clean
	cd $(GLKTERM_DIR) && $(MAKE) clean

distclean: clean
	rm -f Makefile config.log config.status
	rm -f $(GLKTERM_DIR)/Makefile
