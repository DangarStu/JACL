# Generated by configure from Makefile.in

CC = gcc -std=gnu23
CFLAGS = -Wall -O2

# Directories
CGIHTML_DIR = cgihtml-1.69
GLKTERM_DIR = glkterm
GLKTERMW_DIR = glktermw
CHEAPGLK_DIR = CheapGlk

# Detected library flags
NCURSES_CFLAGS = -I/opt/homebrew/include
NCURSES_LIBS = -L/opt/homebrew/lib -lncurses
FCGI_CFLAGS = -I/opt/homebrew/include
FCGI_LIBS = -L/opt/homebrew/lib -lfcgi

# Source files
COMMON_SRC = findroute.c interpreter.c loader.c logging.c parser.c display.c utils.c jpp.c resolvers.c errors.c encapsulate.c libcsv.c

# Targets determined by configure
BUILD_TARGETS = bjorb cjacl cgijacl jacl fcgijacl

all: $(BUILD_TARGETS)

# Bjorb target
bjorb: bjorb.c
	$(CC) $(CFLAGS) -o bjorb bjorb.c

# Jacl target (GlkTerm console, requires ncurses)
jacl: libglkterm.a
	$(CC) $(CFLAGS) -DGLK jacl.c glk_startup.c $(COMMON_SRC) glk_saver.c -I$(GLKTERM_DIR) -L$(GLKTERM_DIR) -lglkterm -lm $(NCURSES_LIBS) -o jacl

# Cjacl target (CheapGlk console, no ncurses needed)
cjacl: libcheapglk.a
	$(CC) $(CFLAGS) -DGLK jacl.c glk_startup.c $(COMMON_SRC) glk_saver.c -I$(CHEAPGLK_DIR) -L$(CHEAPGLK_DIR) -lcheapglk -lm -o cjacl

# Cgijacl target (CGI web)
cgijacl: libcgihtml.a webjacl.o
	$(CC) $(CFLAGS) -DWEBJACL cgijacl.c $(COMMON_SRC) saver.c webjacl.o -I$(CGIHTML_DIR) -Iwebjacl -L$(CGIHTML_DIR) -lcgihtml -lm -o cgijacl

# Fcgijacl target (FastCGI web, requires libfcgi)
fcgijacl: libcgihtml.a
	$(CC) $(CFLAGS) -DFCGIJACL cgijacl.c $(COMMON_SRC) saver.c -I$(CGIHTML_DIR) -L$(CGIHTML_DIR) -lcgihtml $(FCGI_CFLAGS) $(FCGI_LIBS) -lm -o fcgijacl

# webjacl.o target
webjacl.o: webjacl.c webjacl.h language.h
	$(CC) $(CFLAGS) -c webjacl.c -o webjacl.o

# External libraries targets
libcheapglk.a:
	cd $(CHEAPGLK_DIR) && $(MAKE) libcheapglk.a

libglktermw.a:
	cd $(GLKTERMW_DIR) && $(MAKE) libglktermw.a

libglkterm.a:
	cd $(GLKTERM_DIR) && $(MAKE) libglkterm.a

libcgihtml.a:
	cd $(CGIHTML_DIR) && $(MAKE) libcgihtml.a

# Install binaries and libraries
install: all
	@mkdir -p ../bin
	mv bjorb ../bin; mv cjacl ../bin; mv cgijacl ../bin; mv jacl ../bin; mv fcgijacl ../bin
	@mkdir -p /usr/local/jacl/projects/include
	@mkdir -p /usr/local/jacl/projects/temp
	@mkdir -p /usr/local/jacl/logs
	cp ../projects/include/*.library /usr/local/jacl/projects/include/
	cp ../etc/cgijacl.conf /usr/local/jacl/

# Clean up
clean:
	rm -f *.o
	rm -f cgijacl fcgijacl bjorb jacl cjacl
	cd $(CGIHTML_DIR) && $(MAKE) clean
	cd $(GLKTERM_DIR) && $(MAKE) clean
	cd $(GLKTERMW_DIR) && $(MAKE) clean
	cd $(CHEAPGLK_DIR) && $(MAKE) clean

distclean: clean
	rm -f Makefile config.log config.status
	rm -f $(GLKTERM_DIR)/Makefile
	rm -f $(CHEAPGLK_DIR)/Makefile
