# JACL iOS — TestFlight automation (run by .github/workflows/ios-release.yml).
# The Xcode project is generated by xcodegen (./generate.sh) before this runs.
# Signing: a distribution cert is imported into the keychain by the workflow, and
# the App Store Connect API key authenticates xcodebuild's -allowProvisioningUpdates
# (via -authenticationKey* flags) so it can create/refresh the App Store profile —
# no cert/profile juggling, no fastlane match repo.
# NOTE: gym/build_app has no api_key option; the build's auth must go through
# xcodebuild flags. (Wryter's Fastfile needs the same fix.)

require "base64"
require "tmpdir"

default_platform(:ios)

platform :ios do
  desc "Build a Release archive and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
    )

    # Write the .p8 so xcodebuild's -allowProvisioningUpdates can authenticate to
    # App Store Connect and create/refresh the distribution profile in CI.
    key_path = File.join(Dir.tmpdir, "asc_api_key.p8")
    File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64")))

    build_app(
      project: "JACL.xcodeproj",
      scheme: "JACL",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build-ipa",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
              "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')} " \
              "-authenticationKeyPath #{key_path} " \
              "CODE_SIGN_STYLE=Automatic DEVELOPMENT_TEAM=5TU3TU28JN",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
