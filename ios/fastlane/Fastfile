# JACL iOS — TestFlight automation (run by .github/workflows/ios-release.yml).
# The Xcode project is generated by xcodegen (./generate.sh) before this runs.
# Signing: a distribution cert is imported into the keychain by the workflow, and
# the App Store Connect API key lets xcodebuild create/refresh the provisioning
# profile (-allowProvisioningUpdates) and upload to TestFlight — no cert/profile
# juggling, no fastlane match repo. (Identical to Wryter's ios/fastlane/Fastfile,
# only the project/scheme differ.)

default_platform(:ios)

platform :ios do
  desc "Build a Release archive and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
    )

    build_app(
      project: "JACL.xcodeproj",
      scheme: "JACL",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build-ipa",
      xcargs: "-allowProvisioningUpdates CODE_SIGN_STYLE=Automatic DEVELOPMENT_TEAM=5TU3TU28JN",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end
end
