{
  "name": "jacl-desktop",
  "version": "0.2.2",
  "description": "JACL desktop (Electron): the full web JACL hosted locally via cgijacl, with the map in its own window.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-engine": "./build-cgijacl.sh",
    "build-engine-win": "./build-cgijacl-win.sh",
    "prepare-bundle": "./prepare-bundle.sh",
    "dist": "npm run build-engine && npm run prepare-bundle && electron-builder",
    "dist:mac": "npm run build-engine && npm run prepare-bundle && electron-builder --mac",
    "dist:linux": "npm run build-engine && npm run prepare-bundle && electron-builder --linux",
    "dist:win": "npm run build-engine-win && npm run prepare-bundle && electron-builder --win"
  },
  "license": "MIT",
  "author": "Stuart Allen <dangarstu@gmail.com>",
  "homepage": "https://jacl.dangarmarine.com.au",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "au.com.dangarmarine.jacl",
    "productName": "JACL",
    "directories": { "output": "dist" },
    "dmg": { "sign": true },
    "files": ["main.js", "preload.js", "picker.html", "shelf-artwork.png"],
    "extraResources": [
      { "from": "bin", "to": "bin" },
      { "from": "staging/jacl-data", "to": "jacl-data" }
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ],
      "category": "public.app-category.games",
      "identity": "Stuart Allen (5TU3TU28JN)",
      "x64ArchFiles": "**/cgijacl",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": { "teamId": "5TU3TU28JN" }
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Game"
    },
    "win": {
      "target": ["nsis"]
    }
  }
}
