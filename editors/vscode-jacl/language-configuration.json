{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"" },
    { "open": "~", "close": "~" }
  ],
  "surroundingPairs": [
    { "open": "\"", "close": "\"" },
    { "open": "~", "close": "~" }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*\\{",
      "end": "^\\s*\\}"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(if|ifall|ifstring|ifstringall|else|while|whileall|repeat|loop|iterate|update|select|print:)\\b",
    "decreaseIndentPattern": "^\\s*(endif|endall|endwhile|enditerate|endupdate|endselect|endloop|else|\\.|\\})\\b?"
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}
