write "Anda mengarahkan " noun1{the} " ke " noun2{the} ".^"
}

grammar throw *held in *here	>throw_at
grammar hurl *held in *here		>throw_at
grammar pitch *held in *here	>throw_at
grammar cast *held in *here		>throw_at
grammar throw *held on *here	>throw_at
grammar hurl *held on *here		>throw_at
grammar pitch *held on *here	>throw_at
grammar cast *held on *here		>throw_at
grammar throw *held at *here	>throw_at
grammar throw *held to *here	>throw_at
grammar cast *held to *here		>throw_at
grammar cast *held at *here		>throw_at
grammar pitch *held to *here	>throw_at
grammar pitch *held at *here	>throw_at
grammar lob *held to *here		>throw_at
grammar lob *held at *here		>throw_at
grammar hurl *held to *here		>throw_at
grammar hurl *held at *here		>throw_at
grammar lempar *held ke *here >throw_at

{+throw_at
if +important<noun2 = true
   return true
endif
if +not_held<noun1 = true
   return
endif
if +darkness = true
   return true
endif
if noun2 has LOCATION
   write noun1{The} " jatuh di dekat sini.^"
   move noun1 to here
   return
endif
if noun2 is *held
   write "Sulit untuk melempar apa pun ke " noun2{the} " sementara Anda "
   write "memegang " noun2{obj} ".^"
   set time = false
   return
endif
if noun2(parent) hasnt LOCATION
   write "Anda tidak bisa melempar " noun1{the} " ke " noun2{the} " selagi "
   write noun2{the} " di dalam sesuatu yang lain.^"
   set time = false
   return true
endif
if +move_scenery<noun1 = true
   return true
endif
if +worn<noun1 = true
   return true
endif
override
if noun2 has ANIMATE
   write "Saya rasa " noun2{the} " tidak akan menghargai Anda melempar "
   write noun1{the} " ke arahnya.^"
   set time = false
   return true
endif
if noun1(mass) => 20
   write noun1{The} " terlalu berat untuk dilempar-lempar.^"
   set time = false
   return true
endif
if here has UNDER_WATER
   write "Melempar benda di bawah air tidak pernah semudah yang Anda "
   write "kira.^"
   set time = false
   return true
endif
if here has ON_WATER
   write "Anda melempar " noun1{the} " ke " noun2{the} " yang "
   write "memantul, jatuh ke air di mana "
   write noun1{the} " dengan cepat tenggelam" noun1{s} ", menghilang dari pandangan.^"
   move noun1 to limbo
   return true
endif
write  noun1{The} " memantul" noun1{s} " dari " noun2{the} " dan jatuh" noun1{s}
write " ke tanah.^"
move noun1 to here
}

grammar remove **held       >remove
