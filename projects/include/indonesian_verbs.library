   write "Anda sudah duduk.^"
   return true
endif
if here has UNDER_WATER
   write "Selagi di bawah air?^"
   return true
endif
if here has ON_WATER
   write "Selagi di air?^"
   return true
endif
write "Anda duduk untuk istirahat sejenak.^"
ensure player has SITTING
}

grammar sit *here	  >sit_on
grammar sit on *here  >sit_on
