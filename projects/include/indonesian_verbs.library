   return true
endif
if noun2(quantity) < noun1(mass)
   write "Tidak cukup ruang di dalam " noun2{the} " untuk " noun1{the} .^
   set time = false
   return true
endif
if +worn<noun1 = true
   return true
endif
override
write "Anda meletakkan " noun1{the} " di dalam " noun2{the} .^
move noun1 to noun2
}

{+encumbered
