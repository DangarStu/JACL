integer NEARBY

grammar follow *anywhere	>follow
grammar ikuti *anywhere >follow

{+follow
if noun1 is *present
   write noun1{The} " ada di sini!^"
   set time = false
   return
endif

set INDEX = -1

# LOOP THROUGH ALL THE EXITS OF THE CURRENT LOCATION
set COUNTER = 0
repeat
   if here(COUNTER) = noun1(parent)
      set INDEX = COUNTER
   endif
   set COUNTER + 1
until COUNTER = 12

if INDEX != -1
   execute "+go_direction<INDEX"
else
   write "Anda tidak yakin ke mana harus pergi.^"
   set time = false
endif
}

grammar go back		>go_back
grammar back		>go_back
grammar return		>go_back
