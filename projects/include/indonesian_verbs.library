{+pour_on
if +important<noun1 = true
   return true
endif
if +important<noun2 = true
   return true
endif
if +darkness = true
   return true
endif
if noun1 hasnt LIQUID
   write "Anda tidak bisa menuangkan " noun1{the} .^
   set time = false
   return true
endif
if +reach<noun1 = true
   return true
endif
set noun3 = noun1(parent)
if noun3 = false : noun3(parent) <> player
   write "Anda tidak punya " noun1{the} .^
   set time = false
   return true
endif
if +closed<noun3 = true
   return true
endif
if +closed<noun2 = true
   return true
endif
if +reach<noun2 = true
   return true
endif
override
if +contains_liquid?<noun2 = true
   write noun2{The} " sudah berisi" noun2{s} " " CHILD{the} ". Jika Anda "
   write "juga menambahkan " noun1{the} " keduanya akan tercampur.^"
   set time = false
   return true
endif
ifall noun2 has CONTAINER : noun2 hasnt CLOSED
   override
   write "Anda menuangkan " noun1{the} " ke dalam " noun2{the} .^
   move noun1 to noun2
   return true
endif
ifall noun2(parent) hasnt LOCATION : noun2(parent) has CONTAINER
   set noun3 = noun2(parent)
   write noun1{The} " mengalir" noun1{s} " dari " noun2{the} " dan masuk ke "
   write noun3{the} ".^"
   move noun1 to noun3
   return true
endif
write noun1{The} " mengalir dari " noun2{the} " dan membasahi seluruh "
write "tanah.^"
move noun1 to limbo
}

grammar blankjacl >blankjacl

{+blankjacl
