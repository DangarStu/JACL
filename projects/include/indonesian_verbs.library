# Indonesian equivalents of built-in commands are handled by the
# constants in indonesian.library (RESTART_WORD, QUIT_WORD, etc.)
# and by grammar statements in this file (simpan, pulihkan, etc.).

integer_array available_exits 12 0
string dir_command utara selatan timur barat timurlaut baratlaut
string dir_command tenggara baratdaya atas bawah masuk keluar

grammar about >about

{+about
style note
write game_title
style normal
write ", Copyright (c) " game_author "^"
write "Release " game_release " / build " game_build 
write " / JACL verb.library version " library_version "^^"
}

constant NO_GO 22000

grammar exits >exits
grammar jalan_keluar >exits

{+exits
execute "+calculate_exits"
write "Anda bisa pergi ke "
if INDEX = 0
   write "mana pun!^"
   set time = false
   return true
endif
set COUNTER = 0
repeat
   if available_exits[COUNTER] != nowhere
      hyperlink dir_command[COUNTER] dir_command[COUNTER]
      if available_exits[COUNTER] has KNOWN
         write " ke " available_exits[COUNTER]{the}
      endif
      set INDEX - 1
      execute "+or_structure"
   endif
   set COUNTER + 1
until COUNTER = 12
write ".^"
set time = false
}

{+calculate_exits
execute "+clear_list"
# LOOP THROUGH ALL THE EXITS OF THE CURRENT LOCATION
set COUNTER = 0
set INDEX = 0
repeat
   ifall here(COUNTER) != nowhere : here(COUNTER) != NO_GO : +in_list<here(COUNTER) = false
      set available_exits[COUNTER] = here(COUNTER)
      set INDEX + 1 # THIS IS COUNTING THE NUMBER OF EXITS FOR PUNCTUATION
   else
      set available_exits[COUNTER] = 0
   endif
   set COUNTER + 1
until COUNTER = 12
}

{+in_list
set TEMP = 0
repeat
   if available_exits[TEMP] = arg[0]
      return true
   endif
   set TEMP + 1
until TEMP = 12
return false
}

{+clear_list
set TEMP = 0
repeat
   set available_exits[TEMP] = 0
   set TEMP + 1
until TEMP = 12
}

{+darkness
if here has DARKNESS
   execute "+no_light"
   return true
endif
return false
}

{+can_talk
if here has UNDER_WATER
   write "Berbicara di bawah air tidaklah mudah.^"
   set time = false
   return true
endif
if arg[0] = player
   write "Itu tanda pertama kegilaan, Anda tahu...^"
   set time = false
   return true
endif
if arg[0] hasnt ANIMATE
   write "Saya rasa berbicara dengan " arg[0]{the} " tidak akan membantu.^"
   set time = false
   return true
endif
if arg[0] has DEAD
   write  arg[0]{The} " " arg[0]{is} " terlalu mati untuk merespons.^"
   set time = false
   return true
endif
return false
}

{+important
if arg[0] has NOT_IMPORTANT
   write  arg[0]{The} " " arg[0]{is} " tidak penting; Anda tidak perlu mengkhawatirkan " arg[0]{obj} ".^"
   set time = false
   return true
endif
return false
}

{+reach
if arg[0] has OUT_OF_REACH
   write  arg[0]{The} " " arg[0]{is} " tidak terjangkau.^"
   set time = false
   return true
endif
return false
}

{+possessed
set INDEX grandof noun1
ifall INDEX has ANIMATE : INDEX != player : noun1 != INDEX
   write INDEX{The} " menolak" INDEX{s} " memberikan " noun1{the} .^
   set time = false
   return true
else
   return false
endif
}

# Open an object if possible in order to perform typed command.
{+closed
if arg[0] hasnt CLOSED
   return false
endif
proxy "open " arg[0]{names}
if arg[0] has CLOSED
   set time = false
   return true
endif
return false
}

# Stop wearing an object if possible in order to perform typed command.
{+worn
if arg[0] hasnt WORN
   return false
endif
proxy "remove " arg[0]{names}
if arg[0] has WORN
   set time = false
   return true
endif
return false
}

# Take an object if possible in order to perform typed command.
{+not_held
if arg[0] is *held
   return false
endif
proxy "take " arg[0]{names}
if arg[0] isnt *held
   set time = false
   return true
endif
return false
}

location limbo : limbo

grammar shake >shake_only

{+shake_only
write "Takut?^"
set time = false
}

grammar shake *held   >shake
grammar wave *held    >shake

{+shake
if +not_held<noun1 = true
   return
endif
write "Sudah dilakukan.^"
}

grammar say xyzzy >xyzzy
grammar xyzzy     >xyzzy

{+xyzzy
set time = false
if @+xyzzy != 1
   write "~Pergi. Tinggalkan kami sendiri.~^"
   return true
endif
write "~Itu kata sandinya, buka pintunya.~^^"
write "~Kamu yakin? Aku tidak mengenali suaranya.~^^"
write "~Jangan berdebat, buka saja pintunya!~^^"
write "Sebuah pintu yang sebelumnya tak terlihat terbuka. Di balik pintu Anda "
write "melihat apa yang hanya bisa Anda bayangkan sebagai bengkel Tuhan.^^"
write "write ~Sial! Sudah kubilang itu bukan dia!" caret "~;^"
write "set bouncer_1(panic) + 5;^"
write "write ~Cepat! Tutup pintunya." caret "~;^"
write "set poo(parent) = bouncer_2s_trousers;^"
write "ensure magic_door has CLOSED;^"
write "^Pintu itu tertutup dan menghilang lagi. Sesuatu memberitahu Anda bahwa "
write "ini akan menjadi salah satu hari yang berat...^"
}

grammar save $string >named_save
grammar simpan $string >named_save

{+named_save
savegame INDEX $string
if INDEX = true
   write "Permainan disimpan.^"
endif
set time = false
}

grammar restore $string >named_restore
grammar pulihkan $string >named_restore

{+named_restore
restoregame INDEX $string
if INDEX = true
   write "Permainan tersimpan dipulihkan.^^"
   ensure here hasnt VISITED
   execute "+display_location"
endif
set time = false
}

string filename

{+load_saved
repeat
   write "Apakah Anda ingin memulihkan permainan tersimpan?^"
   getyesorno TEMP
   if TEMP = true
       restoregame INDEX
       if INDEX = true
          write "Permainan tersimpan dipulihkan.^^"
   		  ensure here hasnt VISITED
          execute "+display_location"
          return true
       endif
   endif
until TEMP = false
return false
}

grammar save >save_game
grammar simpan >save_game

{+save_game
savegame INDEX
if INDEX = true
   write "Permainan disimpan.^"
endif
set time = false
}

grammar restore >restore_game
grammar pulihkan >restore_game

{+restore_game
restoregame INDEX
if INDEX = true
   write "Permainan tersimpan dipulihkan.^^"
   ensure here hasnt VISITED
   execute "+display_location"
endif
set time = false
}

