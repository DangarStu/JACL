grammar take **here		>take
grammar take out **here	>take
grammar hold **here		>take
grammar pick up **here	>take
grammar pick **here up	>take
grammar get **here		>take
grammar ambil **here >take

{+take
if +important<noun1 = true
   return true
endif
if +darkness = true
   return true
endif
if +reach<noun1 = true
   return true
endif
if +possessed<noun1 = true
   return
endif
if noun1 is *held
   write "Anda sudah memegang " noun1{the} ".^"
   set time = false
   return
endif
if player has SITTING
   write "Anda harus berdiri terlebih dahulu.^"
   set time = false
   return true
endif
if noun1 has ANIMATE
   write "Saya rasa " noun1{sub} " tidak akan menghargai itu.^"
   set time = false
   return true
endif
if +move_scenery<noun1 = true
   return true
endif
if noun1(mass) > player(quantity)
   write "Anda membawa terlalu banyak untuk mengambil " noun1{the} .^
   set time = false
   return true
endif
if noun1 has LIQUID
   write  noun1{The} " mengalir" noun1{s} " melalui jari-jari Anda.^"
   return true
endif
override
write "Anda mengambil " noun1{the} .^
move noun1 to player
ensure noun1 has TOUCHED
}

{+move_scenery
if arg[0] has LOCATION
   write "Itu akan menjadi prestasi kekuatan yang mengesankan.^"
   set time = false
   return true
endif
if arg[0](mass) => heavy
   set noun3 = noun1(parent)
   set INDEX = noun3
   if noun3 has LOCATION
      write "Anda tidak bisa mengambil " noun1{the} ".^"
      return true
   else
      write noun1{The} " " noun1{is} " terpasang pada " noun3{the} .^
   endif
   set time = false
   return true
endif
return false
}

grammar insert **held on *present	>insert_on
grammar put **held on *present		>insert_on
grammar place **held on *present	>insert_on
grammar taruh **held di *present >insert_on
grammar letakkan **held di *present >insert_on

{+insert_on
if +important<noun2 = true
   return true
endif
if +not_held<noun1 = true
   return
endif
if +darkness = true
   return true
endif
if +reach<noun2 = true
   return true
endif
if noun2 = noun1
   write "Meletakkan " noun1{the} " di atas "
   if noun1 has PLURAL
      write "diri mereka sendiri?"
   else
      write "dirinya sendiri?"
   endif
   write " Saya rasa tidak.^"
   set time = false
   return true
endif
if noun2(parent) = noun1
   write "Sayangnya itu tidak mungkin.^"
   set time = false
   return true
endif
if +move_scenery<noun1 = true
   return true
endif
if noun2 hasnt SURFACE
   write "Tidak ada permukaan datar pada " noun2{the} .^
   set time = false
   return true
endif
if noun2(quantity) < noun1(mass)
   write "Tidak cukup ruang di atas " noun2{the} " untuk " noun1{the} .^
   set time = false
   return true
endif
if +worn<noun1 = true
   return true
endif
override
write "Anda meletakkan " noun1{the} " di atas " noun2{the} .^
move noun1 to noun2
}

