}

grammar kick *present           >kick
grammar tendang *present >kick

{+kick
if +worn<noun1 = true
   return true
endif
override
if noun1 has ANIMATE
   proxy "attack " noun1{names}
   return
endif
if noun1(mass) = scenery
   if noun1 grandof player
      write "Gerakan akrobatik itu di luar kemampuan Anda.^"
      set time = false
      return
   else
      proxy "attack " noun1{names}
      return
   endif
endif
write "Anda menendang " noun1{the} " sejauh jarak pendek.^"
move noun1 to here
}

