set time = false
}

grammar loosen *present	>open
grammar open *present	>open
grammar buka *present >open

{+open
if +important<noun1 = true
   return true
endif
if +darkness = true
   return true
endif
if +reach<noun1 = true
   return true
endif
if noun1 has LOCKED
   write  noun1{The} " " noun1{is} " terkunci.^"
   set time = false
   return true
endif
if noun1 hasnt CLOSABLE
   write "Anda tidak bisa membuka " noun1{the} .^
   set time = false
   return true
endif
if noun1 hasnt CLOSED
   write  noun1{The} " " noun1{is} " sudah terbuka.^"
   set time = false
   return true
endif
override
ensure noun1 hasnt CLOSED
if noun1 has CONTAINER
   execute "+revealing"
   return true
endif
write "Anda membuka " noun1{the} .^
}

{+revealing
set INDEX = 0
select noun1
   set INDEX + 1
endselect
write "Anda membuka " noun1{the}
if INDEX = 0
   write ", yang " noun1{is} " kosong.^"
   return true
endif
write " memperlihatkan "
select noun1
   set INDEX - 1
   write noun3{list}
   execute "+object_info<noun3"
   execute "+list_structure"
   if INDEX = 0
      write "^"
      return true
   endif
endselect
}

