endif
set time = false
}

grammar sound off >sound_off

{+sound_off
if sound_enabled = false
write "Suara sudah dinonaktifkan.^"
else
set sound_enabled = false
write "Suara dinonaktifkan.^"
stop 0
stop 1
stop 2
stop 3
endif
set time = false
}

