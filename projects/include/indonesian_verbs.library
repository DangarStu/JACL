{+ask_for
if +can_talk<noun1 = true
   return true
endif
if noun1 !grandof noun2
   write  noun1{The} " " noun1{doesnt} " tampaknya memiliki " noun2{the} .^
   set time = false
   return true
endif
if +possessed<noun1 = true
   return
endif
if noun2(mass) > player(quantity)
   write "Dengan beban Anda saat ini, Anda tidak bisa menerima "
   write noun2{the} .^
   set time = false
   return true
endif
override
move noun2 to player
if noun2 has WORN
   write  noun1{The} " melepas" noun1{s} " " noun2{the} " lalu memberikan" noun1{s}
   write " kepada Anda.^"
   ensure noun2 hasnt WORN
   return true
endif
write  noun1{The} " memberikan " noun2{the} " kepada Anda.^"
}

