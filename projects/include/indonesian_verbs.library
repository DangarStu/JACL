grammar extract **here with *held	>take_with
grammar get **here with *held		>take_with
grammar take **here with *held		>take_with
grammar take out **here with *held	>take_with
grammar hold **here with *held		>take_with
grammar empty **present with *held	>take_with

{+take_with
if +not_held<noun2 = true
   return
endif
proxy "fill " noun2{names} " with " noun1{names}
}

grammar fill *held from *present      >fill_from
grammar isi *held dari *present >fill_from

{+fill_from
if +not_held<noun1 = true
   return
endif
if +important<noun2 = true
   return true
endif
if +darkness = true
   return true
endif
if +contains_liquid?<noun2 == false
   write  noun2{The} " " noun2{doesnt} "mengandung cairan untuk mengisi " noun1{the}
   write ".^"
   set time = false
   return true
endif
proxy "fill " noun1{names} " with " CHILD{names}
}

grammar fill *held with *present >fill_with
grammar isi *held dengan *present >fill_with

{+fill_with
if +not_held<noun1 = true
   return
endif
if +important<noun2 = true
   return true
endif
if +darkness = true
   return true
endif
if +reach<noun2 = true
   return true
endif
if noun2 hasnt LIQUID 
   if +contains_liquid?<noun2 = true
      set noun2 = CHILD
   else
      write "Anda hanya bisa mengisi " noun1{the} " dengan cairan.^"
      return true
   endif
endif
if noun1 hasnt CONTAINER
   write  noun1{The} " " noun1{isnt} " wadah dan oleh karena itu tidak bisa "
   write "diisi.^"
   return true
endif
if noun1 has CLOSED
   write "Anda tidak bisa mengisi " noun1{the} " selagi " noun1{the} " tertutup.^"
   set time = false
   return true
endif
if +contains_liquid?<noun1 = true
   write  noun1{The} " sudah berisi " CHILD{the} ". Jika Anda juga "
   write "menambahkan " noun2{the} " keduanya akan tercampur.^"
   set time = false
   return true
endif
if noun1(quantity) < noun2(mass)
   write  noun1{The} " " noun1{isnt} " cukup besar untuk menampung "
   write noun2{the} .^
   set time = false
   return true
endif
override
write "Anda mengisi " noun1{the} " dengan " noun2{the} .^
move noun2 to noun1
}

{+contains_liquid?
# CHECK IF THE SPECIFIED OBJECT CONTAINS ANY LIQUIDS
select LIQUID CHILD
   if CHILD(parent) = arg[0]
      return true
   endif
endselect
return false
}

grammar fill *held >fill
grammar isi *held >fill

{+fill
if +important<noun1 = true
   return true
endif
if +not_held<noun1 = true
   return
endif
if +darkness = true
   return true
endif
override
write "Dengan apa Anda ingin mengisi " noun1{the} "?^"
setstring question "fill " noun1{names} " with "
set time = false
}

