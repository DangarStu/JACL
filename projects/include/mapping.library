# MAPPING LIBRARY
#
# Provides a `map` command that renders an SVG map of the player's explored
# territory using the Raphael JavaScript library. Two display modes:
#
#   map              -- renders the map inline in the main text area (one-shot)
#   map window       -- opens the map in a separate browser window and keeps
#                       it updated every time the player looks or moves
#   map close        -- closes the map window and disables auto-update
#
# USAGE
# -----
# 1. In your game file:
#        #include "mapping.library"
#
# 2. Add raphael to the page head by overriding +local_header in your game:
#        {+local_header
#        print:
#           <script src="/include/raphael.min.js"></script>
#        .
#        }
#
#    Under cgijacl the web interpreter only serves files listed in the
#    game's .media file, so also add this line to your <game>.media
#    (see mapping.media for the canonical entry):
#        /include/raphael.min.js application/javascript www/raphael.min.js
#
# 3. Give every mappable location integer `x` and `y` properties. These are
#    grid coordinates; by convention the `north` exit should lead to a
#    location with a smaller `y`, `east` to a larger `x`, etc. Example:
#
#        location kitchen : kitchen
#           x       3
#           y       2
#           north   hallway
#           east    pantry
#           ...
#
# BEHAVIOUR
# ---------
# Only locations with the VISITED attribute are drawn as labelled nodes.
# Exit lines are drawn for every exit from a visited location, including
# exits whose destination has not yet been visited -- so the map shows
# where the player can go, but not what is there until they arrive. The
# current location (`here`) is highlighted. Before rendering, the library
# measures the bounding box of the content and sizes the canvas tightly
# around it (so early-game maps aren't lost in a huge empty 1500x1500
# canvas).
#
# HOOK NOTE
# ---------
# Window-mode auto-update is implemented by defining a global +after_look
# hook. If your game already defines +after_look for something else,
# you'll need to merge that logic with this library's emission block.

# Layout constants used below (inlined because JACL constants aren't
# accepted inside arithmetic or write argument lists):
#   grid size        = 150 pixels per unit of (x, y)
#   node size        = 60x60 pixels. Adjacent room centres are 150 px
#                      apart, so node edges are 90 px apart.
#   stub lengths     = 120 px orthogonal, 170 px diagonal. Tuned so each
#                      stub endpoint lands at the far node's edge -- the
#                      box "just overlaps" the line. Two visited adjacent
#                      rooms each draw a stub and the stubs overlap
#                      heavily in the middle, reading as one connecting
#                      line. Unvisited exits show only the source's
#                      whisker, ending where the neighbour's box would
#                      sit if visited.
#   padding          = 1 grid cell on each side of content
#   label overhang   = 40 extra pixels of canvas on the right/bottom
#                      so long labels that extend past their node
#                      aren't clipped

integer map_here
integer map_target
integer map_x
integer map_y
integer map_dest_x
integer map_dest_y
integer map_stub_x
integer map_stub_y
integer map_loop
integer map_window_mode 0
integer map_word_count
integer map_word_index
integer map_label_y
string_array map_label_parts 8

# Bounding-box globals populated by +map_bounds and consumed by +map_body.
integer map_bounds_init
integer map_min_x
integer map_max_x
integer map_min_y
integer map_max_y
integer map_offset_x
integer map_offset_y
integer map_canvas_w
integer map_canvas_h

grammar map >map
grammar m >map
grammar map window >map_window_on
grammar map open >map_window_on
grammar map close >map_window_off

# -------------------------------------------------------------------
# +map_bounds -- sweep visited locations and their exit destinations to
# compute the bounding box, then set map_offset_x/y and map_canvas_w/h.
# No output; just sets globals.
# -------------------------------------------------------------------

{+map_bounds
set map_bounds_init = 0
set map_min_x = 0
set map_max_x = 0
set map_min_y = 0
set map_max_y = 0

select VISITED map_here
   if map_here hasnt LOCATION
      # Skip closed objects -- see note in +map_body.
   else
      # Expand bounds to include this visited location.
      if map_bounds_init = 0
         set map_min_x = map_here(x)
         set map_max_x = map_here(x)
         set map_min_y = map_here(y)
         set map_max_y = map_here(y)
         set map_bounds_init = 1
      else
         if map_here(x) < map_min_x
            set map_min_x = map_here(x)
         endif
         if map_here(x) > map_max_x
            set map_max_x = map_here(x)
         endif
         if map_here(y) < map_min_y
            set map_min_y = map_here(y)
         endif
         if map_here(y) > map_max_y
            set map_max_y = map_here(y)
         endif
      endif

   endif
endselect

# Lines to unvisited destinations are 1-cell stubs (see +map_body), so
# pad the bounds by one cell in every direction to guarantee those stubs
# fit on the canvas even when a visited edge location has an unvisited
# exit pointing outward.
set map_min_x - 1
set map_max_x + 1
set map_min_y - 1
set map_max_y + 1

# offset shifts content so the min coord maps to grid cell 1 (one cell
# of padding on the left/top).
set map_offset_x = 1
set map_offset_x - map_min_x
set map_offset_y = 1
set map_offset_y - map_min_y

# canvas = (content-span-in-cells + 2 cells padding) * 100 + label overhang
set map_canvas_w = map_max_x
set map_canvas_w - map_min_x
set map_canvas_w + 2
set map_canvas_w * 150
set map_canvas_w + 40

set map_canvas_h = map_max_y
set map_canvas_h - map_min_y
set map_canvas_h + 2
set map_canvas_h * 150
set map_canvas_h + 40
}

# -------------------------------------------------------------------
# +map_body -- emits the paper.path(...) and paper.rect/text(...) calls
# for the current game state. Caller is responsible for:
#   1. Calling +map_bounds first so offsets are valid
#   2. Wrapping this in <script>...</script>
#   3. Defining `var paper = Raphael(...)` with map_canvas_w x map_canvas_h
#   4. Toggling `linebreaks` off/on around the emission
# -------------------------------------------------------------------

{+map_body
# DRAW EXIT LINES FROM EVERY VISITED LOCATION.
# The LOCATION guard is load-bearing: `select VISITED` actually tests bit 1
# of the attributes field, which means "VISITED" on a location but "CLOSED"
# on an object -- so without the guard we'd also iterate every closed
# container/drawer in the game (which have no x/y and stack at the origin).
select VISITED map_here
   if map_here hasnt LOCATION
      # Not a location (a closed object matching bit 1). Skip.
   else
   set map_loop = 0
   repeat
      ifall map_here(map_loop) != nowhere : map_here(map_loop) != NO_GO
         set map_target = map_here(map_loop)

         # Source pixel (center of map_here's node).
         set map_x = map_here(x)
         set map_x + map_offset_x
         set map_x * 150
         set map_x + 75
         set map_y = map_here(y)
         set map_y + map_offset_y
         set map_y * 150
         set map_y + 75

         # Draw a short stub from the source node in the direction of the
         # destination. Two adjacent visited rooms each draw a stub toward
         # each other; those stubs overlap in the middle and read as a
         # single connecting line. A visited room with an unvisited exit
         # shows just its own short whisker -- a hint that an exit exists
         # without pulling the eye across empty space.
         #
         # Orthogonal stubs use 40 px per axis (10 past the 30-px node
         # half-width). Diagonal stubs use 57 px per axis so the stub
         # reaches along the hypotenuse of the adjacent cell rather than
         # stopping short; without this, NE/NW/SE/SW exits fall noticeably
         # short of their neighbour's node even when both are visited.
         set map_stub_x = 0
         if map_target(x) > map_here(x)
            set map_stub_x = 1
         endif
         if map_target(x) < map_here(x)
            set map_stub_x = -1
         endif
         set map_stub_y = 0
         if map_target(y) > map_here(y)
            set map_stub_y = 1
         endif
         if map_target(y) < map_here(y)
            set map_stub_y = -1
         endif

         # Per-axis stub length: 57 if diagonal (both signs nonzero),
         # else 40. Multiplied by the sign to get the axis offset.
         set map_dest_x = map_stub_x
         set map_dest_y = map_stub_y
         ifall map_stub_x != 0 : map_stub_y != 0
            set map_dest_x * 170
            set map_dest_y * 170
         else
            set map_dest_x * 120
            set map_dest_y * 120
         endif
         set map_dest_x + map_x
         set map_dest_y + map_y

         write "paper.path(~M" map_x " " map_y "L" map_dest_x " " map_dest_y "~).attr(~stroke~, ~#888~);"
      endif
      set map_loop + 1
   until map_loop = 12
   endif
endselect

# DRAW A LABELLED NODE FOR EACH VISITED LOCATION.
select VISITED map_here
   if map_here hasnt LOCATION
      # Not a location -- skip, same reason as above.
   else
   # Rect takes top-left as the origin; for cell=150 and node=60 that
   # means offset (cell-node)/2 = 45 px into the cell, not cell/2.
   set map_x = map_here(x)
   set map_x + map_offset_x
   set map_x * 150
   set map_x + 45
   set map_y = map_here(y)
   set map_y + map_offset_y
   set map_y * 150
   set map_y + 45
   write "var node = paper.rect(" map_x ", " map_y ", 60, 60, 10);"
   if map_here = here
      write "node.attr(~fill~, ~#BDD8D6~);"
   else
      write "node.attr(~fill~, ~#eee~);"
   endif

   # CENTRE THE LABEL. If the name has multiple words, put the first on
   # the top line and the rest on the bottom line so the label stays
   # inside the 60-px square node.
   set map_x + 30
   set map_y + 30
   # Two separate paper.text calls for multi-word labels -- safer than
   # trying to embed a newline inside a JS string literal (whose
   # escaping through JACL's write/print layers is finicky). Top line
   # shifted up 7 px, bottom line shifted down 7 px, giving ~14 px
   # total line-height inside the 60-px node.
   split map_word_count map_here{The} " " map_label_parts
   if map_word_count < 2
      write "paper.text(" map_x ", " map_y ", ~"
      write map_here{The}
      write "~);"
   else
      set map_label_y = map_y
      set map_label_y - 7
      write "paper.text(" map_x ", " map_label_y ", ~"
      set map_word_index = 0
      write map_label_parts[map_word_index]
      write "~);"
      set map_label_y = map_y
      set map_label_y + 7
      write "paper.text(" map_x ", " map_label_y ", ~"
      set map_word_index = 1
      repeat
         write map_label_parts[map_word_index]
         set map_word_index + 1
         if map_word_index < map_word_count
            write " "
         endif
      until map_word_index = map_word_count
      write "~);"
   endif
   endif
endselect
}

# -------------------------------------------------------------------
# +map -- inline rendering in #maintext.
# -------------------------------------------------------------------

{+map
execute "+map_bounds"
set linebreaks = false
write "<div id=~jacl_map~></div>"
write "<script>"
write "var paper = Raphael(~jacl_map~, " map_canvas_w ", " map_canvas_h ", null);"
execute "+map_body"

# SCROLL THE MAIN TEXT PANE TO THE BOTTOM so the freshly inserted map
# is visible.
write "var mapMain = document.getElementById(~main~);"
write "if (mapMain) { mapMain.scrollTop = mapMain.scrollHeight; }"
write "</script>"

set linebreaks = true
set time = false
}

# -------------------------------------------------------------------
# +map_window_on -- open the popup and enable auto-update.
# -------------------------------------------------------------------

{+map_window_on
execute "+map_bounds"
set map_window_mode = 1
set linebreaks = false
write "<script>"
write "window.jaclMapMode = 1;"
write "jaclDrawMapInPopup(" map_canvas_w ", " map_canvas_h ", function(paper, mapWindow) {"
execute "+map_body"

# Centre the popup's map container on `here`.
set map_x = here(x)
set map_x + map_offset_x
set map_x * 150
set map_x + 75
set map_y = here(y)
set map_y + map_offset_y
set map_y * 150
set map_y + 75
write "var c = mapWindow.document.getElementById(~jacl_map~);"
write "if (c) { c.scrollLeft = " map_x " - mapWindow.innerWidth / 2; c.scrollTop = " map_y " - mapWindow.innerHeight / 2; }"

write "});"
write "</script>"
set linebreaks = true
write "Map window opened. It will update as you move.^"
set time = false
}

# -------------------------------------------------------------------
# +map_window_off -- close the popup and disable auto-update.
# -------------------------------------------------------------------

{+map_window_off
set map_window_mode = 0
set linebreaks = false
write "<script>window.jaclMapMode = 0; jaclCloseMapPopup();</script>"
set linebreaks = true
write "Map window closed.^"
set time = false
}

# -------------------------------------------------------------------
# +after_look -- hook called by +display_location after every movement
# or `look`. Redraws the popup if window mode is on.
# -------------------------------------------------------------------

{+after_look
if map_window_mode = 1
   execute "+map_bounds"
   set linebreaks = false
   write "<script>"
   write "if (window.jaclMapMode && typeof jaclDrawMapInPopup === ~function~) {"
   write "jaclDrawMapInPopup(" map_canvas_w ", " map_canvas_h ", function(paper, mapWindow) {"
   execute "+map_body"
   set map_x = here(x)
   set map_x + map_offset_x
   set map_x * 150
   set map_x + 75
   set map_y = here(y)
   set map_y + map_offset_y
   set map_y * 150
   set map_y + 75
   write "var c = mapWindow.document.getElementById(~jacl_map~);"
   write "if (c) { c.scrollLeft = " map_x " - mapWindow.innerWidth / 2; c.scrollTop = " map_y " - mapWindow.innerHeight / 2; }"
   write "});"
   write "}"
   write "</script>"
   set linebreaks = true
endif
}
