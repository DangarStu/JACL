grammar blow *held to *here     >blow_at

{+blow_at
break +darkness
write "Du kannst " noun1{the} " nicht auf " noun2{the} " blasen.^"
set time = false
}

grammar throw *held in *here     >throw_at
grammar hurl *held in *here      >throw_at
grammar pitch *held in *here     >throw_at
grammar cast *held in *here      >throw_at
grammar throw *held on *here     >throw_at
grammar hurl *held on *here      >throw_at
grammar pitch *held on *here     >throw_at
grammar cast *held on *here      >throw_at
grammar throw *held at *here     >throw_at
grammar throw *held to *here     >throw_at
grammar cast *held to *here      >throw_at
grammar cast *held at *here      >throw_at
grammar pitch *held to *here     >throw_at
grammar pitch *held at *here     >throw_at
grammar lob *held to *here       >throw_at
grammar lob *held at *here       >throw_at
grammar hurl *held to *here      >throw_at
grammar hurl *held at *here      >throw_at

{+throw_at
break +darkness
if noun2 has ANIMATE
  write "Ich glaube nicht, dass " noun2{the} " es zu schätzen wüsste, wenn Du "
  write noun1{the} " nach "
  if noun2 has FEMALE
    write "ihr wirfst.^"
  else
    write "ihm wirfst.^"
  endif
  set time = false
  break
endif
break +worn noun1
if noun2(parent) hasnt LOCATION
  write "Du kannst " noun1{the} " nicht nach " noun2{the} " werfen, solange "
  if noun2 has PLURAL
    write "sie in etwas anderem sind"
  else
    write "es in etwas anderem ist"
  endif
  write ".^"
  set time = false
  break
endif
if noun1(mass) >= heavy : noun1 has LOCATION
  execute +move_scenery
  break
endif
override
if noun1(mass) => 20
  write  noun1{The}
  if noun1 has PLURAL
    write " sind "
  else
    write " ist "
  endif
  write "ein bisschen zu schwer, um damit zu werfen.^"
  set time = false
  break
endif
if here has UNDER_WATER
  write "Unter Wasser zu werfen ist nie so einfach wie man denkt.^"
  set time = false
  break
endif
if here has ON_WATER
  write "Du wirfst " noun1{the} " nach " noun2{the} ", worauf "
  if noun1 has PLURAL
    write "sie abprallen"
  else
    write "es abprallt"
  endif
  write " und ins Wasser fällt, wo "
  if noun1 has PLURAL
    write "sie"
  else
    write "es"
  endif
  write " rasch versink" noun1{t} " und aus dem Blickfeld verschwind" noun1{t} ".^"
  move noun1 to limbo
  break
endif
write  noun1{The} " prall" noun1{t} " von " noun2{the} " ab und land" noun1{t}
write " am Boden.^"
move noun1 to here
}

grammar remove *present from *present     >remove_from
grammar take *present from *present       >remove_from
grammar get *present from *present        >remove_from
grammar take *present out of *present     >remove_from
grammar get *present out of *present      >remove_from
grammar take *present on *present         >remove_from
grammar get *present on *present          >remove_from

{+remove_from
break +darkness
if noun1(parent) <> noun2
  write  noun1{The} " " noun1{is} " nicht in " noun2{the} ".^"
  set time = false
  break
endif
proxy "take" noun1
}

grammar remove *present       >remove
grammar take off *present     >remove
grammar doff *present         >remove

{+remove
if noun1 hasnt WORN
  if noun1(parent) = player
    write "Du trägst " noun1{the} " nicht.^"
    set time = false
    break
  endif
endif
if noun1 hasnt WORN
  proxy "take" noun1
  break
endif
if noun1(mass) > player(quantity)
  write "Du trägst zu viel, um " noun1{the} " auszuziehen.^"
  set time = false
  break
endif
override
set player(quantity) - noun1(mass)
ensure noun1 hasnt WORN
write "Du ziehst " noun1{the} " aus.^"
}

grammar wear *held       >wear
grammar put on *held     >wear
grammar put *held on     >wear
grammar don *held        >wear

{+wear
if noun1 hasnt WEARABLE
  write "Du kannst " noun1{the} " nicht anziehen.^"
  set time = false
  break
endif
if noun1 has WORN
  write "Du trägst " noun1{the} " bereits.^"
  set time = false
  break
endif
override
set player(quantity) + noun1(mass)
ensure noun1 has WORN
write "Du ziehst " noun1{the} " an.^"
}

