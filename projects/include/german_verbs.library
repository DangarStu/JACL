grammar stand on *here       >jump_on

{+jump_on
break +darkness
set time = false
if noun1 hasnt SURFACE
  write "Du kannst nicht auf " noun1{the} " springen.^"
  break
endif
write "Das würde wenig bringen.^"
}

grammar jump over *here     >jump_over

{+jump_over
break +darkness
write "Du kannst nicht über " noun1{the} " springen.^"
set time = false
}

grammar jump     >jump

{+jump
if here has MID_AIR
  write "Eher nicht."
  break
endif
if here has TIGHT_ROPE
  write "Etwas sagt mir, das wäre ein bisschen zu gefährlich, von "
  write "völlig unnötig ganz zu schweigen.^"
  break
endif
if here has UNDER_WATER : here has ON_WATER
  write "Unter Wasser?^"
  break
endif
if player has SITTING
  write "Du müsstest erst aufstehen.^"
  break
endif
write "Erledigt.^"
}

