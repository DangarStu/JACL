look
}

grammar schaue unter *present     >look_under

{+look_under
break +darkness
if noun1(mass) >= heavy : noun1 has LOCATION
  write "Du kannst nicht unter " noun1{the} " sehen.^"
  set time = false
  break
endif
write "Unter " noun1{the} " ist nichts Ungewöhnliches.^"
}

grammar look behind *present     >look_behind

{+look_behind
break +darkness
if noun1(mass) >= heavy : noun1 has LOCATION
  write "Du kannst nicht hinter " noun1{the} " sehen.^"
  set time = false
  break
endif
write "Hinter " noun1{the} " ist nichts Ungewöhnliches.^"
}

grammar look through *present     >look_through
grammar look out *present         >look_through

{+look_through
break +darkness
write "Du kannst nicht durch " noun1{the} " sehen.^"
set time = false
}

grammar look through *held at *present     >look_through_at

{+look_through_at
break +darkness
proxy "look at " noun2 " through " noun1
}

grammar look at *present through *held     >look_at_through
grammar look at *present with *held        >look_at_through

{+look_at_through
break +darkness
if noun1 = noun2
  write "Du kannst " noun1{the} " nicht durch "
  if noun1 has PLURAL
    write "sich selbst betrachten.^"
  else
    write "sich selbst betrachten.^"
  endif
  set time = false
  break
endif
override
write "Du kannst " noun1{the} " nicht durch " noun2{the} " betrachten.^"
set time = false
}

grammar wait     >wait
grammar z        >wait

{+wait
write "Die Zeit vergeht...^"
}

grammar listen     >listen

{+listen
write "Du hörst nichts Ungewöhnliches.^"
}

grammar listen to *present     >listen_to
grammar listen at *present     >listen_to

{+listen_to
write "Du hörst nichts Ungewöhnliches.^"
}

grammar use *present         >use
grammar work *present        >use
grammar operate *present     >use

{+use
break +darkness
if noun1 has ANIMATE
  write "Ich will die Antwort darauf wahrscheinlich nicht wissen, aber auf "
  write "welche Weise wolltest Du " noun1{the} " benutzen?^"
  set time = false
  break
endif
write "Du musst etwas genauer werden.^"
}

grammar rotate *present     >turn
grammar turn *present       >turn
grammar twist *present      >turn
grammar spin *present       >turn

{+turn
break +darkness
break +reach noun1
write "Du kannst " noun1{the} " nicht drehen.^"
set time = false
}

grammar schalte *present an     >turn_on
grammar turn *present on        >turn_on
grammar switch on *present      >turn_on
grammar switch *present on      >turn_on

{+turn_on
if noun1 hasnt SWITCHABLE
  write "Du kannst " noun1{the} " nicht einschalten.^"
  set time = false
  break
endif
break +reach noun1
if noun1 has ON
  write  noun1{The} " " noun1{is} " bereits eingeschaltet.^"
  set time = false
  break
endif
override
write "Du schaltest " noun1{the} " ein.^"
ensure noun1 has ON
}

grammar schalte *present ab     >turn_off
grammar turn *present off       >turn_off
grammar switch off *present     >turn_off
grammar switch *present off     >turn_off

{+turn_off
if noun1 hasnt SWITCHABLE
  write "Du kannst " noun1{the} " nicht ausschalten.^"
  set time = false
  break
endif
break +reach noun1
if noun1 hasnt ON
  write  noun1{The} " " noun1{is} " bereits ausgeschaltet.^"
  set time = false
  break
endif
override
write "Du schaltest " noun1{the} " aus.^"
ensure noun1 hasnt ON
}

grammar pour *present     >pour

{+pour
break +darkness
if noun1 hasnt LIQUID
   write "Du kannst " noun1{the} " nicht gießen.^"
   set time = false
   break
endif
set noun3 = noun1(parent)
if noun3 = false : noun3(parent) <> player
  write "Du hast " noun1{the} " nicht.^"
  set time = false
  break
endif
if noun3 has CLOSED
  write "Ich sehe " noun1{the} " hier nicht.^"
  set time = false
  break
endif
break +reach noun1
override
write "Du gießt " noun1{the} " über den Boden.^"
move noun1 to limbo
}

grammar list objects     >list_objs

{+list_objs
select noun3(mass) > 0 
   write noun3{The} 
next
}

grammar diag *anywhere     >diag

{+diag
set INDEX = noun1
write  noun1{The} ":^"
write "MASS: " noun1(mass) ^
write "NUMBER: " INDEX ^
write "QUANTITY: " noun1(quantity) ^
set noun4 = noun1(parent)
write "PARENT: " noun4{The} ^
write "HAS DARK?: "
if noun1 has DARK
   write YES^
else
   write NO^
endif
write "HAS DARKNESS?: "
if noun1 has DARKNESS
   write YES^
else
   write NO^
endif
}

grammar tip *present on *present        >pour_on
grammar tip *present down *present      >pour_on
grammar tip *present in *present        >pour_on
grammar tip *present over *present      >pour_on
grammar pour *present down *present     >pour_on
grammar pour *present on *present       >pour_on
grammar pour *present in *present       >pour_on
grammar pour *present over *present     >pour_on

{+pour_on
break +darkness
if noun1 hasnt LIQUID
  write "Du kannst " noun1{the} " nicht gießen.^"
  set time = false
  break
endif
break +reach noun1
set noun3 = noun1(parent)
if noun3 = false : noun3(parent) <> player
  write "Du hast " noun1{the} " nicht.^"
  set time = false
  break
endif
if noun3 has CLOSED
  write "Ich sehe " noun1{the} " hier nicht.^"
  set time = false
  break
endif
break +reach noun2
override
execute +liquidwrite noun2
if INDEX = true
  write  noun2{The} " enthält bereits " noun3{the} ". Würdest Du "
  write "auch noch " noun1{the} " hinzugeben, würden sie sich vermischen.^"
  set time = false
  break
endif
if noun2 has CONTAINER
  if noun2 hasnt CLOSED
    override
    write "Du gießt " noun1{the} " in " noun2{the} ".^"
    move noun1 to noun2
    break
  endif
endif
if noun2(parent) > max_objects
  set noun3 = noun2(parent)
  if noun3 has CONTAINER
    if noun3 hasnt CLOSED
      write  noun1{the} " läuf" noun1{t} " von " noun2{the} " herunter und in "
      write noun3 .^
      move noun1 to noun3
      break
    endif
  endif
endif
write  noun1{The} " läuft von " noun2{the} " auf den Boden.^"
move noun1 to limbo
}

grammar blankjacl     >blankjacl

{+blankjacl
write "Sie müssen einen Befehl eingeben. Geben Sie ~hilfe~ ein, um weitere Informationen zu erhalten.^"
set time = false
}

grammar instructions     >instructions
grammar help             >instructions

{+instructions
write "Interaktive Fiktion bindet den Leser auf eine Weise ein, wie es "
write "statische Geschichten nicht tun. Anstatt der Reihe nach von Anfang bis "
write "Ende zu lesen, steuerst Du die Handlungen der Hauptfigur, indem Du "
write "Befehle in Form einfacher deutscher Sätze eingibst. Bevor Du Dich auf "
write "Dein Abenteuer begibst, sind einige Grundbegriffe zu erklären, damit Du "
write "erfolgreich mit der vom Autor geschaffenen Welt interagieren kannst."
write "Der Raum, den Du erkundest, ist in einzelne Einheiten unterteilt, die "
write "Orte genannt werden. Zwischen Orten bewegst Du Dich über die "
write "~Du kannst gehen:~-Verknüpfungen oder die folgenden Befehle...^"
write ""
write "BefehlRichtungBefehlRichtung"
write ""

write "NNordenSSüden"
write ""

write "OOstenWWesten"
write ""

write "NONordostenNWNordwesten"
write ""

write "SOSüdostenSWSüdwesten"
write ""

write "OOben (up)UUnten (down)"
write ""

write "REINHineinRAUSHinaus"
write ""

write "Die Beschreibung jedes Ortes sagt Dir, in welche Richtungen Du ihn "
write "verlassen kannst. Beachte jedoch, dass manche Ausgänge nur unter "
write "bestimmten Umständen verfügbar sind, z. B. solange eine Tür offen "
write "oder eine Brücke heruntergelassen ist.^"

write "An diesen Orten findest Du viele Gegenstände, mit denen Du "
write "interagieren kannst. Auf diese Gegenstände kannst Du mit so wenigen "
write "oder so vielen ihrer Namen verweisen, wie nötig sind, um sie eindeutig zu bestimmen."
write "Wenn die Geschichte Dir zum Beispiel mitteilt ~Hier liegt ein "
write "silberner Schlüssel.~, kannst Du ihn mit ~silbern~, ~schlüssel~ oder "
write "~silberner schlüssel~ meinen. Ist Deine Eingabe mehrdeutig, etwa "
write "~schlüssel~ wenn ein silberner und ein goldener Schlüssel am gleichen "
write "Ort liegen, wirst Du gebeten, genauer zu sein.^"

write ""
write "Das nächste wichtige Konzept der interaktiven Fiktion ist die Art, wie "
write "Du mit den Gegenständen an den Orten umgehst. Der entscheidende "
write "Punkt bei der Befehlseingabe ist der Umfang, also wie viel sich mit "
write "einem einzigen Befehl erreichen lässt. Wie Du oben gesehen hast, "
write "reicht ein einzelner Befehl, um von einem Ort zum nächsten zu gehen. "
write "Befehle wie ~finde dave~ oder ~geh zur bibliothek~ sind nicht "
write "zulässig. Du musst die Welt selbst Schritt für Schritt durchqueren. "
write "Deshalb empfiehlt es sich sehr, unterwegs eine Karte zu zeichnen.^"

write "Die grundlegenden Satzmuster, die das Spiel versteht, sind...^"
write ""
write "Verbz.B. schrei"
write ""
write "Verb Objektz.B. nimm buch"
write ""
write "Verb Objekt Präposition Objektz.B. schließe tür mit schlüssel auf"
write ""
write ""

write "Ein Verb muss nicht unbedingt ein einzelnes Wort sein. So kann "
write "zum Beispiel ~untersuche stein durch lupe~ (ein Beispiel für das "
write "letzte Muster) auch als ~schaue stein durch lupe an~ geschrieben "
write "werden.^"
write "Um zu verdeutlichen, wie viel mit einem einzigen Zug erreicht werden "
write "kann, hier einige gültige Verben...^"
write ""
write "drehelesezieheschiebeessschneide"
write ""
write "schließeöffnereibegreif anschmeckeetrinke"
write ""
write "zerbrichriechehörgießebewegezünde"
write ""
write "greif anblasewirftragöffneschließe"
write ""
write "nimmlegelegeinentferne"
write ""
write "Die Wörter ~es,~ ~sie (Plural),~ ~ihn~ und ~sie~ können benutzt werden, "
write "um auf das zuletzt passende Objekt zu verweisen, das in einem Deiner "
write "Befehle vorkam. "
write "Die Wörter ~sich,~ ~sich selbst~ und ähnliche können benutzt werden, "
write "um auf das Subjekt des aktuellen Befehls zu verweisen, z. B. ~frag dan "
write "nach sich selbst~.^"
write "Das Wort ~alles~ kann anstelle eines Objekts benutzt werden, wenn "
write "eines der Verben aus der untersten Zeile der Tabelle oben benutzt wird.^"

write ""
write "Eine Aufgabe wie das Entschärfen einer Bombe lässt sich allerdings "
write "nicht einfach mit ~entschärfe bombe~ lösen. Das folgende Protokoll "
write "zeigt, wie so etwas gelingen könnte.^"
write "&gt;examine bomb"
write "Die Bombe ist etwa dreißig Zentimeter groß und hat an der Oberseite "
write "eine kleine Klappe. Die Klappe ist gerade geschlossen.^"
write "&gt;listen to bomb" 
write "Die Bombe gibt ein bedrohliches Ticken von sich.^"
write "&gt;open panel"
write "Du öffnest die Klappe und siehst ein rotes, ein grünes und ein blaues "
write "Kabel, eine Uhr und etwas Dynamit.^"
write "&gt;i"
write "Du trägst ein Bombenhandbuch, eine Versicherungspolice und einen "
write "Seitenschneider.^"
write "&gt;read manual"
write "Beim Blättern durch das Buch stößt Du auf die Seite zum Entschärfen. "
write "Sieht einfach aus: erst das blaue Kabel durchtrennen, dann das rote.^"
write "&gt;cut blue wire with cutters"
write "Du greifst vorsichtig in das Gehäuse der Bombe und durchtrennst das "
write "blaue Kabel. So weit, so gut.^"
write "&gt;cut red wire with cutters" 
write "Mit angehaltenem Atem durchtrennst Du das rote Kabel." ^
write "&gt;listen to bomb" 
write "Die Bombe ist, zum Glück, jetzt still." ^
write "Wie Du siehst, muss jede Aufgabe, die Du lösen willst, in ihre "
write "Einzelhandlungen zerlegt werden.^"

write ""
write "Im Laufe der Geschichte triffst Du möglicherweise auf andere, "
write "computergesteuerte Figuren. Mit diesen kannst Du über die folgenden "
write "Befehle interagieren...^"
write "REDE MIT &lt;figur&gt;" 
write "GIB &lt;objekt&gt; AN &lt;figur&gt;" 
write "ZEIGE &lt;objekt&gt; AN &lt;figur&gt;" 
write "FRAG &lt;figur&gt; NACH &lt;objekt&gt;" 
write "FRAG &lt;figur&gt; ÜBER &lt;objekt&gt;" 
write "ERZÄHLE &lt;figur&gt; VON &lt;objekt&gt;" ^

write "Es gibt zudem einige Sonderbefehle, um mit dem Programm selbst und "
write "nicht mit der simulierten Welt zu interagieren...^"
write ""
write "BefehlWirkung"
write ""
write "VERBOSEimmer ausführliche Ortsbeschreibungen"
write ""
write "BRIEFnur neue Orte ausführlich beschreiben"
write ""
write "RESTARTvon vorn anfangen"
write ""
write "SCOREPunktzahl und Rang anzeigen"
write ""
write "LOOKden aktuellen Ort beschreiben"
write ""
write "SAVEaktuellen Spielstand speichern"
write ""
write "RESTOREgespeicherten Spielstand laden"
write ""
write "Iwaagrechte Liste des Inventars"
write ""
write "INVsenkrechte Liste des Inventars"
write ""
write "UNDOletzten Befehl rückgängig machen"
write ""
write "AGAINletzten Befehl wiederholen"
write ""
write "INFOVersionsinformationen anzeigen"
write ""
write "ABOUTSpielinformationen anzeigen"
write ""
write "HINWEIS: Wenn Du nach einem Tipp für einen bestimmten Ort suchst, "
write "gib an diesem Ort ~hint~, ~first hint~ oder ~hint one~ ein. Der erste "
write "Tipp ist ein subtiler Hinweis; ~hint two~ ist deutlicher und "
write "~hint three~ nennt die genauen Befehle.^"

write ""
write "Du bist nun bereit, Dich auf Dein erstes Abenteuer in der Welt der "
write "interaktiven Fiktion zu begeben."
write " Denk daran, unterwegs eine Karte zu zeichnen, und lies jeden Teil "
write "sorgfältig durch, denn wichtige Hinweise können sich in den "
write "Beschreibungen der Orte und Objekte verbergen. Jedes Objekt zu "
write "untersuchen, auf das Du Dich beziehen kannst, ist eine gute Idee, "
write "ebenso wie häufiges Speichern. Also, viel Glück und vor allem viel Spaß!^"
set time = false
}

;                                                    SPEAKING TO OTHER OBJECTS
; ----------------------------------------------------------------------------
; Grammar statements beginning with an object must be defined last in the game
; to avoid confusion with verbs that may also be objects such as "drink drink"

grammar *here press *present     >tell_to_press
grammar *here push *present      >tell_to_press

{+tell_to_press
break +can_talk noun1
write "~You press it,~ " noun1{the} " replies.^"
}

grammar *present give myself *carried         >ask_for
grammar *present give *carried to myself      >ask_for
grammar *present give *carried to me          >ask_for
grammar *present give myself *anywhere        >ask_for
grammar *present give *anywhere to myself     >ask_for
grammar *present give *anywhere to me         >ask_for

grammar *present tell myself about *carried          >ask_about
grammar *present tell myself all about *carried      >ask_about
grammar *present what do you know about *carried     >ask_about
grammar *present tell myself about *anywhere         >ask_about
grammar *present tell myself all about *anywhere     >ask_about
grammar *present what do you know about *anwhere     >ask_about

grammar *present who are you            >who?
grammar *present what is your name      >who?
grammar *present what is your name?     >who?

{+who?
proxy "ask " noun1 " about " noun1
}

grammar *present sorry            >apologise
grammar *present im sorry         >apologise
grammar *present i am sorry       >apologise
grammar apologise to *present     >apologise

{+apologise
if noun1 hasnt ANIMATE
   write "Seltsam.^"
   break
endall
write  noun1{the} " versicher" noun1{t} " Dir, dass keine Entschuldigung nötig ist.^"
}

grammar *present thanks        >thank
grammar *present thank you     >thank
grammar thank *present         >thank

{+thank
if noun1 hasnt ANIMATE
   write "Seltsam.^"
   break
endall
write "~Keine Ursache,~ " noun1{the} " antwortet.^"
}

grammar hi *present           >greet
grammar hello *present        >greet
grammar greet *present        >greet
grammar *present hello        >greet
grammar *present hi there     >greet
grammar *present dr           >greet
grammar *present doctor       >greet
grammar *present hi           >greet

{+greet
if here has UNDER_WATER
   write "Unter Wasser zu sprechen ist nicht einfach.^"
   set time = false
   break
endall
if noun1 hasnt ANIMATE
   write "Ich glaube nicht, dass Dir hilft, mit " noun1{the} " zu reden.^"
   set time = false
   break
endall
if noun1 has DEAD 
   write  noun1{The} " " noun1{is} " ein bisschen zu tot, um zu antworten.^"
   set time = false
   break
endall
if noun1 = player
   write "Das ist bekanntlich das erste Anzeichen von Verrücktheit...^"
   break
endall
override
write  noun1{The}
if noun1 has PLURAL
   write " nicken.^"
else
   write " nickt.^"
}
 
grammar *present yes      >say_yes
grammar *present okay     >say_yes
grammar *present yeah     >say_yes

{+say_yes
write  noun1{The} " scheint keine Notiz zu nehmen.^"
}

grammar *present no     >say_no

{+say_no
write  noun1{The} " scheint keine Notiz zu nehmen.^"
}

grammar *present *carried      >say_object
grammar *present *anywhere     >say_object

{+say_object
proxy "say " noun2 " to " noun1
}

grammar *anywhere     >noun_only

{+noun_only
if noun1 isnt *present
   write "Du siehst so etwas hier nicht.^"
   set time = false
   break
endif
write "In diesem Satz fehlt ein Verb.^"
set time = false
}

{+game_over
write "^"
execute "+score"
select player
   set noun3(parent) = limbo
endselect
set player(parent) = epilogue
write "^"
execute "+look_around"
}

location epilogue : epilogue
 short         name "Ende"
 has           DONT_MAP

{look
if interpreter = GLK
   write "Das Spiel ist vorbei. Gib "
   style input
   write "undo"
   style normal
   write ", "
   style input
   write "neustart"
   style normal
   write " oder "
   style input
   write "restore"
   style normal
   write " gefolgt vom Dateinamen ein, oder "
   style input
   write "beenden"
   style normal
   write ".^"
else
   write "Das Spiel ist vorbei. Gib <b>undo</b>, <b>neustart</b> oder <b>restore</b> "
   write "gefolgt vom Dateinamen ein.^"
endif
}
