grammar lanzar *held en *here	>throw_at
grammar lanzar *held a *here	>throw_at
grammar arrojar *held a *here	>throw_at
grammar throw *held in *here	>throw_at
grammar hurl *held in *here		>throw_at
grammar pitch *held in *here	>throw_at
grammar cast *held in *here		>throw_at
grammar throw *held on *here	>throw_at
grammar hurl *held on *here		>throw_at
grammar pitch *held on *here	>throw_at
grammar cast *held on *here		>throw_at
grammar throw *held at *here	>throw_at
grammar throw *held to *here	>throw_at
grammar cast *held to *here		>throw_at
grammar cast *held at *here		>throw_at
grammar pitch *held to *here	>throw_at
grammar pitch *held at *here	>throw_at
grammar lob *held to *here		>throw_at
grammar lob *held at *here		>throw_at
grammar hurl *held to *here		>throw_at
grammar hurl *held at *here		>throw_at

{+throw_at
if +important<noun2 = true
   return true
endif
if +not_held<noun1 = true
   return
endif
if +darkness = true
   return true
endif
if noun2 has LOCATION
   write noun1{The} " cae cerca.^"
   move noun1 to here
   return
endif
if noun2 is *held
   write "Es dificil lanzar algo a " noun2{the} " mientras lo "
   write "sostienes.^"
   set time = false
   return
endif
if noun2(parent) hasnt LOCATION
   write "No puedes lanzar " noun1{the} " a " noun2{the} " mientras "
   if noun2 has PLURAL
      write "estan"
   else
      write "esta"
   endif
   write " dentro de otra cosa.^"
   set time = false
   return true
endif
if +move_scenery<noun1 = true
   return true
endif
if +worn<noun1 = true
   return true
endif
override
if noun2 has ANIMATE
   write "No creo que " noun2{the} " apreciaria que le lanzaras "
   write noun1{the} .^
   set time = false
   return true
endif
if noun1(mass) => 20
   write noun1{The}
   if noun1 has PLURAL
     write " son "
   else
     write " es "
   endif
   write "demasiado pesado para andar lanzandolo.^"
   set time = false
   return true
endif
if here has UNDER_WATER
   write "Lanzar cosas bajo el agua nunca es tan facil como "
   write "podrias pensar.^"
   set time = false
   return true
endif
if here has ON_WATER
   write "Lanzas " noun1{the} " a " noun2{the} ", rebota "
   write "y cae al agua donde "
   write "se hunde rapidamente, desapareciendo de la vista.^"
   move noun1 to limbo
   return true
endif
write  noun1{The} " rebota en " noun2{the} " y cae "
write "al suelo.^"
move noun1 to here
}

grammar quitarse **held       >remove
