{+fill_with
if +not_held<noun1 = true
   return
endif
if +important<noun2 = true
   return true
endif
if +darkness = true
   return true
endif
if +reach<noun2 = true
   return true
endif
if noun2 hasnt LIQUID
   if +contains_liquid?<noun2 = true
      set noun2 = CHILD
   else
      write "Solo puedes llenar " noun1{the} " con un liquido.^"
      return true
   endif
endif
if noun1 hasnt CONTAINER
   write  noun1{The} " no es un contenedor y por tanto no se puede "
   write "llenar.^"
   return true
endif
if noun1 has CLOSED
   write "No puedes llenar " noun1{the} " mientras "
   if noun1 has PLURAL
      write "estan"
   else
      write "esta"
   endif
   write " cerrado.^"
   set time = false
   return true
endif
if +contains_liquid?<noun1 = true
   write  noun1{The} " ya contiene " CHILD{the} ". Si ademas "
   write "anadieras " noun2{the} " se mezclarían.^"
   set time = false
   return true
endif
if noun1(quantity) < noun2(mass)
   write  noun1{The} " no es lo bastante grande para contener "
   write noun2{the} .^
   set time = false
   return true
endif
override
write "Llenas " noun1{the} " con " noun2{the} .^
move noun2 to noun1
}

{+contains_liquid?
# CHECK IF THE SPECIFIED OBJECT CONTAINS ANY LIQUIDS
select LIQUID CHILD
   if CHILD(parent) = arg[0]
      return true
   endif
endselect
return false
}

