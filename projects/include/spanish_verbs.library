   return true
endif
override
if +contains_liquid?<noun2 = true
   write noun2{The} " ya contiene " CHILD{the} ". Si "
   write "ademas anadieras " noun1{the} " se mezclarían.^"
   set time = false
   return true
endif
ifall noun2 has CONTAINER : noun2 hasnt CLOSED
   override
   write "Viertes " noun1{the} " en " noun2{the} .^
   move noun1 to noun2
   return true
endif
ifall noun2(parent) hasnt LOCATION : noun2(parent) has CONTAINER
   set noun3 = noun2(parent)
   write noun1{The} " se escurre de " noun2{the} " y cae en "
   write noun3{the} ".^"
   move noun1 to noun3
   return true
endif
write noun1{The} " se escurre de " noun2{the} " y se derrama por todo el "
write "suelo.^"
move noun1 to limbo
}

