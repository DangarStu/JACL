integer from_location 0

{+travel
set compass = arg[0]
if compass < 0 : compass > 11
   write "ERROR: No se puede mover en la direccion: " compass ".^"
   return
endif
set destination = here(compass)
ifexecute "+movement"
   # THE MOVE HAS BEEN STOPPED, JUST RETURN
   set time = false
   return
endif
ifexecute "here.movement"
   # THE MOVE HAS BEEN STOPPED, JUST RETURN
   set time = false
   return
endif
if destination = 0
   write "No puedes ir por ahi.^"
   set time = false
else
   set from_location = here
   set player(parent) = destination
   execute "+display_location"
   set time = true
endif
}

