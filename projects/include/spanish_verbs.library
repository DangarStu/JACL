   write "Juego guardado.^"
endif
set time = false
}

grammar restore >restore_game
grammar restaurar >restore_game

{+restore_game
restoregame INDEX
if INDEX = true
   write "Juego restaurado.^^"
   ensure here hasnt VISITED
   execute "+display_location"
endif
set time = false
}

