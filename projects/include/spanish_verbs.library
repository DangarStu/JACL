integer_array available_exits 12 0
string dir_command norte sur este oeste noreste noroeste
string dir_command sureste suroeste arriba abajo adentro afuera

grammar about >about
grammar acerca >about

{+about
style note
write game_title
style normal
write ", Copyright (c) " game_author "^"
write "Release " game_release " / build " game_build
write " / JACL verb.library version " library_version "^^"
}

constant NO_GO 22000

grammar exits >exits
grammar salidas >exits

{+exits
execute "+calculate_exits"
write "Puedes ir "
if INDEX = 0
   write "a ninguna parte!^"
   set time = false
   return true
endif
set COUNTER = 0
repeat
   if available_exits[COUNTER] != nowhere
      hyperlink dir_command[COUNTER] dir_command[COUNTER]
      if available_exits[COUNTER] has KNOWN
         write " a " available_exits[COUNTER]{the}
      endif
      set INDEX - 1
      execute "+or_structure"
   endif
   set COUNTER + 1
until COUNTER = 12
write ".^"
set time = false
}

{+calculate_exits
execute "+clear_list"
# LOOP THROUGH ALL THE EXITS OF THE CURRENT LOCATION
set COUNTER = 0
set INDEX = 0
repeat
   ifall here(COUNTER) != nowhere : here(COUNTER) != NO_GO : +in_list<here(COUNTER) = false
      set available_exits[COUNTER] = here(COUNTER)
      set INDEX + 1 # THIS IS COUNTING THE NUMBER OF EXITS FOR PUNCTUATION
   else
      set available_exits[COUNTER] = 0
   endif
   set COUNTER + 1
until COUNTER = 12
}

{+in_list
set TEMP = 0
repeat
   if available_exits[TEMP] = arg[0]
      return true
   endif
   set TEMP + 1
until TEMP = 12
return false
}

{+clear_list
set TEMP = 0
repeat
   set available_exits[TEMP] = 0
   set TEMP + 1
until TEMP = 12
}

{+darkness
if here has DARKNESS
   execute "+no_light"
   return true
endif
return false
}

{+can_talk
if here has UNDER_WATER
   write "Hablar bajo el agua no es nada facil.^"
   set time = false
   return true
endif
if arg[0] = player
   write "Es el primer signo de locura, sabes...^"
   set time = false
   return true
endif
if arg[0] hasnt ANIMATE
   write "No creo que hablar con " arg[0]{the} " vaya a ayudar.^"
   set time = false
   return true
endif
if arg[0] has DEAD
   write  arg[0]{The} " esta demasiado muerto para responder.^"
   set time = false
   return true
endif
return false
}

{+important
if arg[0] has NOT_IMPORTANT
   write  arg[0]{The} " no es importante; no necesitas preocuparte por " arg[0]{obj} ".^"
   set time = false
   return true
endif
return false
}

{+reach
if arg[0] has OUT_OF_REACH
   write  arg[0]{The} " esta fuera de alcance.^"
   set time = false
   return true
endif
return false
}

{+possessed
set INDEX grandof noun1
ifall INDEX has ANIMATE : INDEX != player : noun1 != INDEX
   write INDEX{The} " se niega a darte " noun1{the} .^
   set time = false
   return true
else
   return false
endif
}

# Open an object if possible in order to perform typed command.
{+closed
if arg[0] hasnt CLOSED
   return false
endif
proxy "open " arg[0]{names}
if arg[0] has CLOSED
   set time = false
   return true
endif
return false
}

# Stop wearing an object if possible in order to perform typed command.
{+worn
if arg[0] hasnt WORN
   return false
endif
proxy "remove " arg[0]{names}
if arg[0] has WORN
   set time = false
   return true
endif
return false
}

# Take an object if possible in order to perform typed command.
{+not_held
if arg[0] is *held
   return false
endif
proxy "take " arg[0]{names}
if arg[0] isnt *held
   set time = false
   return true
endif
return false
}

location limbo : limbo

grammar sacudir >shake_only
grammar agitar >shake_only
grammar shake >shake_only

{+shake_only
write "Asustado?^"
set time = false
}

grammar sacudir *held   >shake
grammar agitar *held    >shake
grammar shake *held   >shake
grammar wave *held    >shake

{+shake
if +not_held<noun1 = true
   return
endif
write "Consideralo hecho.^"
}

grammar decir xyzzy >xyzzy
grammar di xyzzy >xyzzy
grammar say xyzzy >xyzzy
grammar xyzzy     >xyzzy

{+xyzzy
set time = false
if @+xyzzy != 1
   write "~Vete. Dejanos en paz.~^"
   return true
endif
write "~Esa es la contrasena, abre la puerta.~^^"
write "~Estas seguro? No reconozco la voz.~^^"
write "~No discutas, solo abre la puerta!~^^"
write "Una puerta previamente invisible se abre. Mas alla de la puerta ves "
write "lo que solo puedes imaginar como el taller de Dios.^^"
write "write ~Mierda! Te dije que no era el!" caret "~;^"
write "set bouncer_1(panic) + 5;^"
write "write ~Rapido! Cierra la puerta." caret "~;^"
write "set poo(parent) = bouncer_2s_trousers;^"
write "ensure magic_door has CLOSED;^"
write "^La puerta se cierra y desaparece de nuevo. Algo te dice que "
write "va a ser uno de esos dias...^"
}

grammar save $string >named_save
grammar guardar $string >named_save

{+named_save
savegame INDEX $string
if INDEX = true
   write "Juego guardado.^"
endif
set time = false
}

grammar restore $string >named_restore
grammar restaurar $string >named_restore

{+named_restore
restoregame INDEX $string
if INDEX = true
   write "Juego restaurado.^^"
   ensure here hasnt VISITED
   execute "+display_location"
endif
set time = false
}

string filename

{+load_saved
repeat
   write "Quieres restaurar un juego guardado?^"
   getyesorno TEMP
   if TEMP = true
       restoregame INDEX
       if INDEX = true
          write "Juego restaurado.^^"
   		  ensure here hasnt VISITED
          execute "+display_location"
          return true
       endif
   endif
until TEMP = false
return false
}

grammar save >save_game
grammar guardar >save_game

{+save_game
