# STANDARD HEADERS AND FOOTERS FOR WEB-BASED INTERACTIVE FICTION

string current_image     "none"
constant title_image     "none"
constant header_colour       "#42596d"
constant linkbar_colour      "#6a7a87"
constant maintext_colour     "#eeeeee"
constant title_colour        "black"
constant footer_image        "none"

# voice_enabled: player chose text-to-speech yes/no (web only, persisted
# in the auto-save). sound_enabled is *not* declared here -- the loader
# creates it for us and the interpreter's sound handler already gates
# both GLK channels and CGI <audio> emission on its value, so writing it
# from JACL is enough; no per-site `if sound_enabled` is required.
integer voice_enabled

# Asks the player whether they want text-to-speech (web only) and
# whether they want sound effects (web + GLK). Uses the same
# getyesorno blocking mechanism as 'restore?' in verbs.library --
# each question pauses execution until the player types yes/no, and
# the response that emits the next question (or finishes the intro)
# also carries the JS that flips the in-browser speech preference.
{+startup_preferences
if interpreter = CGI
   write "^Would you like the text read aloud?^"
   getyesorno voice_enabled
   if voice_enabled = true
      write "<script>enableSpeak();</script>"
   else
      write "<script>disableSpeak();</script>"
   endif
endif
write "^Would you like sound effects?^"
getyesorno sound_enabled
if interpreter = CGI
   if sound_enabled = true
      write "<script>enableSound();</script>"
   else
      write "<script>disableSound();</script>"
   endif
endif
write "^"
}

{+header
set linebreaks = false
print:
<!DOCTYPE html>
.
write "<html lang=~" game_language "~><head>"
print:
<link href="https://fonts.googleapis.com/css?family=Merriweather" rel="stylesheet" type="text/css">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
.
write "<title>" game_title "</title>"
execute "+styles"
print:
   <script>^

   function KeyPressed() {^
      if (document.getElementById('JACLCommandPrompt').value === '') {
         var main = document.getElementById('main');
         main.scrollTop = main.scrollHeight;
      }
   }^

   var jaclVoicesReady = !!(window.speechSynthesis && speechSynthesis.getVoices().length > 0);^
   var jaclVoicesPending = [];^

   function jaclVoicesFlush() {^
      if (jaclVoicesReady) return;^
      jaclVoicesReady = true;^
      var pending = jaclVoicesPending;^
      jaclVoicesPending = [];^
      for (var i = 0; i < pending.length; i++) {^
         try { pending[i](); } catch (e) {}^
      }^
   }^

   function jaclWhenVoicesReady(cb) {^
      if (!window.speechSynthesis) { cb(); return; }^
      if (jaclVoicesReady) { cb(); return; }^
      if (speechSynthesis.getVoices().length > 0) { jaclVoicesFlush(); cb(); return; }^
      jaclVoicesPending.push(cb);^
      setTimeout(jaclVoicesFlush, 1500);^
   }^

   function speakText(text) {^
      var doc = new DOMParser().parseFromString(text, 'text/html');^
      var html = doc.body.innerHTML;^
      html = html.replace(/<p\b.*?>/gi, '\n\n');^
      html = html.replace(/<br\s*\/?>/gi, '\n');^
      var temp = document.createElement('div');^
      temp.innerHTML = html;^
      var raw = temp.textContent || '';^
      var paragraphs = raw.split(/\n\s*\n/).map(function(p) {^
         return p.replace(/\s+/g, ' ').trim();^
      }).filter(function(p) { return p.length > 0; });^
      if (paragraphs.length === 0) return;^
      jaclWhenVoicesReady(function() {^
         var lang = document.documentElement.lang || 'en-US';^
         var voice = jaclPickedVoice();^
         function speakNext(i) {^
            if (i >= paragraphs.length) return;^
            var utterance = new SpeechSynthesisUtterance(paragraphs[i]);^
            utterance.lang = lang;^
            if (voice) utterance.voice = voice;^
            utterance.onend = function() {^
               if (i < paragraphs.length - 1 && isSpeakEnabled()) {^
                  setTimeout(function() { speakNext(i + 1); }, 500);^
               }^
            };^
            speechSynthesis.speak(utterance);^
         }^
         speakNext(0);^
      });^
   }^

   /* Per-game localStorage keys: prefix lookups with the game id so^
    * a 'yes' to voice/sound in one game doesn't silently apply to^
    * every other JACL game served from the same host. */^
   function jaclLSKey(name) {^
      return name + '_' + (window.jaclGameId || 'default');^
   }^

   function enableSpeak() {^
      localStorage.setItem(jaclLSKey('jaclSpeak'), 'true');^
   }^

   function disableSpeak() {^
      speechSynthesis.cancel();^
      localStorage.setItem(jaclLSKey('jaclSpeak'), 'false');^
   }^

   function isSpeakEnabled() {^
      return localStorage.getItem(jaclLSKey('jaclSpeak')) === 'true';^
   }^

   function enableSound() {^
      localStorage.setItem(jaclLSKey('jaclSound'), 'true');^
   }^

   function disableSound() {^
      localStorage.setItem(jaclLSKey('jaclSound'), 'false');^
      var maintext = document.getElementById('maintext');^
      if (!maintext) return;^
      maintext.querySelectorAll('audio').forEach(function(a) {^
         try { a.pause(); a.remove(); } catch (e) {}^
      });^
   }^

   function isSoundEnabled() {^
      return localStorage.getItem(jaclLSKey('jaclSound')) === 'true';^
   }^

   function jaclGetVoicesForLang() {^
      var lang = document.documentElement.lang || 'en-US';^
      var langPrefix = lang.split('-')[0];^
      return speechSynthesis.getVoices().filter(function(v) {^
         return v.lang === lang || v.lang === langPrefix || v.lang.indexOf(langPrefix + '-') === 0 || v.lang.indexOf(langPrefix + '_') === 0;^
      });^
   }^

   function jaclDefaultVoice(voices) {^
      var prefs = ['Google UK English Male', 'Google UK English Female', 'Google US English',^
                   'Samantha', 'Daniel', 'Karen', 'Moira', 'Tessa', 'Fiona', 'Serena',^
                   'Amelie', 'Thomas', 'Audrey',^
                   'Anna', 'Markus', 'Petra',^
                   'Google español', 'Paulina', 'Jorge', 'Monica', 'Diego',^
                   'Google Bahasa Indonesia', 'Damayanti'];^
      for (var i = 0; i < prefs.length; i++) {^
         for (var j = 0; j < voices.length; j++) {^
            if (voices[j].name.indexOf(prefs[i]) !== -1) return voices[j];^
         }^
      }^
      return voices[0] || null;^
   }^

   function jaclPickedVoice() {^
      var voices = jaclGetVoicesForLang();^
      var stored = localStorage.getItem('jaclVoiceName');^
      if (stored) {^
         for (var i = 0; i < voices.length; i++) {^
            if (voices[i].name === stored) return voices[i];^
         }^
      }^
      return jaclDefaultVoice(voices);^
   }^

   function jaclAppendMain(html) {^
      var out = document.getElementById('maintext');^
      if (out) out.insertAdjacentHTML('beforeend', html);^
   }^

   function jaclListVoices() {^
      jaclWhenVoicesReady(function() {^
         var voices = jaclGetVoicesForLang();^
         if (voices.length === 0) {^
            jaclAppendMain('<p>No voices available for this language yet. Try again in a moment.</p>');^
            return;^
         }^
         var stored = localStorage.getItem('jaclVoiceName');^
         var defaultVoice = jaclDefaultVoice(voices);^
         var html = '<p>Available voices (type <b>voice N</b> to choose):</p><ol>';^
         for (var i = 0; i < voices.length; i++) {^
            var marker = '';^
            if (stored && voices[i].name === stored) marker = ' &larr; selected';^
            else if (!stored && voices[i] === defaultVoice) marker = ' &larr; default';^
            html += '<li>' + voices[i].name + ' (' + voices[i].lang + ')' + marker + '</li>';^
         }^
         html += '</ol>';^
         jaclAppendMain(html);^
      });^
   }^

   function jaclPickVoice(n) {^
      var voices = jaclGetVoicesForLang();^
      var idx = n - 1;^
      if (idx < 0 || idx >= voices.length) {^
         jaclAppendMain('<p>No such voice. Type <b>voices</b> to list available voices.</p>');^
         return;^
      }^
      localStorage.setItem('jaclVoiceName', voices[idx].name);^
      jaclAppendMain('<p>Voice set to ' + voices[idx].name + '.</p>');^
   }^

   if (window.speechSynthesis && typeof speechSynthesis.onvoiceschanged !== 'undefined') {^
      speechSynthesis.onvoiceschanged = jaclVoicesFlush;^
   }^

   var jaclMapPopup = null;^

   function jaclEnsureMapPopup() {^
      if (jaclMapPopup && !jaclMapPopup.closed) return jaclMapPopup;^
      var sw = (window.screen && window.screen.availWidth) ? window.screen.availWidth : 1400;^
      var sh = (window.screen && window.screen.availHeight) ? window.screen.availHeight : 1000;^
      jaclMapPopup = window.open('', 'jacl_map', 'width=' + sw + ',height=' + sh + ',scrollbars=yes,resizable=yes');^
      if (!jaclMapPopup) return null;^
      var w = jaclMapPopup;^
      w.document.open();^
      w.document.write("<!doctype html><html lang='en'><head><meta charset='utf-8'><title>Map</title><style>html,body{margin:0;padding:0;background:" + (window.jaclMapBg || '#eee') + ";font-family:Georgia,Palatino,Times,serif;}#jacl_map{display:inline-block;}</style><script src='/include/raphael.min.js'><\/script></head><body><div id='jacl_map'></div></body></html>");^
      w.document.close();^
      return w;^
   }^

   function jaclDrawMapInPopup(canvasW, canvasH, drawFn) {^
      var popup = jaclEnsureMapPopup();^
      if (!popup) return;^
      var tries = 0;^
      var attempt = function() {^
         if (popup.closed) { jaclMapPopup = null; return; }^
         if (!popup.Raphael || !popup.document.getElementById('jacl_map')) {^
            if (++tries > 60) return;^
            setTimeout(attempt, 50);^
            return;^
         }^
         var container = popup.document.getElementById('jacl_map');^
         container.innerHTML = '';^
         var paper = popup.Raphael('jacl_map', canvasW, canvasH, null);^
         console.log('jacl map: requested canvas ' + canvasW + 'x' + canvasH);^
         try { drawFn(paper, popup); } catch (e) { console.warn('jacl map draw error', e); }^
      };^
      attempt();^
   }^

   function jaclCloseMapPopup() {^
      if (jaclMapPopup && !jaclMapPopup.closed) jaclMapPopup.close();^
      jaclMapPopup = null;^
   }^

   /* Speech synthesis is toggled by JACL responses that emit a script^
    * tag calling enableSpeak() or disableSpeak() -- see the 'voice' and^
    * 'unvoice' verbs in verbs.library, and the +startup_preferences^
    * function defined above. Sound effects are toggled at the JACL^
    * level via the built-in sound_enabled integer; the interpreter^
    * itself gates both GLK channels and CGI audio emission on it, so^
    * no JS-side suppression of audio elements is needed for the JACL^
    * sound path. */^

   /* Google Sign-In: optional. The engine emits^
    * window.JACL_GOOGLE_CLIENT_ID only when fcgijacl has both a^
    * client_id and a session_secret configured, so the button is^
    * only ever rendered on properly-set-up servers. */^
   /* JACL's preprocessor strips leading whitespace and JACL's loader^
    * treats a leading '.' as the print-block terminator, so Promise^
    * chains have to keep '.then'/'.catch' off column 0 -- written^
    * here as `var p = fetch(...); p = p.then(...);` rather than the^
    * usual fluent chain. Likewise multi-line object literals are^
    * inlined so no continuation line can start with '{' or '}'. */^
   function jaclGoogleCallback(response) {^
      var token = response && response.credential;^
      if (!token) return;^
      var body = 'auth=google&credential=' + encodeURIComponent(token);^
      var url = window.location.pathname + '?' + body;^
      var p = fetch(url, { credentials: 'same-origin' });^
      p = p.then(function(r) { return r.json(); });^
      p = p.then(function(j) { if (j && j.ok) window.location.reload(); });^
      p.catch(function() {});^
   }^

   function jaclLogout() {^
      var url = window.location.pathname + '?auth=logout';^
      var p = fetch(url, { credentials: 'same-origin' });^
      p = p.then(function() { window.location.reload(); });^
      p.catch(function() {});^
   }^

   function jaclRenderGoogleAuth() {^
      if (!window.JACL_GOOGLE_CLIENT_ID) return;^
      var slot = document.getElementById('jaclAuthSlot');^
      if (!slot) return;^
      if (window.JACL_GOOGLE_SIGNED_IN) {^
         slot.innerHTML = 'Signed in &middot; <a href="javascript:jaclLogout()">log out</a>';^
         return;^
      }^
      if (!window.google || !google.accounts || !google.accounts.id) {^
         setTimeout(jaclRenderGoogleAuth, 200);^
         return;^
      }^
      google.accounts.id.initialize({ client_id: window.JACL_GOOGLE_CLIENT_ID, callback: jaclGoogleCallback, auto_select: false });^
      slot.innerHTML = '<div id="jaclGoogleBtn"></div>';^
      var btn = document.getElementById('jaclGoogleBtn');^
      google.accounts.id.renderButton(btn, { theme: 'outline', size: 'small', type: 'standard' });^
   }^

   function changeInterface() {^
      document.JACLInterfaceForm.submit();
   }^

   /* Channel-aware audio processing.
    * The engine emits three kinds of marker:
    *   <audio data-jacl-channel="N" data-jacl-pending="1" [loop] ...>
    *     -- play on channel N; replaces any prior audio on the same
    *        channel; the pending flag tags this element as new in
    *        the most recent response so existing loops aren't disturbed.
    *   <jacl-sound-stop data-jacl-channel="N">     -- stop channel N.
    *   <jacl-sound-volume data-jacl-channel="N" data-jacl-level="V">
    *     -- set volume on channel N to V/100.
    *
    * Each marker, once acted on, is removed from the DOM. Audio elements
    * that have been processed (pending flag cleared) keep playing across
    * subsequent turns until something explicitly replaces or stops them.
    * Browsers that blocked the initial autoplay get a retry opportunity
    * here, since this runs in response to the user's command (a gesture). */
   var JACL_FADE_MS = 600;^

   function jaclFadeOut(audio, duration) {^
      if (audio.dataset.jaclFading === 'out') return;^
      audio.dataset.jaclFading = 'out';^
      var startVol = audio.volume;^
      var startTime = Date.now();^
      var iv = setInterval(function() {^
         var t = (Date.now() - startTime) / duration;^
         if (t >= 1) {^
            clearInterval(iv);^
            try { audio.pause(); } catch (e) {}^
            audio.remove();^
         } else {^
            audio.volume = startVol * (1 - t);^
         }^
      }, 30);^
   }^

   function jaclFadeIn(audio, target, duration) {^
      audio.dataset.jaclFading = 'in';^
      audio.volume = 0;^
      var p = audio.play();^
      if (p && typeof p.catch === 'function') p.catch(function() {});^
      var startTime = Date.now();^
      var iv = setInterval(function() {^
         if (audio.dataset.jaclFading !== 'in') { clearInterval(iv); return; }^
         var t = (Date.now() - startTime) / duration;^
         if (t >= 1) {^
            audio.volume = target;^
            delete audio.dataset.jaclFading;^
            clearInterval(iv);^
         } else {^
            audio.volume = target * t;^
         }^
      }, 30);^
   }^

   function jaclProcessAudioMarkers() {^
      var maintext = document.getElementById('maintext');^
      if (!maintext) return;^

      /* If the player has explicitly opted out of sound (set by^
       * +startup_preferences), pause and remove any audio that the^
       * game still emitted. The localStorage flag is the source of^
       * truth on web; GLK respects sound_enabled at JACL level. The^
       * unanswered case (key not yet set) intentionally falls through^
       * so audio plays normally before the player has been asked. */^
      if (localStorage.getItem(jaclLSKey('jaclSound')) === 'false') {^
         maintext.querySelectorAll('audio').forEach(function(a) {^
            try { a.pause(); a.remove(); } catch (e) {}^
         });^
         maintext.querySelectorAll('jacl-sound-stop, jacl-sound-volume').forEach(function(m) {^
            m.remove();^
         });^
         return;^
      }^

      maintext.querySelectorAll('jacl-sound-stop').forEach(function(marker) {^
         var ch = marker.getAttribute('data-jacl-channel');^
         maintext.querySelectorAll('audio[data-jacl-channel="' + ch + '"]').forEach(function(a) {^
            jaclFadeOut(a, JACL_FADE_MS);^
         });^
         marker.remove();^
      });^

      maintext.querySelectorAll('jacl-sound-volume').forEach(function(marker) {^
         var ch = marker.getAttribute('data-jacl-channel');^
         var level = parseInt(marker.getAttribute('data-jacl-level'), 10);^
         if (isNaN(level)) level = 100;^
         var v = Math.max(0, Math.min(1, level / 100));^
         maintext.querySelectorAll('audio[data-jacl-channel="' + ch + '"]').forEach(function(a) {^
            a.volume = v;^
         });^
         marker.remove();^
      });^

      maintext.querySelectorAll('audio[data-jacl-pending="1"]').forEach(function(audio) {^
         var ch = audio.getAttribute('data-jacl-channel');^
         var newSource = audio.querySelector('source');^
         var newSrc = newSource ? newSource.getAttribute('src') : '';^
         var existingSame = null;^
         var existing = maintext.querySelectorAll('audio[data-jacl-channel="' + ch + '"]:not([data-jacl-pending])');^
         existing.forEach(function(old) {^
            if (old.dataset.jaclFading === 'out') return;^
            var oldSource = old.querySelector('source');^
            if (oldSource && oldSource.getAttribute('src') === newSrc) existingSame = old;^
         });^
         if (existingSame && audio.hasAttribute('loop')) {^
            // Same looping source already playing on this channel --^
            // keep the old element so playback position is preserved^
            // and discard the freshly emitted duplicate.^
            audio.remove();^
            existing.forEach(function(old) {^
               if (old !== existingSame) {^
                  try { old.pause(); } catch (e) {}^
                  old.remove();^
               }^
            });^
            existingSame.removeAttribute('autoplay');^
            if (existingSame.paused && !existingSame.ended) {^
               var p = existingSame.play();^
               if (p && typeof p.catch === 'function') p.catch(function() {});^
            }^
         } else {^
            var target = audio.volume;^
            audio.removeAttribute('data-jacl-pending');^
            audio.removeAttribute('autoplay');^
            if (audio.hasAttribute('loop')) {^
               existing.forEach(function(old) { jaclFadeOut(old, JACL_FADE_MS); });^
               jaclFadeIn(audio, target, JACL_FADE_MS);^
            } else {^
               existing.forEach(function(old) {^
                  try { old.pause(); } catch (e) {}^
                  old.remove();^
               });^
               var p = audio.play();^
               if (p && typeof p.catch === 'function') p.catch(function() {});^
            }^
         }^
      });^

      maintext.querySelectorAll('audio[loop]:not([data-jacl-pending])').forEach(function(audio) {^
         audio.removeAttribute('autoplay');^
         if (audio.dataset.jaclFading) return;^
         if (audio.paused && !audio.ended) {^
            var p = audio.play();^
            if (p && typeof p.catch === 'function') p.catch(function() {});^
         }^
      });^

      maintext.querySelectorAll('audio:not([loop]):not([data-jacl-pending])[autoplay]').forEach(function(audio) {^
         audio.removeAttribute('autoplay');^
      });^
   }^

   document.addEventListener('DOMContentLoaded', function() {^
      jaclProcessAudioMarkers();^
   });^
.
#include "ajax.library"
print:
   function submitForm(e) {^
        e.preventDefault();^
        ajaxForm({^
             command: document.getElementById('JACLCommandPrompt').value,^
             replace: false,^
             element: "#maintext"^
        });^
        return false;^
   }^

   var focusInputTimer = null;^

   function focusInput(e) {^
        if (focusInputTimer) clearTimeout(focusInputTimer);^
        focusInputTimer = setTimeout(function() {^
             focusInputTimer = null;^
             if (window.getSelection().toString().length > 0) return;^
             var input = document.getElementById('JACLCommandPrompt');^
             if (input) input.focus();^
        }, 250);^
   }^

   function lookupWord(e) {^
        if (focusInputTimer) { clearTimeout(focusInputTimer); focusInputTimer = null; }^
        var sel = window.getSelection().toString().trim();^
        if (sel.length > 0 && sel.indexOf(' ') === -1) {^
           ajaxForm({^
                command: 'lookup ' + sel,^
                replace: false,^
                element: "#maintext"^
           });^
        }^
   }^

   var jaclRecog = null;^

   function jaclStopMic() {^
        var btn = document.getElementById('jaclMicButton');^
        if (btn) btn.classList.remove('listening');^
        if (jaclRecog) {^
             try { jaclRecog.abort(); } catch (e) {}^
             jaclRecog = null;^
        }^
   }^

   function startListening() {^
        var SR = window.SpeechRecognition || window.webkitSpeechRecognition;^
        if (!SR) return;^
        if (jaclRecog) { jaclStopMic(); return; }^
        var input = document.getElementById('JACLCommandPrompt');^
        var btn = document.getElementById('jaclMicButton');^
        jaclRecog = new SR();^
        jaclRecog.lang = window.jaclLang || 'en-US';^
        jaclRecog.interimResults = true;^
        jaclRecog.continuous = false;^
        jaclRecog.maxAlternatives = 1;^
        if (btn) btn.classList.add('listening');^
        jaclRecog.onresult = function(ev) {^
             var last = ev.results[ev.results.length - 1];^
             if (input) input.value = last[0].transcript.trim();^
             if (last.isFinal) {^
                  jaclStopMic();^
                  var form = document.JACLGameForm;^
                  if (form) {^
                       if (form.requestSubmit) form.requestSubmit();^
                       else form.dispatchEvent(new Event('submit', {cancelable: true}));^
                  }^
             }^
        };^
        jaclRecog.onerror = function() { jaclStopMic(); };^
        jaclRecog.onend = function() { jaclStopMic(); };^
        try { jaclRecog.start(); } catch (e) { jaclStopMic(); }^
   }^

   function jaclInitMic() {^
        var btn = document.getElementById('jaclMicButton');^
        if (!btn) return;^
        var SR = window.SpeechRecognition || window.webkitSpeechRecognition;^
        if (!SR) btn.style.display = 'none';^
   }^
.
write "</script>^"
write "<script>window.jaclLang = '" game_language "';</script>"
write "<script>window.jaclGameId = '" game_id "';</script>"
write "<script>window.jaclMapBg = '" maintext_colour "';</script>"
write "<link rel=~icon~ href=~/images/favicon.ico~ type=~image/x-icon~>"
ifstring google_client_id != ""
   write "<script>window.JACL_GOOGLE_CLIENT_ID = '" google_client_id "';</script>"
   write "<script>window.JACL_GOOGLE_SIGNED_IN = " google_signed_in ";</script>"
   write "<script src=~https://accounts.google.com/gsi/client~ async defer></script>"
endif
ifexecute "+local_header"
   # GAME MAY INJECT ADDITIONAL HEAD CONTENT (extra stylesheets, scripts).
endif
ifexecute "+library_header"
   # LIBRARIES (e.g. mapping.library) MAY INJECT THEIR OWN HEAD CONTENT
   # WITHOUT COLLIDING WITH THE GAME'S +local_header.
endif
write "</head>^"
write "<body onLoad=~document.getElementById('JACLCommandPrompt').focus(); jaclInitMic(); jaclRenderGoogleAuth();~>^"
write "<div id=~header~>"
ifstring title_image = "none"
  write "<h1 name=~title~>" game_title "</h1>"
else
  write "<img class=~titleimage~ alt=~" game_title "~ src=~" title_image "~>"
endif
write "<div class=~links~>
write " | "
hyperlink "Instructions" "instructions" "header"
write " | "
hyperlink "Map" "map window" "header"
write " | "
hyperlink "About" "about" "header"
write " | "
hyperlink "Restart" "restart" "header"
write " | "
hyperlink "Hint" "hint" "header"
ifstring google_client_id != ""
   write " | "
   write "<span id=~jaclAuthSlot~ style=~display:inline-block; vertical-align:middle;~></span>"
endif
write " |"
write "</div>^"
write "</div>^"
write "<div id=~main~>^"
write "<div id=~maintext~ class=~maintext~ onclick=~focusInput(event);~ ondblclick=~lookupWord(event);~>^"
set linebreaks = true
}

{+footer
set linebreaks = false
write "</div>"
write "</div>"
   ifstring current_image != "none"
      write "<div class=~picture~>"
      write "<img class=~main~ src=~" current_image "~>"
      write "</div>"
   endif
write "<div id=~footer~>^"
write "<div class=~directions~>"
execute "+exits"
write "</div>"
write "<form id=~commandForm~ name=~JACLGameForm~ method=~get~ autocomplete=~off~ onsubmit=~return submitForm(event);~>"
write "<div class=~command_prompt~>^"
write "<button id=~jaclMicButton~ type=~button~ class=~mic~ onclick=~startListening();~ title=~Click to speak a command. Pause when you are done and it will be submitted for you. Click again while recording to cancel.~ aria-label=~Speak a command~>&#127908;</button>"
prompt "KeyPressed();"
print:
   </div>
   </form></div>^
   </body></html>^
.
set linebreaks = true
}

# -------------------------------------------------------------------
# +library_eachturn -- called by verbs.library's +system_eachturn after
# every turn-consuming command. Emits the current exits list inside a
# <jacl-directions> marker element; the ajax response handler detects
# this marker and swaps its content into the footer's .directions bar
# so the directions stay fresh after movements, door opens, etc.
# -------------------------------------------------------------------

{+library_eachturn
# The <jacl-directions> marker only means anything to the web interpreter's
# ajax response handler; emitting it into a GLK/console transcript would
# leak raw HTML into the text window.
if interpreter <> CGI
   return
endif
set linebreaks = false
write "<jacl-directions style=~display:none~>"
execute "+exits"
write "</jacl-directions>"
set linebreaks = true
}

{+local_success
print:
      var maintext = document.getElementById("maintext");^
      maintext.querySelectorAll('script').forEach(function(el) { el.remove(); });^

      maintext.insertAdjacentHTML('beforeend', "<br><b>&gt;" + details.command + "</b><br>" + data);^

      var main = document.getElementById("main");^
      var textAdded = main.scrollHeight - main.scrollTop;
      var mainHeight = main.offsetHeight;
      if (textAdded > mainHeight) {
         main.scrollTop += mainHeight;
      } else {
         main.scrollTop = main.scrollHeight;^
      }
      document.JACLGameForm.command.value = "";^
      jaclProcessAudioMarkers();^
      var jaclscript = maintext.querySelector('script');^
      if (jaclscript != null) {^
         (new Function(jaclscript.text))();
      }^
      var jaclDirUpdate = maintext.querySelector('jacl-directions');^
      if (jaclDirUpdate) {^
         var dirBar = document.querySelector('.directions');^
         if (dirBar) dirBar.innerHTML = jaclDirUpdate.innerHTML;^
         jaclDirUpdate.remove();^
      }^
      if (isSpeakEnabled()) {^
         var speakData = data.replace(/<jacl-directions[\s\S]*?<\/jacl-directions>/gi, '');^
         speakText(speakData);^
      }^
      document.getElementById('JACLCommandPrompt').focus();
      return false;
.
}

{+display_chart_table
print:
     <script>
          var paper = Raphael("main", 2000, 2000, null);
.

select VISITED topic
   # LOOP THROUGH ALL THE LINKS TO OTHER TOPICS AND DRAW THE LINES
     set INDEX = 0
     repeat
      if topic(INDEX) != 0
         # GET THE COORDINATES OFFSETS FOR THE LINE DIRECTION
         set node_x = topic(x)
         set node_x * 100
         set node_x + 5
         set node_x + 30
         set node_y = topic(y)
         set node_y * 100
         set node_y + 5
         set node_y + 30

         write "paper.path(~M"
         write node_x " " node_y "L"

         set destination = topic(INDEX)

         set node_x = destination(x)
         set node_x * 100
         set node_x + 5
         set node_x + 30
         set node_y = destination(y)
         set node_y * 100
         set node_y + 5
         set node_y + 30

         write node_x " " node_y "~);^"
      endif
      set INDEX + 1
   until INDEX = 8
endselect

select VISITED topic
   set node_x = topic(x)
   set node_x * 100
   set node_x + 5
   set node_y = topic(y)
   set node_y * 100
   set node_y + 5
   write "var node = paper.rect(" node_x ", " node_y ", 60, 60, 10);^"
   if topic = here
      write "node.attr(~fill~, ~#BDD8D6~);^"
   else
      ifexecute "+child_of_here<topic"
         write "node.attr(~fill~, ~#ccc~);^"
      else
         write "node.attr(~fill~, ~#eee~);^"
      endif
   endif

   # ADD THE TOPIC'S LABEL TO THE CENTRE OF THE NODE
   set node_x + 30
   set node_y + 30
   write "var label = paper.text(" node_x ", " node_y ", ~"
   split array_count topic{The} " " label

   if array_count = 0
      write topic{The}
     else
      set INDEX = 0
      repeat
         write label[INDEX]
         write "\n"
         set INDEX + 1
      until INDEX = array_count
   endif
   write "~);^"

   # MAKE THE NODE'S LABEL A LINK
   write "label.attr(~href~, ~"
   write $url "?command=" topic{label} "&mode=1"
   if remote_user = false
         write "&user_id=" $user_id
   endif
   write "~);^"

   if topic has VIDEO
      set node_x + 25
      set node_y + 23
      write "paper.text(" node_x ", " node_y ", ~v~);^"
   endif
   if topic has PHOTO
      set node_x + 24
      set node_y + 22
      write "paper.text(" node_x ", " node_y ", ~p~);^"
   endif
endselect

#FIND THE CENTRE OF THE CURRENT NODE
set node_x = here(x)
set node_x * 100
set node_x + 35
set node_y = here(y)
set node_y * 100
set node_y + 35

#SCROLL THE DIV SO THE CURRENT NODE IS CENTRED
write "var halfDivWidth = document.getElementById(~main~).offsetWidth / 2;^"
write "var halfDivHeight = document.getElementById(~main~).offsetHeight / 2;^"
write "halfDivHeight = halfDivHeight - 100;^"
write "if (halfDivHeight < 0) halfDivHeight = 0;^"
write "document.getElementById(~main~).scrollLeft=" node_x " - halfDivWidth;^"
write "document.getElementById(~main~).scrollTop=" node_y " - halfDivHeight;^"

write "</script>"
}
