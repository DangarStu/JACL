# STANDARD HEADERS AND FOOTERS FOR WEB-BASED INTERACTIVE FICTION

string current_image "none"
constant title_image "none"
string game_language "en-US"
constant header_colour "#42596d"
constant linkbar_colour "#6a7a87"
constant maintext_colour "#eeeeee"
constant footer_image "none"

{+header
set linebreaks = false
print:
<!DOCTYPE html>
.
write "<html lang=~" game_language "~><head>"
print:
<link href="https://fonts.googleapis.com/css?family=Merriweather" rel="stylesheet" type="text/css">
<meta charset="UTF-8">
.
write "<title>" game_title "</title>"
execute "+styles"
print:
   <script>^

   function KeyPressed() {^
      if (document.getElementById('JACLCommandPrompt').value === '') {
         var main = document.getElementById('main');
         main.scrollTop = main.scrollHeight;
      }
   }^

   function speakText(text) {^
      var doc = new DOMParser().parseFromString(text, 'text/html');^
      var html = doc.body.innerHTML;^
      html = html.replace(/<p\b.*?>/gi, '\n\n');^
      html = html.replace(/<br\s*\/?>/gi, '\n');^
      var temp = document.createElement('div');^
      temp.innerHTML = html;^
      var raw = temp.textContent || '';^
      var paragraphs = raw.split(/\n\s*\n/).map(function(p) {^
         return p.replace(/\s+/g, ' ').trim();^
      }).filter(function(p) { return p.length > 0; });^
      if (paragraphs.length === 0) return;^
      var lang = document.documentElement.lang || 'en-US';^
      var voice = jaclPickedVoice();^
      function speakNext(i) {^
         if (i >= paragraphs.length) return;^
         var utterance = new SpeechSynthesisUtterance(paragraphs[i]);^
         utterance.lang = lang;^
         if (voice) utterance.voice = voice;^
         utterance.onend = function() {^
            if (i < paragraphs.length - 1 && isSpeakEnabled()) {^
               setTimeout(function() { speakNext(i + 1); }, 500);^
            }^
         };^
         speechSynthesis.speak(utterance);^
      }^
      speakNext(0);^
   }^

   function enableSpeak() {^
      localStorage.setItem('jaclSpeak', 'true');^
   }^

   function disableSpeak() {^
      speechSynthesis.cancel();^
      localStorage.setItem('jaclSpeak', 'false');^
   }^

   function isSpeakEnabled() {^
      return localStorage.getItem('jaclSpeak') === 'true';^
   }^

   function jaclGetVoicesForLang() {^
      var lang = document.documentElement.lang || 'en-US';^
      var langPrefix = lang.split('-')[0];^
      return speechSynthesis.getVoices().filter(function(v) {^
         return v.lang === lang || v.lang.indexOf(langPrefix + '-') === 0 || v.lang.indexOf(langPrefix + '_') === 0;^
      });^
   }^

   function jaclDefaultVoice(voices) {^
      var prefs = ['Google UK English Male', 'Google UK English Female', 'Google US English',^
                   'Samantha', 'Daniel', 'Karen', 'Moira', 'Tessa', 'Fiona', 'Serena',^
                   'Amelie', 'Thomas', 'Audrey',^
                   'Anna', 'Markus', 'Petra',^
                   'Google español', 'Paulina', 'Jorge', 'Monica', 'Diego',^
                   'Google Bahasa Indonesia', 'Damayanti'];^
      for (var i = 0; i < prefs.length; i++) {^
         for (var j = 0; j < voices.length; j++) {^
            if (voices[j].name.indexOf(prefs[i]) !== -1) return voices[j];^
         }^
      }^
      return voices[0] || null;^
   }^

   function jaclPickedVoice() {^
      var voices = jaclGetVoicesForLang();^
      var stored = localStorage.getItem('jaclVoiceName');^
      if (stored) {^
         for (var i = 0; i < voices.length; i++) {^
            if (voices[i].name === stored) return voices[i];^
         }^
      }^
      return jaclDefaultVoice(voices);^
   }^

   function jaclAppendMain(html) {^
      var out = document.getElementById('maintext');^
      if (out) out.insertAdjacentHTML('beforeend', html);^
   }^

   function jaclListVoices() {^
      var voices = jaclGetVoicesForLang();^
      if (voices.length === 0) {^
         jaclAppendMain('<p>No voices available for this language yet. Try again in a moment.</p>');^
         return;^
      }^
      var stored = localStorage.getItem('jaclVoiceName');^
      var defaultVoice = jaclDefaultVoice(voices);^
      var html = '<p>Available voices (type <b>voice N</b> to choose):</p><ol>';^
      for (var i = 0; i < voices.length; i++) {^
         var marker = '';^
         if (stored && voices[i].name === stored) marker = ' &larr; selected';^
         else if (!stored && voices[i] === defaultVoice) marker = ' &larr; default';^
         html += '<li>' + voices[i].name + ' (' + voices[i].lang + ')' + marker + '</li>';^
      }^
      html += '</ol>';^
      jaclAppendMain(html);^
   }^

   function jaclPickVoice(n) {^
      var voices = jaclGetVoicesForLang();^
      var idx = n - 1;^
      if (idx < 0 || idx >= voices.length) {^
         jaclAppendMain('<p>No such voice. Type <b>voices</b> to list available voices.</p>');^
         return;^
      }^
      localStorage.setItem('jaclVoiceName', voices[idx].name);^
      jaclAppendMain('<p>Voice set to ' + voices[idx].name + '.</p>');^
   }^

   if (window.speechSynthesis && typeof speechSynthesis.onvoiceschanged !== 'undefined') {^
      speechSynthesis.onvoiceschanged = function() { /* voices now loaded */ };^
   }^

   var jaclMapPopup = null;^

   function jaclEnsureMapPopup() {^
      if (jaclMapPopup && !jaclMapPopup.closed) return jaclMapPopup;^
      jaclMapPopup = window.open('', 'jacl_map', 'width=1000,height=900,scrollbars=yes,resizable=yes');^
      if (!jaclMapPopup) return null;^
      var w = jaclMapPopup;^
      w.document.open();^
      w.document.write("<!doctype html><html lang='en'><head><meta charset='utf-8'><title>Map</title><style>html,body{margin:0;padding:0;background:#eee;font-family:Georgia,Palatino,Times,serif;}#jacl_map{display:block;width:100vw;height:100vh;overflow:auto;}</style><script src='/include/raphael.min.js'><\/script></head><body><div id='jacl_map'></div></body></html>");^
      w.document.close();^
      return w;^
   }^

   function jaclDrawMapInPopup(canvasW, canvasH, drawFn) {^
      var popup = jaclEnsureMapPopup();^
      if (!popup) return;^
      var tries = 0;^
      var attempt = function() {^
         if (popup.closed) { jaclMapPopup = null; return; }^
         if (!popup.Raphael || !popup.document.getElementById('jacl_map')) {^
            if (++tries > 60) return;^
            setTimeout(attempt, 50);^
            return;^
         }^
         var container = popup.document.getElementById('jacl_map');^
         container.innerHTML = '';^
         var paper = popup.Raphael('jacl_map', canvasW, canvasH, null);^
         try { drawFn(paper, popup); } catch (e) { /* ignore draw errors */ }^
      };^
      attempt();^
   }^

   function jaclCloseMapPopup() {^
      if (jaclMapPopup && !jaclMapPopup.closed) jaclMapPopup.close();^
      jaclMapPopup = null;^
   }^

   function jaclAcceptVoice() {^
      enableSpeak();^
      var banner = document.getElementById('jaclVoiceOffer');^
      if (banner) banner.remove();^
      var main = document.getElementById('maintext');^
      if (main && main.textContent.trim().length > 0) speakText(main.innerHTML);^
   }^

   function jaclDeclineVoice() {^
      localStorage.setItem('jaclSpeak', 'false');^
      var banner = document.getElementById('jaclVoiceOffer');^
      if (banner) banner.remove();^
   }^

   function jaclOfferVoice() {^
      if (!window.speechSynthesis) return;^
      if (localStorage.getItem('jaclSpeak') !== null) return;^
      var main = document.getElementById('maintext');^
      if (!main) return;^
      var html = '<div id="jaclVoiceOffer" style="padding:0.5em 0.75em; margin:0 0 0.75em; border:1px solid #888; background:rgba(255,255,255,0.08);">' +^
                 'Would you like the text read aloud? ' +^
                 '<a href="javascript:jaclAcceptVoice()">Yes</a>' +^
                 ' &nbsp; ' +^
                 '<a href="javascript:jaclDeclineVoice()">No</a>' +^
                 '</div>';^
      main.insertAdjacentHTML('afterbegin', html);^
   }^

   function changeInterface() {^
      document.JACLInterfaceForm.submit();
   }^
.
#include "ajax.library"
print:
   function submitForm(e) {^
        e.preventDefault();^
        ajaxForm({^
             command: document.getElementById('JACLCommandPrompt').value,^
             replace: false,^
             element: "#maintext"^
        });^
        return false;^
   }^

   function lookupWord(e) {^
        var sel = window.getSelection().toString().trim();^
        if (sel.length > 0 && sel.indexOf(' ') === -1) {^
           ajaxForm({^
                command: 'lookup ' + sel,^
                replace: false,^
                element: "#maintext"^
           });^
        }^
   }^
.
write "</script>^"
write "<link rel=~icon~ href=~/images/favicon.ico~ type=~image/x-icon~>"
ifexecute "+local_header"
   # GAME MAY INJECT ADDITIONAL HEAD CONTENT (extra stylesheets, scripts).
endif
write "</head>^"
write "<body onLoad=~document.getElementById('JACLCommandPrompt').focus(); jaclOfferVoice();~>^"
write "<div id=~header~>"
ifstring title_image = "none"
  write "<h1 name=~title~>" game_title "</h1>"
else
  write "<img class=~titleimage~ alt=~" game_title "~ src=~" title_image "~>"
endif
write "<div class=~links~>
write " | "
hyperlink "Instructions" "instructions" "header"
write " | "
hyperlink "About" "about" "header"
write " | "
hyperlink "Restart" "restart" "header"
write " | "
hyperlink "Hint" "hint" "header"
write " |"
write "</div>^"
write "</div>^"
write "<div id=~main~>^"
write "<div id=~maintext~ class=~maintext~ ondblclick=~lookupWord(event);~>^"
set linebreaks = true
}

{+footer
set linebreaks = false
write "</div>"
write "</div>"
   ifstring current_image != "none"
      write "<div class=~picture~>"
      write "<img class=~main~ src=~" current_image "~>"
      write "</div>"
   endif
write "<div id=~footer~>^"
write "<div class=~directions~>"
execute "+exits"
write "</div>"
write "<form id=~commandForm~ name=~JACLGameForm~ method=~get~ autocomplete=~off~ onsubmit=~return submitForm(event);~>"
write "<div class=~command_prompt~>^"
prompt "KeyPressed();"
print:
   </div>
   </form></div>^
   </body></html>^
.
set linebreaks = true
}

{+local_success
print:
      var maintext = document.getElementById("maintext");^
      maintext.querySelectorAll('audio').forEach(function(el) { el.remove(); });^
      maintext.querySelectorAll('script').forEach(function(el) { el.remove(); });^

      maintext.innerHTML += "<br><b>&gt;" + details.command + "</b><br>"
    + data;^

      var main = document.getElementById("main");^
      var textAdded = main.scrollHeight - main.scrollTop;
      var mainHeight = main.offsetHeight;
      if (textAdded > mainHeight) {
         main.scrollTop += mainHeight;
      } else {
         main.scrollTop = main.scrollHeight;^
      }
      document.JACLGameForm.command.value = "";^
      var sound = maintext.querySelector('audio');^
      if (sound != null) {^
         sound.play();
      }^
      var jaclscript = maintext.querySelector('script');^
      if (jaclscript != null) {^
         (new Function(jaclscript.text))();
      }^
      if (isSpeakEnabled()) {^
         speakText(data);^
      }^
      document.getElementById('JACLCommandPrompt').focus();
      return false;
.
}

{+display_chart_table
print:
     <script>
          var paper = Raphael("main", 2000, 2000, null);
.

select VISITED topic
   # LOOP THROUGH ALL THE LINKS TO OTHER TOPICS AND DRAW THE LINES
     set INDEX = 0
     repeat
      if topic(INDEX) != 0
         # GET THE COORDINATES OFFSETS FOR THE LINE DIRECTION
         set node_x = topic(x)
         set node_x * 100
         set node_x + 5
         set node_x + 30
         set node_y = topic(y)
         set node_y * 100
         set node_y + 5
         set node_y + 30

         write "paper.path(~M"
         write node_x " " node_y "L"

         set destination = topic(INDEX)

         set node_x = destination(x)
         set node_x * 100
         set node_x + 5
         set node_x + 30
         set node_y = destination(y)
         set node_y * 100
         set node_y + 5
         set node_y + 30

         write node_x " " node_y "~);^"
      endif
      set INDEX + 1
   until INDEX = 8
endselect

select VISITED topic
   set node_x = topic(x)
   set node_x * 100
   set node_x + 5
   set node_y = topic(y)
   set node_y * 100
   set node_y + 5
   write "var node = paper.rect(" node_x ", " node_y ", 60, 60, 10);^"
   if topic = here
      write "node.attr(~fill~, ~#BDD8D6~);^"
   else
      ifexecute "+child_of_here<topic"
         write "node.attr(~fill~, ~#ccc~);^"
      else
         write "node.attr(~fill~, ~#eee~);^"
      endif
   endif

   # ADD THE TOPIC'S LABEL TO THE CENTRE OF THE NODE
   set node_x + 30
   set node_y + 30
   write "var label = paper.text(" node_x ", " node_y ", ~"
   split array_count topic{The} " " label

   if array_count = 0
      write topic{The}
     else
      set INDEX = 0
      repeat
         write label[INDEX]
         write "\n"
         set INDEX + 1
      until INDEX = array_count
   endif
   write "~);^"

   # MAKE THE NODE'S LABEL A LINK
   write "label.attr(~href~, ~"
   write $url "?command=" topic{label} "&mode=1"
   if remote_user = false
         write "&user_id=" $user_id
   endif
   write "~);^"

   if topic has VIDEO
      set node_x + 25
      set node_y + 23
      write "paper.text(" node_x ", " node_y ", ~v~);^"
   endif
   if topic has PHOTO
      set node_x + 24
      set node_y + 22
      write "paper.text(" node_x ", " node_y ", ~p~);^"
   endif
endselect

#FIND THE CENTRE OF THE CURRENT NODE
set node_x = here(x)
set node_x * 100
set node_x + 35
set node_y = here(y)
set node_y * 100
set node_y + 35

#SCROLL THE DIV SO THE CURRENT NODE IS CENTRED
write "var halfDivWidth = document.getElementById(~main~).offsetWidth / 2;^"
write "var halfDivHeight = document.getElementById(~main~).offsetHeight / 2;^"
write "halfDivHeight = halfDivHeight - 100;^"
write "if (halfDivHeight < 0) halfDivHeight = 0;^"
write "document.getElementById(~main~).scrollLeft=" node_x " - halfDivWidth;^"
write "document.getElementById(~main~).scrollTop=" node_y " - halfDivHeight;^"

write "</script>"
}
