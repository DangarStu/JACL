object patisserie : patisserie pâtisserie patisseries pâtisseries
 has           NO_TAB
 short         name "pâtisserie"
 mass          scenery

# -----------------------------------------------------------------------------
# PLAYER
# -----------------------------------------------------------------------------

object kryten : moi toi soi-même joueur
 has           ANIMATE
 short         name "vous"
 quantity      42
 parent        appartement
 player

object euros : euros argent monnaie
 short         name "euros"
 long          "Vous avez un peu d'argent dans votre poche.^"
 quantity      1500
 parent        kryten
 mass          1

{examine
write "Vous avez " euros(quantity) " centimes d'euro en poche.^"
}

object parapluie : parapluie
 short         un "parapluie"
 long          function
 has           CLOSABLE CLOSED WEARABLE
 parent        appartement
 mass          5

{long
if parapluie has CLOSED
   write "Un parapluie noir plié est posé ici.^"
else
   write "Un parapluie noir grand ouvert est posé ici.^"
endif
}

{examine
if parapluie has CLOSED
   write "Un simple parapluie noir, plié. Utile en cas de pluie. Ouvrez-le avec ~ouvrir parapluie~.^"
else
   write "Un parapluie noir grand ouvert. Prêt à vous protéger de la pluie.^"
endif
}

{open_override
ensure parapluie hasnt CLOSED
write "Vous ouvrez le parapluie.^"
}

{close_override
ensure parapluie has CLOSED
write "Vous fermez le parapluie.^"
}

object cle : cle clef cles clé clés
 short         une "clé"
 long          "Votre clé d'appartement est ici.^"
 parent        kryten
 mass          1

{examine
write "Une petite clé en laiton, celle de votre appartement.^"
}

# -----------------------------------------------------------------------------
# SCENERY WALLS (MOVED TO INDOOR LOCATIONS AS NEEDED)
# -----------------------------------------------------------------------------

object north_wall : nord mur
 has           NO_TAB
 short         le "mur nord"

object south_wall : sud mur
 has           NO_TAB
 short         le "mur sud"

object east_wall : est mur
 has           NO_TAB
 short         le "mur est"

object west_wall : ouest mur
 has           NO_TAB
 short         le "mur ouest"

object ground : sol plancher
 has           SURFACE NO_TAB
 short         le "sol"

# -----------------------------------------------------------------------------
# GLOBAL FUNCTIONS
# -----------------------------------------------------------------------------

integer speech_choice
integer meteo_etat 0

{+intro
style bold
write "^^" game_title
style normal
write " par " game_author "^^"

write "Voulez-vous que le jeu parle à voix haute ? (oui/non)^"
getyesorno speech_choice
if interpreter = GLK
   execute "+start_game"
endif
}

{+start_game
if speech_choice = true
   write "Synthèse vocale activée.^^"
   write "<script>enableSpeak();</script>"
else
   write "Synthèse vocale désactivée.^^"
   write "<script>disableSpeak();</script>"
endif

print:
   Le soleil du matin baigne les toits parisiens
   d'une lumière dorée. Les cloches d'une église
   sonnent au loin et l'odeur du pain frais monte
   de la rue. C'est une belle journée pour flâner
   dans le quartier et rendre visite à un ami.^^
.

if here hasnt OUTDOORS
   move north_wall to here
   move south_wall to here
   move east_wall to here
   move west_wall to here
endif

set ground(parent) = here
look
}

{+eachturn
if total_moves = 0
   execute "+start_game"
endif
execute "+avancer_meteo"
}

{+avancer_meteo
# 0=ensoleillé, 1=nuageux, 2=bruine, 3=pluie
if meteo_etat < 1
   if total_moves > 12
      set meteo_etat = 1
      write "^Des nuages commencent à s'accumuler. Le soleil se voile.^"
   endif
endif
if meteo_etat < 2
   if total_moves > 25
      set meteo_etat = 2
      write "^Une petite bruine commence à tomber. Le pavé se fait brillant.^"
   endif
endif
if meteo_etat < 3
   if total_moves > 37
      set meteo_etat = 3
      write "^La pluie tombe dru maintenant. Il faudrait sortir son parapluie.^"
   endif
endif
if meteo_etat > 1
   ifall here has OUTDOORS : parapluie hasnt WORN
      if meteo_etat = 2
         write "La bruine mouille vos vêtements.^"
      else
         write "Vous êtes trempé par la pluie !^"
      endif
   endif
endif
}

{+meteo_ligne
if meteo_etat = 0
   write "Le ciel est bleu et le soleil brille gentiment.^"
   return
endif
if meteo_etat = 1
   write "Le ciel se couvre de nuages. Un petit vent frais se lève.^"
   return
endif
if meteo_etat = 2
   write "Une bruine fine tombe. Le sol est glissant.^"
   return
endif
write "Une pluie battante fouette les pavés. Le tonnerre gronde au loin.^"
}

{+movement
ifall destination != nowhere : destination hasnt OUTDOORS
   move north_wall to destination
   move south_wall to destination
   move east_wall to destination
   move west_wall to destination
endif
return false
}

grammar a propos >about
grammar à propos >about

{+about
write "Une Journée à Paris est un jeu d'apprentissage du français. "
write "Promenez-vous dans le quartier, parlez avec les voisins, "
write "et apprenez du nouveau vocabulaire. Double-cliquez sur un mot "
write "pour le traduire, ou tapez ~dictionnaire <mot>~.^"
}

