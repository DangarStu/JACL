#!../bin/jacl
#ifid:JACL-200
# -----------------------------------------------------------------------------
# MISSION CONTROL -- starter template for a JACL space game
# -----------------------------------------------------------------------------
# Wires up:
#   * 10-line monospace status bar with telemetry laid out via cursor X Y
#   * Sci-fi (Orbitron) header font + a title-bar image
#   * The shared +game_intro scaffold (dedication / voice+sound / scene)
#   * One placeholder location (cockpit) and a couple of sample verbs
# -----------------------------------------------------------------------------

constant game_release     1
constant game_build       1
constant game_title       "Mission Control"
constant game_author      "Stuart Allen"
constant game_publish     false
constant ifid             "JACL-200"
string game_language      "en-US"

# Header / theme. The colour pair below is meant to read as a NASA-era
# control room: dark instrument panel, soft-amber accents.
constant title_image      "/images/missioncontrol-title.png"
constant header_colour    "#0c1626"
constant linkbar_colour   "#1a2a44"
constant maintext_colour  "#e8e0c8"
constant title_colour     "#ffb84a"

# Telemetry needs a wide grid -- 60 columns is enough for two-up
# label / value pairs without crowding.
integer status_window         10
integer status_window_width   60

# -----------------------------------------------------------------------------
# TELEMETRY STATE -- what the status bar shows. A real game would tick these
# from +eachturn / +timer; here they're just initial values so the layout is
# visible the moment the player lands in the cockpit.
# -----------------------------------------------------------------------------

integer hull_pct          100
integer fuel_pct          100
integer oxygen_pct         98
integer power_pct          87
integer altitude_m       4230
integer velocity_mms      120
integer mission_minutes     0

# -----------------------------------------------------------------------------
# THE WORLD -- a Mission Control auditorium in Houston. The player is a
# flight controller on console, not a pilot in space. The lander itself is
# 380,000 km away; everything here is telemetry, voice loops and decisions.
# -----------------------------------------------------------------------------

location flight_control : mission control room moc auditorium houston
 short         the "Mission Control Room"

object kryten : flight director controller self me
 short         name "yourself"
 has           ANIMATE
 parent        flight_control
 player

object console : flight console position desk
 short         the "FLIGHT console"
 static
 parent        flight_control

object headset : headset comms loop microphone
 short         the "comm loop headset"
 static
 parent        flight_control

object big_screen : screen big board front projection map
 short         the "big board"
 static
 parent        flight_control

object plot_table : plotting table chart trajectory
 short         the "plotting table"
 static
 parent        flight_control

object coffee_mug : mug coffee cup
 short         the "stained NASA coffee mug"
 parent        flight_control

# -----------------------------------------------------------------------------
# +intro / dedication / scene -- delegate to the shared helper.
# -----------------------------------------------------------------------------

{+intro
set player = kryten
execute "+game_intro"
}

{+game_dedication
clear
style header
write "^ MISSION CONTROL^"
style normal
style note
write "Module 1 -- the descent.^"
style normal
write "by " game_author ", build " game_release "/" game_build "^^"
print:
   You are FLIGHT for this mission -- the flight director on console
   in Building 30, Houston. A one-person lander is on final approach
   to the Sea of Tranquility, three hundred and eighty thousand
   kilometres away. Main guidance has just gone red, the radar
   altimeter is intermittent, and the descent profile is hot.^^
   Your astronaut is calm. Your team is not. The decisions are
   yours; the consequences are 1.3 light-seconds away.^^
.
}

{+game_scene
updatestatus
clear
style header
write "TRANQUILITY APPROACH^"
style normal
write "T+00:00:00^^"
print:
   The Mission Control room is dim and warm and crowded. Banks of
   monochrome monitors blink at the FIDO, EECOM, GUIDANCE and
   RETRO consoles around you. At the front of the room the big
   board shows a wireframe trajectory cutting across a grey lunar
   limb -- and, in the corner, a live numerical readout slewing
   too fast.^^
   Your headset crackles. A green LED on the FLIGHT console is
   waiting for your call. The lander begins its powered descent
   in seconds.^^
   Type ~look~ to take stock, ~examine board~ to read the trajectory,
   or speak into the loop when you are ready.^
.
}

# -----------------------------------------------------------------------------
# +update_status_window -- draws the 10-line telemetry panel using the same
# cursor X Y idiom on both Glk (real TextGrid) and web (virtual grid
# emulated by the engine + jaclWrapMapLabel-style monospace bar).
# -----------------------------------------------------------------------------

string status_text

{+update_status_window
# Row 0: title left, mission timer right.
cursor 1 0
write "MISSION CONTROL"
setstring status_text "T+" mission_minutes "m"
execute "+print_right<status_text<0"

# Row 1: separator.
cursor 0 1
execute "+print_repeat<-<60"

# Rows 2-5: bar gauges. Each call writes a label, the value as a
# right-padded percentage, and a fixed-width [#####...] bar.
set status_row = 2
setstring status_label "Hull"
set status_value = hull_pct
execute "+telem_bar"

set status_row = 3
setstring status_label "Fuel"
set status_value = fuel_pct
execute "+telem_bar"

set status_row = 4
setstring status_label "Oxygen"
set status_value = oxygen_pct
execute "+telem_bar"

set status_row = 5
setstring status_label "Power"
set status_value = power_pct
execute "+telem_bar"

# Row 6: separator.
cursor 0 6
execute "+print_repeat<-<60"

# Rows 7-9: scalar telemetry.
cursor 1 7
write "Altitude"
setstring status_text altitude_m " m"
execute "+print_right<status_text<7"

cursor 1 8
write "Velocity"
setstring status_text velocity_mms " mm/s"
execute "+print_right<status_text<8"

cursor 1 9
write "Fuel burn"
setstring status_text "STANDBY"
execute "+print_right<status_text<9"
}

# Helper: draw one row of "Label  [######....]   N%" at status_row.
integer status_row
integer status_value
string  status_label
integer telem_bar_filled
integer telem_bar_index

{+telem_bar
cursor 1 status_row
write status_label

# Bar is 20 cells. Compute filled cells from status_value (0..100).
set telem_bar_filled = status_value
set telem_bar_filled / 5

cursor 18 status_row
write "["
set telem_bar_index = 0
repeat
   if telem_bar_index < telem_bar_filled
      write "#"
   else
      write "."
   endif
   set telem_bar_index + 1
until telem_bar_index = 20
write "]"

setstring status_text status_value "%"
execute "+print_right<status_text<status_row"
}

# Helper: write one char N times at the cursor's current row, starting from
# column 0. Caller positions the cursor first via 'cursor 0 <row>'.
# string_arg[0] = char to repeat, arg[1] = count.
integer repeat_index

{+print_repeat
set repeat_index = 0
repeat
   write string_arg[0]
   set repeat_index + 1
until repeat_index = arg[1]
}

# -----------------------------------------------------------------------------
# Look text and examine handlers for each scenery object.
# -----------------------------------------------------------------------------

{look
print:
   Building 30, second floor. Eight rows of consoles step down toward
   the front wall, where the big board glows with a wireframe of the
   lunar approach trajectory. Your FLIGHT console is on the highest
   tier, central, with a clear sightline. The room smells of cold
   coffee and warm transistors.^
.
}

{examine console
print:
   Your FLIGHT console: a comms loop selector with a dozen labelled
   keys, two monochrome CRTs displaying mission elapsed time and
   crew biomedical, and a row of green-yellow-red alert LEDs across
   the top of the panel. The microphone arm waits to your right.^
.
}

{examine headset
print:
   A standard agency-issue headset, one earpiece, foam crumbling at
   the edges. It feeds the FLIGHT loop -- private to you and the
   astronaut -- and a parallel line into the public-affairs feed.^
.
}

{examine big_screen : examine board
print:
   The big board, projected on the front wall: a stylised cross-
   section of the descent corridor with the lander's icon creeping
   along the trajectory in real time. Numerical readouts on the
   right-hand strip update every second -- altitude, range-to-go,
   delta-V remaining.^
.
}

{examine plot_table
print:
   A circular plotting table behind the FLIGHT consoles, currently
   showing a top-down view of the landing zone. Boulder fields are
   shaded in red; the planned touchdown point sits dead-centre of
   a clear ellipse roughly four hundred metres across.^
.
}

{examine coffee_mug
print:
   White porcelain with a faded blue NASA meatball. Half-empty,
   well-stained, and roughly one descent burn old.^
.
}

# -----------------------------------------------------------------------------
# +local_header -- inject a Google Fonts <link> and a per-game CSS rule that
# uses Orbitron for the page title. webinterface.library calls this from
# inside <head> after its own styles, so the override wins.
# -----------------------------------------------------------------------------

{+local_header
print:
   <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&display=swap" rel="stylesheet">
   <style>
   /* Taller header so the lunar-lander title art has room to breathe.
      The image's own aspect ratio (~3:1) means height 120px gives it
      ~360px of width on the left side of the bar. The rest of the
      header keeps the linkbar visible across full width. */
   #header { height: 120px; }
   img.titleimage { height: 120px; width: auto; display: block; }
   div.links { top: 90px; }
   #statuswin { top: 120px; font-family: 'Courier New', ui-monospace, monospace; color: #ffb84a; }
   #statuswin:empty + #main { top: 120px; }
   #main { top: calc(120px + var(--status-lines) * 20px + 4px); }
   #header h1, #header h1 a { font-family: 'Orbitron', 'Courier New', monospace; letter-spacing: 0.08em; text-transform: uppercase; }
   div.maintext { font-family: 'Orbitron', Georgia, serif; font-weight: 500; }
   </style>
.
}

# -----------------------------------------------------------------------------
# Standard libraries. webinterface.library / .css drive the web build;
# verbs.library / utils.library provide the parser and helpers used above.
# -----------------------------------------------------------------------------

#include "webinterface.library"
#include "webinterface.css"
#include "verbs.library"
#include "utils.library"
