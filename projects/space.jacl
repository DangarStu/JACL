#!../bin/jacl
#ifid:JACL-200
# -----------------------------------------------------------------------------
# MISSION CONTROL -- starter template for a JACL space game
# -----------------------------------------------------------------------------
# Wires up:
#   * 10-line monospace status bar with telemetry laid out via cursor X Y
#   * Sci-fi (Orbitron) header font + a title-bar image
#   * The shared +game_intro scaffold (dedication / voice+sound / scene)
#   * One placeholder location (cockpit) and a couple of sample verbs
# -----------------------------------------------------------------------------

constant game_release     1
constant game_build       1
constant game_title       "Mission Control"
constant game_author      "Stuart Allen"
constant game_publish     true
constant ifid             "JACL-200"
string game_language     "en-US"

# Header / theme. The colour pair below is meant to read as a NASA-era
# control room: dark instrument panel, soft-amber accents.
constant title_image         "/images/missioncontrol-title.png"
constant header_colour       "#000000"
constant linkbar_colour      "#1a2a44"
constant maintext_colour     "#c8ccd0"
constant title_colour        "#ffb84a"

# Telemetry needs a wide grid -- 60 columns is enough for two-up
# label / value pairs without crowding.
integer status_window           8
integer status_window_width     106

# -----------------------------------------------------------------------------
# TELEMETRY STATE -- a single integer array that holds every value the
# status bar displays. Constants below name each slot so call sites stay
# readable, e.g. 'telemetry[TLM_FUEL]' instead of 'telemetry[5]'.
#
# Initial values are a snapshot of the lander a few seconds before powered
# descent: ~12.5 km altitude, ~1,440 m/s horizontal velocity, full tanks,
# nominal life support. A real mission would tick these from +eachturn and
# +timer.
# -----------------------------------------------------------------------------

constant TLM_MET             0 # mission elapsed time, seconds
constant TLM_ALTITUDE        1 # m above ground / lunar surface
constant TLM_HVEL            2 # horizontal velocity, m/s
constant TLM_VVEL            3 # vertical velocity, m/s (negative = descending)
constant TLM_RANGE           4 # downrange distance from pad / range to target, m
constant TLM_FUEL            5 # % fuel remaining
constant TLM_THROTTLE        6 # % main engine throttle
constant TLM_DELTAV          7 # delta-v remaining, m/s
constant TLM_OXYGEN          8 # % crew O2 reserve
constant TLM_POWER           9 # % battery / fuel-cell reserve
constant TLM_CABIN           10 # cabin pressure, kPa
constant TLM_SIGNAL          11 # % comm signal strength
constant TLM_PITCH           12 # vehicle pitch, degrees from vertical (90 = up)
constant TLM_GLOAD           13 # acceleration felt by crew, g (integer)
constant TLM_MACH            14 # vehicle speed in Mach (integer; zero in vacuum)
constant TLM_LOXPSI          15 # LOX tank ullage pressure, psi -- EECOM's leak gauge
constant TLM_MASS            16 # vehicle mass, tonnes (drops as propellant burns)
constant TLM_HR              17 # astronaut heart rate, bpm
constant TLM_AOA             18 # angle of attack, degrees (atmospheric flight)
constant TLM_BUSV            19 # main electrical bus voltage, V (28 nominal)
constant TLM_Q               20 # dynamic pressure, kPa (max-Q is the launch milestone)
constant TLM_STAGE           21 # current stage: 0=S-IC, 1=S-II, 2=S-IVB, 3=spacecraft
constant TLM_ENGINES_LIT     22 # number of main engines currently firing
constant TLM_COUNT           23 # number of slots

# Custom object-property slot. Every JACL object carries 16 integer
# slots (indices 0-15); the engine reserves a few for its own use
# (parent=0, quantity=1, mass=2, next=5, previous=6, child=7, x=14,
# y=15) and the rest can be reused with game-specific meanings, the
# same way grail.jacl reuses slot 5 as 'floor' on its lift object.
# We park 'keyed' on slot 12 (the otherwise-unused 'points' slot) to
# track which controller has keyed their mic.
constant keyed     12 # 1 = controller has keyed their mic

# -----------------------------------------------------------------------------
# MISSION PHASES -- each phase has its own bespoke status panel because the
# data the player needs to read at-a-glance changes radically between phases.
# +update_status_window dispatches to +update_status_<phase> based on
# current_phase. Add future phases by appending to both lists.
# -----------------------------------------------------------------------------

constant PHASE_ASCENT      1 # launch through MECO and orbital insertion
constant PHASE_COAST       2 # parking-orbit coast / TLI prep
constant PHASE_TRANSIT     3 # translunar coast
constant PHASE_DESCENT     4 # powered descent to lunar surface
constant PHASE_SURFACE     5 # surface operations
constant PHASE_RETURN      6 # ascent + TEI + transit + re-entry

integer current_phase

integer_array telemetry     TLM_COUNT

# -----------------------------------------------------------------------------
# ACT 1 STATE -- "FINAL COUNT"
#
# The opening scene is the launch. Vehicle (the BURROUGHS stack, fictitious,
# vintage-Apollo-class) is on the pad in Florida. MET starts at -60 (T-1:00)
# and counts up through zero to ignition. At MET = -30 (T-30s) FIDO calls
# wind shear at altitude and the GO/NO-GO opens. Decision window closes 24 s
# later at MET = -6 (T-6s) -- the launch sequencer locks itself out there.
#
# Same three mechanics as the descent draft they replace:
#   1. Live MET tick via +timer (3-second cadence)
#   2. Examine-as-polling for the four controllers, phase-aware
#   3. Real-clock countdown rendered into the status panel during the
#      decision window; commit / abort / hold (c / a / h) all valid verbs
# -----------------------------------------------------------------------------

integer alarm_fired
integer decision_made
integer timer_started
integer decision_deadline         # MET value at which the window closes
integer decision_seconds_left     # scratch for status-bar countdown
integer abs_met                   # scratch for T-MINUS rendering

# Tutorial nudges. Each flag is flipped the first time the player exercises
# the corresponding command, suppressing the next-step hint on subsequent
# uses. The intro graduates: scene -> look -> examine -> ask role -> poll.
integer hint_examine_shown      # has the player seen the 'try examine' hint?
integer hint_ask_role_shown     # has the player seen the 'try ask about role' hint?
integer hint_poll_shown         # has the player seen the 'try poll' hint?
# Note: a couple of other one-time hints elide the explicit "shown"
# integer in favour of the function's own call_count (via the @ token):
#   - The 'live on the FLIGHT loop' explanation in {press} on mic_arm
#     gates on @ < 4.
#   - The 'type answer' nudge in +hail gates on @ = 1.
integer smoke_test_fired        # TEMP: gate the inbound-comms smoke test in +intro

# Inbound-comms state. When a controller keys their mic, +hail records
# who's on the loop and what topic they want to discuss. 'answer' then
# proxies an 'ask <controller> about <topic>' command and clears the
# pointers. Both default to 0 when nobody is hailing.
integer hailing_controller
integer hailing_topic

# Player's mic state. 0 = boom mic is parked, the player is on listen-only;
# 1 = push-to-talk bar pressed, the player is transmitting on the FLIGHT
# loop. Gated by 'press arm' (toggle). ask/tell/commit/abort/hold all
# refuse to transmit when this is 0. 'answer' auto-keys for the duration
# of the response, since taking a call is itself the press-and-talk
# gesture.
integer mic_open

# -----------------------------------------------------------------------------
# THE WORLD -- a Mission Control auditorium in Houston. The player is a
# flight controller on console, not a pilot in space. The lander itself is
# 380,000 km away; everything here is telemetry, voice loops and decisions.
# -----------------------------------------------------------------------------

location flight_control : mission control room moc auditorium houston
 short         the "Mission Control Room"
 north         corridor
 out           corridor

object kryten : flight director controller self me
 short         name "yourself"
 has           ANIMATE
 parent        flight_control
 player

object console : flight console position desk
 short         the "FLIGHT console"
 static
 parent        flight_control

{examine
print:
   Your FLIGHT console: a comms loop selector with a dozen labelled
   keys, two monochrome CRTs displaying mission elapsed time and
   crew biomedical, and a row of green-yellow-red alert LEDs across
   the top of the panel. A boom microphone on a counterweighted arm
   waits at your right, swung out of the way until you key it.^
.
if mic_open = 1
   write "^Your own loop LED, above the selector, is lit green. You are transmitting.^"
endif
if hailing_controller != 0
   write "^On the selector, the "
   execute "+write_callsign"<hailing_controller
   write " loop LED is lit; "
   execute "+write_callsign"<hailing_controller
   write " is keyed in.^"
endif
}

# Console widgets -- scenery so the player can examine the nouns the
# console's flavour text introduces (LEDs, CRTs, the loop selector,
# the microphone arm). The LED strip is dynamic via +status_light;
# the others are prose with a small live telemetry peek on the CRTs.

object leds : leds led alert alerts strip row
 short         the "alert LED strip"
 static
 parent        flight_control

{examine
print:
   The console's alert LED strip -- the five top-of-panel indicators
   FLIGHT watches without looking down:^
.
execute "+status_light"<"FUEL"<telemetry[TLM_FUEL]<"%"<20<100<5<19
execute "+status_light"<"OXYGEN"<telemetry[TLM_OXYGEN]<"%"<50<100<20<49
execute "+status_light"<"POWER"<telemetry[TLM_POWER]<"%"<30<100<10<29
execute "+status_light"<"CABIN"<telemetry[TLM_CABIN]<" kPa"<95<105<80<115
execute "+status_light"<"SIGNAL"<telemetry[TLM_SIGNAL]<"%"<70<100<30<69
}

object crts : crt crts monitor monitors display displays cathode tube
 short         the "console CRTs"
 static
 parent        flight_control

{examine
print:
   Two small monochrome CRTs in the FLIGHT console. The left one
   cycles mission elapsed time; the right, astronaut biomedical:^
.
write "      MET: " telemetry[TLM_MET] " s^"
write "      Heart rate: " telemetry[TLM_HR] " bpm^"
}

object selector : selector loopselector keypad keys
 short         the "comms loop selector"
 static
 parent        flight_control

{examine
print:
   A dozen labelled keys in two rows: FLIGHT loop, CAPCOM, FIDO,
   EECOM, GUIDANCE, RETRO, BOOSTER, NETWORK, RECOVERY, INSTRUMENTATION,
   PUBLIC AFFAIRS, and a master TRANSMIT. Pressing one opens the
   corresponding loop in your headset. The FLIGHT key is lit.^
.

# Comms-active LEDs above each loop key. Lit = that controller has
# keyed their mic and is currently on the loop. The `keyed` slot on
# each controller is maintained by +hail / +answer_call.
write "^Comms LEDs:^"
if fido(keyed) = 1
   write "   FIDO loop: LIT^"
else
   write "   FIDO loop: dark^"
endif
if eecom(keyed) = 1
   write "   EECOM loop: LIT^"
else
   write "   EECOM loop: dark^"
endif
if guidance(keyed) = 1
   write "   GUIDANCE loop: LIT^"
else
   write "   GUIDANCE loop: dark^"
endif
if retro(keyed) = 1
   write "   RETRO loop: LIT^"
else
   write "   RETRO loop: dark^"
endif
}

object mic_arm : microphone mic boom arm bar push-to-talk ptt
 short         the "microphone arm"
 static
 parent        flight_control

{examine
print:
   A counterweighted swing-out boom carrying a small dynamic
   microphone, parked just clear of your face until you need it.
   A push-to-talk bar runs along the underside of the boom, right
   under your thumb -- press it to transmit on the FLIGHT loop;
   release it to fall back to listening.^
.
if mic_open = 1
   write "^The bar is depressed under your thumb right now -- your loop LED is lit.^"
else
   write "^The bar sits flush at the moment -- your mic is parked.^"
endif
}

# The push-to-talk bar IS the mic arm for parser purposes (synonyms
# include 'bar' and 'ptt'). 'press arm' / 'press bar' / 'press ptt'
# all route here. Toggle semantics rather than hold-to-talk so the
# player can issue a run of commands without re-keying each line.
{press
if mic_open = 1
   set mic_open = 0
   write "You lift your thumb off the bar. The boom microphone settles "
   write "back to its parked position; the loop LED goes dark.^"
else
   set mic_open = 1
   write "You press the push-to-talk bar with your thumb. The boom mic "
   write "swings in close; the loop LED above the comm-selector lights "
   write "up green. You are live on the FLIGHT loop.^"
   # Surface the plain-English explanation while the player is still
   # learning the gesture. @ is this function's call_count; in toggle
   # use it alternates open/close, so @ < 4 catches the first couple
   # of opens (after which the term should be familiar).
   if @ < 4
      print:
         ^(The FLIGHT loop is your private intercom to the four
         controllers in this room. While the LED is lit, anything you
         say with ~ask~, ~tell~, ~commit~, ~abort~ or ~hold~ goes out
         to all of them. ~press arm~ again to park the mic when you
         want to listen without transmitting.)^
      .
   endif
endif
}

object headset : headset comms loop earpiece
 short         the "comm loop headset"
 static
 parent        flight_control

{examine
print:
   A standard agency-issue headset, one earpiece, foam crumbling at
   the edges. It feeds the FLIGHT loop -- private to you and the
   astronaut -- and a parallel line into the public-affairs feed.^
.
}

{listen_to
print:
   You bring the earpiece tight against your ear. The FLIGHT loop
   hums with the slow, professional traffic of a count going well:
   FIDO confirming a range-tracking handoff, EECOM acknowledging a
   bus-voltage readback, GUIDANCE working through an inertial
   alignment number with the astronaut. Underneath the voices, the
   constant hush of an open carrier. The static has its own
   rhythm; you have learned to read it the way a sailor reads a
   sea.^
.
}

object big_screen : screen big board front projection map lights status panel panels indicators
 short         the "big board"
 static
 parent        flight_control

{examine
print:
   The big board, projected on the front wall: the BURROUGHS stack
   in pale wireframe on its pad. Numerical readouts on the right-hand
   strip update every second -- countdown clock, tank pressures,
   platform alignment, range-safety arming. The status-light cluster
   sits left of the wireframe:^
.
execute "+status_light"<"FUEL"<telemetry[TLM_FUEL]<"%"<20<100<5<19
execute "+status_light"<"OXYGEN"<telemetry[TLM_OXYGEN]<"%"<50<100<20<49
execute "+status_light"<"POWER"<telemetry[TLM_POWER]<"%"<30<100<10<29
execute "+status_light"<"CABIN"<telemetry[TLM_CABIN]<" kPa"<95<105<80<115
execute "+status_light"<"SIGNAL"<telemetry[TLM_SIGNAL]<"%"<70<100<30<69
execute "+status_light"<"LOX ULLAGE"<telemetry[TLM_LOXPSI]<" psi"<250<285<240<300
execute "+status_light"<"BUS VOLTAGE"<telemetry[TLM_BUSV]<" V"<26<30<24<32
execute "+status_light"<"ASTRO HR"<telemetry[TLM_HR]<" bpm"<50<110<40<140
}

object plot_table : plotting table chart trajectory
 short         the "plotting table"
 static
 parent        flight_control

{examine
print:
   A circular plotting table behind the FLIGHT consoles, currently
   showing the planned ascent: a clean parabola from the pad arcing
   out over the Atlantic, with insertion point sixty kilometres above
   the African coast. Wind-shear contours are sketched in red along
   the climb-out, between eight and twelve kilometres altitude.^
.
}

{read
print:
   You bend over the table and read off what's pencilled in the
   margins of the trace:^^
   * Pitch program: 5 degrees over at T+10s, hold to T+25s, then
     gravity-turn through max-Q.^
   * Max-Q at T+1:09, 14.2 km altitude, dynamic pressure 32.5 kPa
     (vehicle certified to 38).^
   * Staging events: S-IC at T+2:42, S-II at T+9:18, S-IVB cutoff
     at T+11:54.^
   * Insertion: 185 km circular, inclination 32.5 degrees, over the
     African coast.^^
   The red wind-shear band is the part that worries FIDO. It is the
   part that should worry you.^
.
}

object monitors : monitors banks workstations
 short         the "controller workstations"
 static
 parent        flight_control

{examine
print:
   Four banks of consoles arc around the room, one per discipline.
   Each is a slab of grey metal carrying half a dozen monochrome
   CRTs, a strip of toggle switches, a comms-loop selector matching
   yours, and a thick paper binder of mission rules. FIDO, EECOM,
   GUIDANCE and RETRO sit at theirs now, headsets on, faces lit pale
   green by the tubes.^
.
}

object coffee_mug : mug coffee cup
 short         the "stained NASA coffee mug"
 parent        flight_control

{examine
print:
   White porcelain with a faded blue NASA meatball. Half-empty,
   well-stained, and roughly one descent burn old.^
.
}

{drink
print:
   You take a swallow. It is cold, bitter and somehow simultaneously
   too weak and too strong. You put the mug back where it was. The
   thought of leaving the floor to fetch a fresh one is, right now,
   unthinkable.^
.
}

# -----------------------------------------------------------------------------
# CONVERSATION TOPICS -- abstract scenery objects the parser resolves so
# the player can 'ask <controller> about <topic>' and 'tell <controller>
# about <topic>'. They have no long description, so they don't show up
# in look output; they're just word anchors. Parented to flight_control
# because objects need a parent, and all conversation happens here anyway.
# -----------------------------------------------------------------------------

object wind : wind shear gust gusts weather forty knot knots
 short         the "wind shear"
 static
 parent        flight_control

object leak : leak lox ullage tank pressure manifold drop trend cryogenic
 short         the "LOX leak"
 static
 parent        flight_control

object steering : steering autopilot law trim margin angle attack pitch aoa
 short         the "steering law"
 static
 parent        flight_control

object tower : tower escape rescue lift jett jettison canopy abort-mode
 short         the "launch escape tower"
 static
 parent        flight_control

object role : role roles job jobs duty duties position positions title titles
 short         the "controller roles"
 static
 parent        flight_control

# Topic anchors for the scene's other narrative threads and the LED
# labels. Word stubs so 'ask <controller> about <topic>' resolves;
# no long description, so they stay out of look output.

object range : range downrange tracking
 short         the "range tracking"
 static
 parent        flight_control

object biomedical : biomedical biomed biomeds vitals
 short         the "crew biomedical"
 static
 parent        flight_control

object consumables : consumables consumable supplies
 short         the "consumables"
 static
 parent        flight_control

object recovery : recovery footprint splashdown
 short         the "recovery footprint"
 static
 parent        flight_control

object math : math maths mathematics
 short         the "ascent maths"
 static
 parent        flight_control

object fuel : fuel propellant kerosene rp1
 short         the "fuel reserve"
 static
 parent        flight_control

object oxygen : oxygen o2 ox
 short         the "crew oxygen"
 static
 parent        flight_control

object power : power battery batteries fuelcell fuel-cell
 short         the "main power"
 static
 parent        flight_control

object cabin : cabin capsule cab cabin-pressure
 short         the "cabin pressure"
 static
 parent        flight_control

object signal : signal comms-signal telemetry-link
 short         the "comm signal"
 static
 parent        flight_control

object bus : bus busbar voltage
 short         the "main bus"
 static
 parent        flight_control

object hr : hr heart heartrate pulse
 short         the "astronaut heart rate"
 static
 parent        flight_control

object maxq : maxq max-q dynamic
 short         the "max-Q milestone"
 static
 parent        flight_control

object balloon : balloon balloons meteo-balloon weather-balloon
 short         the "weather balloon"
 static
 parent        flight_control

object pad : pad launchpad launch-pad
 short         the "launch pad"
 static
 parent        flight_control

# Controllers around the room. Each is ANIMATE so 'examine X' produces a
# live read rather than the static-scenery default. The bare {examine}
# block immediately after each object def is what the JACL loader binds
# to that object's label -- placement matters. The {ask_about_<topic>}
# and {tell_about_<topic>} blocks bind the same way -- one block per
# (controller, topic, verb) combination.

object fido : fido fdo dynamics officer woman
 short         name "the FIDO controller"
 has           ANIMATE
 keyed         0
 parent        flight_control

{examine
set hint_examine_shown = true
if self(keyed) = 1
   write "(FIDO's loop LED is lit -- she's keyed her mic.)^^"
endif
if alarm_fired = false
   print:
      FIDO, fast and bright on the loop: "Flight, FIDO. Range tracking
      nominal, ascent profile loaded, predicted insertion point clean.
      Weather balloon's still climbing -- we'll have wind data at
      altitude in about a minute."^
   .
   if hint_ask_role_shown = false
      print:
         Try ~ask fido about role~ for a fuller picture of what FIDO
         actually does. The same form works on any controller, and
         other topics include ~wind~, ~leak~, ~steering~ and ~tower~.^
      .
   endif
else
   print:
      FIDO, sharper now: "FIDO, Flight. The wind data is in and it is
      not ambiguous. Forty-six knot gust at ten kilometres, lateral
      against our trajectory. Twelve percent over the load envelope at
      max-Q. I am still on HOLD. Recycle the count and wait the gust
      pattern out."^^
      He does not tell you what HOLD costs in fuel-boil-off, crew
      bladder, or political capital. That isn't on his console.^
   .
endif
}

{ask_about_role
set hint_ask_role_shown = true
print:
   FIDO: "Flight Dynamics Officer, Flight. The 'F-D-O' on the
   acronym schedule. My console watches the vehicle's trajectory
   in real time -- ground tracking radars on the pad, weather
   balloons up to ten kilometres, and once she's flying, the
   instantaneous predicted impact point in case anything has to
   come down before insertion. If the vehicle stops being where
   the trajectory says it should be, I'm the one who notices
   first."^^
   "Today, with the stack still on the pad, I'm mostly reading
   weather. Wind is the only piece of trajectory data that's
   moving."^
.
if hint_poll_shown = false
   set hint_poll_shown = true
   print:
      When you've heard from as many of the controllers as you want,
      type ~poll~ to start the GO/NO-GO round-robin. The clock begins
      ticking the moment the poll completes.^
   .
endif
}

{tell_about_role
print:
   FIDO: "Same job, Flight. The console hasn't moved."^
.
}

{ask_about_wind
if alarm_fired = false
   print:
      FIDO: "Weather balloon at six thousand metres, climbing well. We
      should have a clean read on ten-K winds inside the minute. The
      forecast was calm; the surface tower is reading three knots.
      Nothing to worry about, Flight."^
   .
else
   print:
      FIDO, half-turning to you across the row of consoles: "Forty-six
      knots lateral at ten kilometres, on profile. That's twelve
      percent over the static load envelope through max-Q. The vehicle
      was certified to thirty-eight; we are betting on eight percent
      of margin and wishful thinking. I want to recycle, get a fresh
      balloon, see if the gust front clears in twenty minutes."^
   .
endif
}

{ask_about_leak
print:
   FIDO: "That's EECOM's console, Flight. I see what tank one's
   ullage was when we filed the trajectory; if that's changed,
   he's the one watching it." A pause. "If it's real and we
   hold, the leak gets worse. If it's real and we go, we burn
   the bad propellant in the first stage anyway. Either way, the
   wind stays my problem."^
.
}

{ask_about_steering
print:
   FIDO: "Steering law is GUIDANCE's. I just confirm where the
   computer THINKS the vehicle is going matches what my radars say
   it actually is. Right now, on the pad, those agree." Slight
   smile. "Once she's flying, GUIDANCE and I are usually in
   agreement until we aren't, and then one of us is wrong."^
.
}

{ask_about_tower
print:
   FIDO: "The tower's RETRO's call. From my console: the abort
   trajectory is in my flight plan, the recovery footprint is
   inside the predicted impact ellipse, and if we have to fire
   it during max-Q the splashdown's in two-thousand-metre water
   inside the carrier perimeter. It works on paper. I have never
   personally seen it work in practice."^
.
}

{ask_about_maxq
print:
   FIDO: "Max-Q at T+1:09, fourteen kilometres altitude, predicted
   dynamic pressure thirty-two-and-a-half kilopascals. Vehicle's
   certified to thirty-eight, so we have margin on paper. Trouble
   is, anything sideways at max-Q gets multiplied by Q. A forty-six
   knot lateral gust at that altitude isn't just a forty-six knot
   gust -- it's a forty-six knot gust pressed into the airframe by
   a wall of air. That's why we're talking about it."^
.
}

{ask_about_balloon
print:
   FIDO, bright: "Weather balloon at six and a half thousand metres,
   climbing well. She'll be at ten kilometres in about ninety
   seconds, which is where the gust front is forecast. The balloon
   reads pressure, temperature and wind by Doppler, transmits down
   on a VHF carrier I've had a clean signal on since release. Old
   tech. The kind that works."^
.
}

{ask_about_pad
print:
   FIDO: "On the pad: range-safety transponder lit, telemetry
   handshake clean, surface tower reading three knots from the
   south-east. Once she's flying, the pad becomes a fixed point on
   my plot -- everything is referenced to it. Until then, it's just
   a very expensive concrete pier with seven thousand tonnes of
   cryogenics sitting on it."^
.
}

{tell_about_wind
print:
   FIDO: "Roger, Flight. I have the wind."^
.
}

{tell_about_leak
if alarm_fired = false
   print:
      FIDO, his bright voice flattening half a step: "EECOM said
      that? Out loud?" He glances down the row. "If he's seeing a
      trend, that changes the holding-cost equation. I had the count
      as recyclable; with a leak in tank one, it isn't, not without
      risk. That's not in my recommendation yet -- but it's an input
      I'll be weighing if you ask me to call the GO/NO-GO."^
   .
else
   print:
      FIDO, fast as a card snapping over: "If EECOM has a leak, my
      HOLD recommendation gets harder to defend. Holding makes the
      leak worse; the wind we go through anyway. I'd revise. I
      would still want the wind data clean, but Flight, I think
      you're closer to a COMMIT than my last word on the loop."^
   .
endif
}

{tell_about_steering
print:
   FIDO: "GUIDANCE's optimism on the steering law isn't proof of
   structural margin. The autopilot can fly any profile the maths
   permits -- the question is whether the airframe can take it.
   I would not let GUIDANCE's confidence change my call."^
.
}

{tell_about_tower
print:
   FIDO: "Good. Knowing the abort works is the only thing that
   makes pushing into a marginal sky reasonable."^
.
}

object eecom : eecom electrical environmental life support engineer
 short         name "the EECOM controller"
 has           ANIMATE
 keyed         0
 parent        flight_control

{examine
set hint_examine_shown = true
if self(keyed) = 1
   write "(EECOM's loop LED is lit -- he's keyed his mic.)^^"
endif
if alarm_fired = false
   print:
      EECOM, slow and unbothered: "Flight, EECOM. All buses on internal,
      draws nominal. Tank one ullage two-six-eight psi, tank two two-six-
      nine. Crew O2 one hundred, suit loop closed. Everything I can
      measure is doing what it ought to be."^
   .
   if hint_ask_role_shown = false
      print:
         Try ~ask eecom about role~ for a fuller picture of what EECOM
         actually does. The same form works on any controller, and
         other topics include ~wind~, ~leak~, ~steering~ and ~tower~.^
      .
   endif
else
   print:
      EECOM, same slow voice -- the only person in the room not lifting
      his pulse: "Flight, EECOM. I am not in this argument; the wind is
      not a consumables problem and the steering law is not my console.
      But for what it is worth, I have been watching tank one ullage
      pressure for the last ninety seconds. It is dropping two psi a
      minute. That is small. It is not zero. I do not know if that is
      gauge drift or a slow leak in the LOX manifold. I do know that
      if you HOLD the count, that trend gets worse, not better.
      Whatever you call, Flight, you are calling against a clock I
      cannot stop."^
   .
endif
}

{ask_about_role
set hint_ask_role_shown = true
print:
   EECOM: "Electrical, Environmental and Consumables, Flight. Three
   words and a lot of dials. Electrical means the spacecraft's power
   buses and the fuel cells that feed them. Environmental means
   cabin pressure, suit-loop oxygen, temperature and humidity --
   what makes the cabin a place a human being can live. Consumables
   means how much oxygen, water, hydrogen, lithium hydroxide and
   propellant we've got in our four tanks and how fast we're using
   them up."^^
   "On a launch like today's, I also watch tank ullage pressures on
   the LOX side -- the propellant's a consumable too. If something
   leaks, I'm the one who sees it before anyone else does."^
.
if hint_poll_shown = false
   set hint_poll_shown = true
   print:
      When you've heard from as many of the controllers as you want,
      type ~poll~ to start the GO/NO-GO round-robin. The clock begins
      ticking the moment the poll completes.^
   .
endif
}

{tell_about_role
print:
   EECOM: "Same console as the last time you asked, Flight."^
.
}

{ask_about_wind
print:
   EECOM, slow: "Wind is not on my console, Flight. I have a strain-
   gauge feed off the airframe in case the gusts pick up while she's
   on the pad, and that's reading nominal -- but I would not weigh
   that against what FIDO sees from the meteo balloon. He has the
   data; I have a single piezo cell."^
.
}

{ask_about_leak
if alarm_fired = false
   print:
      EECOM: "Tank one ullage two-six-eight psi, tank two two-six-nine.
      Both tanks are settling normally. We are well within manifold
      spec." A beat. "Pad-to-vehicle umbilicals are nominal, propellant
      chillers are running. I have nothing flagged."^
   .
else
   print:
      EECOM, voice very level, the way he gets when he is actually
      worried: "Tank one ullage was two-six-eight when we capped
      pre-flight. It is now two-six-six and dropping by about two
      psi a minute. The trend is shallow but it is monotonic. That
      could be temperature redistribution as the LOX settles. It
      could also be a one-millimetre crack on the manifold flange
      bleeding boil-off into the inter-tank. I cannot tell from here.
      What I CAN tell you, Flight, is that if you hold the count, in
      forty minutes I will be telling you we have to scrub anyway,
      because by then the trend will be unambiguous."^
   .
endif
}

{ask_about_steering
print:
   EECOM: "GUIDANCE's department, Flight. I keep the computer's bus
   voltage stable -- the steering law itself I trust because it has
   been flown in the simulator, but I would not pretend to evaluate
   it. If you want to know whether the autopilot can fly through a
   forty-six-knot gust, ask the man whose job that is. If you want
   to know whether the AIRFRAME can take it, ask FIDO -- it's his
   load envelope."^
.
}

{ask_about_tower
print:
   EECOM: "Power for the escape tower is on the standby bus, fully
   armed. Pyrotechnic interlocks green. If RETRO calls for it, it
   fires within two hundred milliseconds." A small shrug. "From my
   console, the abort tower is the most reliable system on this
   vehicle. It has fewer parts."^
.
}

{ask_about_maxq
print:
   EECOM: "Not my console, Flight. But between T+1:00 and T+1:30
   every joint on this vehicle takes its hardest punch -- so if
   anything's going to chatter, it chatters then. I'll be watching
   the tank pressures for sympathetic vibration that says something
   is loose. I have not had to call that one in eight years. The
   streak is not very comforting if I'm wrong."^
.
}

{ask_about_balloon
print:
   EECOM, dry: "FIDO's balloon. I read his number same as you do.
   I keep a strain gauge on the airframe in case the surface wind
   picks up while she's still on the pad -- that's the only piece
   of meteorology my console touches. He has the instrument; I
   have a single piezo cell and a healthy respect for the man's
   instinct."^
.
}

{ask_about_pad
print:
   EECOM: "Pad-to-vehicle umbilicals: power, ground LOX top-off,
   helium pressurisation, comm. All nominal. The umbilicals
   retract at T-8 seconds; from that moment she's on internal
   power for everything I can read. After T-8, my console either
   sees what it sees or doesn't, and there is nothing the pad
   crew can do about it."^
.
}

{tell_about_wind
print:
   EECOM: "Acknowledged, Flight. I'll watch the strain gauges; if
   the pad starts oscillating I'll call it on the loop."^
.
}

{tell_about_leak
print:
   EECOM, dryly: "Yes, Flight. I am the one who told you."^
.
}

{tell_about_steering
print:
   EECOM: "Noted, Flight. Bus voltage will hold whatever the
   computer demands inside its rated draw."^
.
}

{tell_about_tower
print:
   EECOM: "Roger, Flight. Standby bus is good for tower."^
.
}

object guidance : guidance gnc nav navigation computer man
 short         name "the GUIDANCE controller"
 has           ANIMATE
 keyed         0
 parent        flight_control

{examine
set hint_examine_shown = true
if self(keyed) = 1
   write "(GUIDANCE's loop LED is lit -- he's keyed his mic.)^^"
endif
if alarm_fired = false
   print:
      GUIDANCE, technical and a little formal: "Flight, GUIDANCE. Inertial
      platform aligned, drift inside spec. Computer is running pre-flight
      sequence on schedule."^
   .
   if hint_ask_role_shown = false
      print:
         Try ~ask guidance about role~ for a fuller picture of what
         GUIDANCE actually does. The same form works on any controller,
         and other topics include ~wind~, ~leak~, ~steering~ and ~tower~.^
      .
   endif
else
   print:
      GUIDANCE, formal and a touch too certain: "Flight, GUIDANCE. The
      ascent steering law has explicit wind-shear margin. The autopilot
      pitches into the gust, trims angle of attack, the vehicle adapts.
      I have flown this in the simulator. Recommend COMMIT."^^
      He does not, you notice, mention the structural load envelope --
      the question of how much sideways FIDO's vehicle can actually take
      before something parts. The aero engineers live three buildings
      over. He is reading from his own console.^
   .
endif
}

{ask_about_role
set hint_ask_role_shown = true
print:
   GUIDANCE: "Guidance, Navigation and Control, Flight. 'G-N-C' if
   we're being formal. My console watches the on-board computer --
   a Burroughs B1422 with sixty-four kilobytes of magnetic-core
   memory -- and the inertial platform: a set of three gyroscopes
   and three accelerometers spinning in a sealed, gimballed sphere
   that tells the vehicle which way is up and how fast it's
   moving. Together, those two systems run the steering law: the
   maths that tells the engines how to point so the vehicle flies
   the planned profile."^^
   "Easy enough on paper. The interesting question is always
   whether the vehicle the maths is telling to do something can
   actually do that thing."^
.
if hint_poll_shown = false
   set hint_poll_shown = true
   print:
      When you've heard from as many of the controllers as you want,
      type ~poll~ to start the GO/NO-GO round-robin. The clock begins
      ticking the moment the poll completes.^
   .
endif
}

{tell_about_role
print:
   GUIDANCE: "Yes, Flight. Same as the schedule says."^
.
}

{ask_about_wind
if alarm_fired = false
   print:
      GUIDANCE: "Pre-flight steering profile loaded with the standard
      ten-K wind correction. The autopilot will read the wind from the
      on-board accelerometers and trim angle of attack in real time.
      Whatever FIDO's balloons see, the vehicle will adapt to."^
   .
else
   print:
      GUIDANCE, somewhere between technical and proud: "The steering
      law was designed for exactly this. Forty-six knots is inside the
      law's modelled envelope -- the autopilot pitches into it, trims
      AoA to keep the load vector along the longitudinal axis, and we
      ride through. I have run this case in the sim more times than
      I can count, Flight. Recommend COMMIT."^^
      He hasn't mentioned what happens to the airframe under the
      trimmed load. He is, after all, reading from his own console.^
   .
endif
}

{ask_about_leak
if alarm_fired = false
   print:
      GUIDANCE: "Not on my boards. Computer doesn't see propellant tank
      pressures directly -- the SCE feeds tank ullage into the steering
      law as a mass estimate, and right now the estimate is nominal
      for fully-fuelled. If EECOM has a different number, I don't see
      it from here."^
   .
else
   print:
      GUIDANCE, frowning slightly: "If the fuelled mass is changing
      under me, the steering law's centre-of-mass calculation is wrong.
      That doesn't change my recommendation -- the autopilot adapts in
      flight -- but I would want EECOM's number on the loop before
      first-stage shutdown. A leak at this rate isn't a flight-critical
      issue. It might be a launch-critical one."^^
      He says this without conceding any ground on COMMIT.^
   .
endif
}

{ask_about_steering
print:
   GUIDANCE, with quiet enthusiasm: "The steering law is a
   six-degree-of-freedom model with explicit wind-shear margin,
   structural-mode notches, and centre-of-mass tracking off the
   flight-tank pressure feeds. The autopilot reads vehicle attitude
   off the inertial platform thirty times a second and trims pitch,
   yaw and roll to keep the load vector along the longitudinal axis.
   It can fly any profile the maths allows."^^
   That last sentence is doing a lot of work. The maths assumes the
   structure can take what the maths commands.^
.
}

{ask_about_tower
print:
   GUIDANCE: "Tower's RETRO's. The computer hands off to the escape
   tower's solid-fuel motor automatically if the abort sense line
   trips -- attitude excursion, structural vibration over threshold,
   or RETRO's manual command. From the computer's point of view, the
   tower is a different machine; I just stop talking to the vehicle
   and let it fly."^
.
}

{ask_about_maxq
print:
   GUIDANCE, quietly enthusiastic: "Max-Q is the moment the steering
   law works hardest. The autopilot trims angle of attack down to
   near zero through the peak so the load vector stays along the
   longitudinal axis -- the airframe takes compression, not bending.
   The whole pitch program is built around max-Q. If the trajectory's
   right at T+1:09, the rest of the flight is, in essence, a
   coast."^
.
}

{ask_about_balloon
print:
   GUIDANCE: "FIDO's balloon feeds my pre-flight wind correction.
   The pitch program is biased a fraction of a degree to compensate
   for the ten-K winds we've measured on the ground. Once she's
   flying, the on-board accelerometers take over; the autopilot
   trims AoA in real time. The balloon is the ground-truth call we
   make before the autopilot has anything else to use."^
.
}

{ask_about_pad
print:
   GUIDANCE: "Inertial platform aligns on the pad, Flight. The
   gyros spin up two hours before launch; the alignment sequence
   runs against a brass survey marker cast into the concrete of
   the pad itself, calibrated to within a thousandth of a degree.
   While she's on the pad, that marker IS my north. I lose it the
   moment she lifts; from then on, the platform is my only
   reference."^
.
}

{tell_about_wind
print:
   GUIDANCE: "Acknowledged. The autopilot has the wind."^
.
}

{tell_about_leak
if alarm_fired = false
   print:
      GUIDANCE, frowning: "EECOM said that?" He thumbs through a
      manual on his desk. "If the fuelled mass is changing on the
      pad, the steering law's pre-flight initialisation is off by
      the same amount. That is recoverable in flight -- the computer
      re-estimates from the accelerometers -- but it would be cleaner
      to pre-flight against an accurate mass." A pause. "Maybe not
      COMMIT-recoverable in the abort case."^
   .
else
   print:
      GUIDANCE, voice losing some of its certainty: "If EECOM has
      that, my pre-flight mass estimate is wrong by an amount I can't
      bound from here. The autopilot will re-estimate from
      accelerometers in the first ten seconds of flight, but the
      abort branch I keep talking about -- that runs against the
      pre-flight numbers." A beat. "I am still recommending COMMIT.
      But less loudly."^
   .
endif
}

{tell_about_steering
print:
   GUIDANCE, a little impatient: "Yes, Flight. The steering law is
   what I keep saying it is."^
.
}

{tell_about_tower
print:
   GUIDANCE: "Roger. The autopilot will not interfere with the abort
   sequence."^
.
}

object retro : retro retrofire abort man
 short         name "the RETRO controller"
 has           ANIMATE
 keyed         0
 parent        flight_control

{examine
set hint_examine_shown = true
if self(keyed) = 1
   write "(RETRO's loop LED is lit -- he's keyed his mic.)^^"
endif
if alarm_fired = false
   print:
      RETRO, gravelly and short: "RETRO. Range safety armed. Recovery
      forces in position."^
   .
   if hint_ask_role_shown = false
      print:
         Try ~ask retro about role~ for a fuller picture of what RETRO
         actually does. The same form works on any controller, and
         other topics include ~wind~, ~leak~, ~steering~ and ~tower~.^
      .
   endif
else
   print:
      RETRO, same gravel, slower: "Flight, RETRO. I have an abort. The
      escape tower is armed and the trajectory through max-Q is inside
      the recoverable envelope -- if she comes apart, the capsule gets
      pulled clear, the woman comes down on a canopy in salt water,
      and the carriers are inside her landing footprint." He pauses.
      "What I do not have is an opinion on whether you should need it."^
   .
endif
}

{ask_about_role
set hint_ask_role_shown = true
print:
   RETRO: "Retrofire and Range Safety, Flight. The 'retro' is from
   retrograde -- the fire-the-engines-backwards burn that brings
   a spacecraft home from orbit -- and 'range safety' is what we
   do during ascent if something goes wrong over the Atlantic.
   My console watches every instant of flight and tells you, for
   THIS instant, what your abort options are. Right now, on the
   pad: launch escape tower, two hundred milliseconds to fire,
   capsule lands in salt water. At ninety seconds: tower or
   first-stage shutdown, capsule lands in salt water. At three
   minutes: jettison the tower, abort to a low-Earth orbit, come
   home next pass."^^
   "It's the same job all the way through. Today, what abort do
   you have. Tomorrow, what abort do you have. Until you don't
   need one any more."^
.
if hint_poll_shown = false
   set hint_poll_shown = true
   print:
      When you've heard from as many of the controllers as you want,
      type ~poll~ to start the GO/NO-GO round-robin. The clock begins
      ticking the moment the poll completes.^
   .
endif
}

{tell_about_role
print:
   RETRO: "Job is the job, Flight."^
.
}

{ask_about_wind
print:
   RETRO: "Wind is FIDO's, Flight. I'll tell you this: if FIDO's
   warning is real, I have an abort that works. If FIDO's warning
   is wrong, we don't need an abort and nothing I do matters." A
   beat. "FIDO has been wrong twice in eight years. He is not
   the man I would bet against on a meteorology call."^
.
}

{ask_about_leak
print:
   RETRO: "Tank pressures aren't on my console. EECOM watches them.
   I will say this -- if there's a leak that gets worse on hold,
   then a hold is the same as a scrub with a longer name. That's
   not for me to call, but it's worth thinking about."^
.
}

{ask_about_steering
print:
   RETRO: "The steering law is GUIDANCE's, but the abort branch
   runs without it. If the tower fires, the capsule's solid-fuel
   motor pulls her up and out on a dumb ballistic arc. The
   computer gets ignored. That's by design. The man who designed
   it didn't trust computers."^^
   The way he says it suggests neither does he.^
.
}

{ask_about_tower
print:
   RETRO: "Tower is a hundred-and-fifty-pound solid-fuel motor on
   the top of the capsule. It pulls one-point-five g for two
   seconds, dragging the capsule and crew clear of the stack. At
   max-Q the canopy deploys at twelve thousand feet, splashdown is
   inside the recovery footprint, the carriers are eight minutes
   away. The tower has been tested at every flight regime we'll
   pass through today and it has fired clean every time." He
   looks at you. "If you think we are going to need it, Flight,
   we should not be going at all. But it works."^
.
}

{ask_about_maxq
print:
   RETRO: "Max-Q is the dangerous part of an ascent. If anything's
   going to tear, it tears between T+1:00 and T+1:30. My tower's
   rated for the full max-Q load -- capsule's pulled clear in two
   hundred milliseconds, canopy at four kilometres, splashdown
   inside the carrier perimeter." He pauses. "I have flown that
   abort in the simulator more times than I can count. It works in
   the sim. I would prefer not to learn today whether it works in
   the real."^
.
}

{ask_about_balloon
print:
   RETRO: "I don't read the balloon. I read FIDO. If he calls the
   wind too hot, I have an abort that works through max-Q." A beat.
   "I have flown that abort six times in the simulator. Twice the
   splashdown was outside the carrier perimeter and the sim ended
   with a search-and-rescue we wouldn't have won. I do not like the
   balloon being interesting."^
.
}

{ask_about_pad
print:
   RETRO: "On the pad, my call is the launch escape tower. The
   solid-fuel motor pulls the capsule four hundred metres up and a
   hundred metres downrange, parachute opens, capsule lands in the
   surf line. It works -- it has worked, in fact, in two real pad
   aborts in the history of this programme. The astronaut walks
   away. That is the only abort I have a hundred percent confidence
   in."^
.
}

{tell_about_wind
print:
   RETRO: "Roger, Flight. If she has to come down through it, we
   bring her down through it."^
.
}

{tell_about_leak
print:
   RETRO, lifting his eyebrows -- the most expressive he has been
   all day: "Ah. Then HOLD makes the problem worse. That changes
   the calculus, Flight. Not my call which way it changes it."^
.
}

{tell_about_steering
print:
   RETRO: "Doesn't change my abort. Tower flies whether the
   computer agrees or not."^
.
}

{tell_about_tower
print:
   RETRO: "The tower stays armed, Flight. As long as I'm at this
   console and the count is alive, the tower is armed."^
.
}

# -----------------------------------------------------------------------------
# THE REST OF BUILDING 30 -- the corridor outside the auditorium, the
# flight director's small private office, and the public viewing gallery.
# Each is a quiet space; the action is on the main floor. The +timer keeps
# firing wherever the player is, so the alarm prints to maintext even from
# the office -- but the controllers are parented to flight_control and
# can only be polled from there.
# -----------------------------------------------------------------------------

location corridor : corridor hall hallway
 short         the "Mission Control Corridor"
 south         flight_control
 in            flight_control
 north         flight_director_office
 east          viewing_gallery

{look
print:
   A short fluorescent-lit corridor immediately outside the Mission
   Control auditorium, walls pale institutional green and floor
   waxed to a hospital shine. Through the double doors to the south
   you can hear the murmur of the loop -- twelve men breathing into
   their headsets, the hum of three thousand vacuum tubes, and the
   occasional bright callsign cutting through it: ~FIDO, Flight.~
   ~Go ahead, Flight.~ The red live-loop light above the doors is
   on, which means the room is sealed; press, families and managers
   stay out.^^
   North, a frosted-glass door bears your name and title in black
   caps. East, a wider doorway opens onto the public viewing gallery
   where the VIPs and the press pool wait behind glass.^^
   On the wall beside you: a wall clock whose thin red sweep hand
   keeps time with the count, a cork bulletin board pocked from
   years of thumbtacks
   and sun-faded along its right edge, and a drinking fountain
   someone has captioned in marker pen. The air is dry and smells
   faintly of floor wax, cigarettes, and the ozone that rolls off
   the high-voltage tubes next door.^
.
}

object doors : double door doors brushed steel
 short         the "double doors"
 static
 parent        corridor

{examine
print:
   The double doors back into the auditorium. Brushed steel, kick-
   panels scuffed by twenty years of console operators in a hurry.
   A small red light above them is lit, meaning the room is on a
   live launch loop.^
.
}

{listen_to
print:
   You put your ear close to the steel. The loop is in there: the
   constant low hum of the controllers' headsets bleeding into the
   air, a controller saying something measured about ullage
   pressure, CAPCOM acknowledging from the spacecraft side in his
   tinny long-distance voice. Underneath it the steady electrical
   purr of three thousand vacuum tubes. The doors are doing their
   job; you can't make out the words clearly. But the rhythm of it
   is unmistakable -- the slow, professional cadence of a count
   going well.^
.
}

object nameplate : nameplate plate name stencil door
 short         the "nameplate"
 static
 parent        corridor

{examine
print:
   A frosted-glass door with your name stencilled across it in
   black caps. Beneath the name, in smaller letters: FLIGHT --
   MISSION OPERATIONS DIRECTOR. The stencil is fresher than the
   door it sits on.^
.
}

{read
print:
   The stencil reads, in black block caps -- your surname above,
   your title below:^^
   ~KRYTEN~^
   ~FLIGHT -- MISSION OPERATIONS DIRECTOR~^^
   Your predecessor's name came off this door six weeks ago. You
   have not yet stopped noticing it is yours.^
.
}

object fountain : drinking fountain water bubbler
 short         the "drinking fountain"
 static
 parent        corridor

{examine
print:
   A wall-mounted drinking fountain with a chipped porcelain bowl.
   Someone has stuck a hand-lettered sign above it: WATER IS NOT
   COFFEE. PLEASE DRINK SOME OCCASIONALLY. -- M.C.^
.
}

{read
print:
   The hand-lettered sign above the fountain, in firm black marker:^^
   ~WATER IS NOT COFFEE. PLEASE DRINK SOME OCCASIONALLY. -- M.C.~^^
   M.C. would be the building manager. He has been waging this
   campaign, fountain by fountain, for as long as you have worked
   here. He is not winning.^
.
}

object bulletin : bulletin board cork notices noticeboard
 short         the "bulletin board"
 static
 parent        corridor

{examine
print:
   The corridor's bulletin board: a cafeteria menu, a softball-team
   sign-up, a notice about the upcoming family-day picnic, and one
   creased mission patch -- the lost crew from two missions ago. No
   one has had the heart to take it down.^
.
}

{read
print:
   You step closer to read what's pinned to the cork.^^
   The cafeteria menu, on faded mimeograph: ~SALISBURY STEAK
   WEDNESDAY -- MEATLOAF FRIDAY -- TUNA SALAD DAILY~. Someone has
   crossed out TUNA SALAD and pencilled in a small angry face.^^
   The softball sheet has eight names; FIDO's is third, with a
   number 12 next to it in her own bright handwriting. Below the
   list, in red marker: ~GO/NO-GO ON THE LAUNCH PARTY DEPENDS ON
   THE LAUNCH GOING.~^^
   The family-day picnic is for the Saturday after this flight,
   weather permitting -- there's a hand-drawn map to the recreation
   field and a footnote: ~spouses please bring a dish to share~.^^
   And the mission patch: a blue circle, two crewmen, a lunar
   curve. Beneath it a small typed index card, pinned at one
   corner, that says only ~AD ASTRA~.^
.
}

object wall_clock : clock countdown timer wall-clock
 short         the "wall clock"
 static
 parent        corridor

{examine
print:
   A government-issue analog clock the size of a dinner plate,
   bolted to the corridor wall above eye height. The face is white,
   the numerals black, and the second hand a thin red sweep keeping
   time with the count.^
.
if telemetry[TLM_MET] < 0
   set abs_met = 0
   set abs_met - telemetry[TLM_MET]
   if timer_started = true
      write "Right now it reads T-" abs_met " seconds and falling.^"
   else
      write "Right now it reads T-" abs_met " seconds and holding.^"
   endif
else
   write "Right now it reads T+" telemetry[TLM_MET] " seconds and climbing.^"
endif
}

{read
print:
   The clock is analogue; it has nothing to read. Just the time --
   which is to say, the count.^
.
if telemetry[TLM_MET] < 0
   set abs_met = 0
   set abs_met - telemetry[TLM_MET]
   if timer_started = true
      write "T-" abs_met " seconds.^"
   else
      write "T-" abs_met " seconds, holding.^"
   endif
else
   write "T+" telemetry[TLM_MET] " seconds.^"
endif
}

