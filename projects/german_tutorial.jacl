#!../bin/jacl
#                                                           JACL TUTORIAL GAME
# -----------------------------------------------------------------------------
# German translation of the JACL tutorial game.
# -----------------------------------------------------------------------------

constant game_title       "JACL Tutorium"
constant game_author      "Stuart Allen"
constant game_version     1
constant ifid             "JACL-121"
constant game_publish     true

constant header_colour       "#3a3a5a"
constant linkbar_colour      "#5a5a7c"
constant maintext_colour     "#f4f1e8"

location schlafzimmer : schlafzimmer
 short         name "Schlafzimmer"
 west          badezimmer
 south         wohnzimmer
 x             1
 y             0

{look
write "Du bist in Deinem Schlafzimmer. In der Mitte des "
write "Zimmers steht ein großes Bett, während westlich "
write "ein Flur ins Badezimmer führt.^"
}

object bett: bett
 short         das "Bett"
 mass          scenery

{look_under
if Programmheft(parent) = limbo
   write "Gut versteckt unter dem Bett findest "
   write "Du das Programmheft dieser Woche.^"
   set Programmheft(parent) = here
   points 50
   return
endif
write "Sonst ist dort nichts zu finden.^"
}

object Programmheft: programmheft heft
 short         ein "Programmheft"
 long          "Hier befindet sich ein Programmheft.^"
 parent        limbo
 mass          5

{examine : read
write "Es enthält das aktuelle Fernsehprogramm.^"
}

{give_to_rick : show_to_rick
write "~Cool!~ Rick grunzt zufrieden, als er Dir das Heft "
write "aus den Händen reißt.^^"
write "Zufrieden damit, heute wenigstens eine Sache "
write "auf die Kette bekommen zu haben, legst Du Dich wieder hin.^"
points 50
execute "+game_over"
}

location badezimmer : badezimmer
 short         name "Badezimmer"
 east          schlafzimmer
 x             0
 y             0

{look
write "Du bist im Badezimmer. Der einzige Weg von hier "
write "führt zurück ins Schlafzimmer.^"
}

{movement
if compass = east : compass = out
   write "Du stößt Dir den Kopf, als "
   write "Du durch die Tür gehst.^^"
   return false
endif
write "Von hier aus geht es nur nach Osten.^"
}

object Schachtel: schachtel
 has           CONTAINER CLOSABLE CLOSED
 short         eine "kleine hölzerne Schachtel"
 long          "Hier ist eine kleine hölzerne Schachtel.^"
 mass          25
 quantity      20

{close_override
write "Der Deckel quietscht, während Du ihn schließt.^"
ensure Schachtel has CLOSED
}

object Notiz: Notizzettel notizzettel notiz
 short         ein "orangefarbener Notizzettel"
 long          "Ein orangefarbener Notizzettel liegt auf dem Boden.^"
 parent        Schachtel
 mass          5

{read : examine
write "Auf dem Zettel steht: ~Welcome to Jamaica and have a nice day.~^"
}

location wohnzimmer : wohnzimmer
 short         name "Wohnzimmer"
 north         schlafzimmer
 x             1
 y             1

{look
if here has VISITED
   write "Du bist wieder im Wohnzimmer.^"
else
   write "Du befindest Dich im Wohnzimmer. Auf einem niedrigen "
   write "Tischchen vor dem Sofa steht ein Fernseher.^"
endif
}

{eachturn
set rick(status) + 1
if rick(status) = 5
   write "Rick nimmt einen Schluck.^"
   set rick(status) = 0
endif
}

object Fernseher: fernseher
 short         der "Fernseher"
 mass          scenery

{examine
write "Zur Zeit läuft im Fernsehen ein Zeichentrickfilm.^"
}

{turn_off
write "Als Du den Fernseher ausgeschaltet hast, siehst Du "
write "voller Schock zu, wie Rick beginnt sich zu verändern. "
write "Es wächst ihm ein Fell und er bekommt Schaum vor dem "
write "Mund. Diese Beobachtung wird jedoch vorzeitig beendet, da "
write "Rick Dir seine gerade neu erworbenen Fänge in den "
write "Hals rammt.^"
execute "+game_over"
}

object rick: Sohn Junge Teenager Rick
 has           ANIMATE
 short         name "Rick"
 long          "Rick ist hier, er guckt fern.^"
 mass          heavy

{examine
write "Rick starrt regungslos auf den Bildschirm.^"
}

{talk_to
write "~Ähm, ja... klar — mach ich sofort.~ murmelt Rick "
write "ohne aufzuschauen. Du hast den starken Verdacht, dass er Dir "
write "nicht im Entferntesten zugehört hat.^"
}

# -----------------------------------------------------------------------------
# GLOBAL FUNCTIONS
# -----------------------------------------------------------------------------

{+default_ask_about
if noun1 = rick
   write "Rick zwinkert ein paar Mal und schiebt dann seine "
   write "Unterlippe vor. Soweit Du das über die Jahre "
   write "herausbekommen hast, lässt sich diese Geste mit ~Keinen Schimmer~ "
   write "übersetzen.^"
   return
endif
return false
}

{+intro
if intro_dedication_shown = 0
   set intro_dedication_shown = 1
   style bold
   write "^^" game_title
   style normal
   write " von " game_author "^^"

   print:
      Dein Wecker klingelt und Du steigst aus dem Bett.
      Es ist wieder einmal Montag. Naja, immerhin hat Dein
      Haus keine Haustür, was ja eine gute Entschuldigung
      ist, nicht zur Arbeit zu gehen.^^
   .
endif

execute "+startup_preferences"
if pending_question_type != 0
   return
endif

if intro_scene_shown = 0
   set intro_scene_shown = 1
   if here hasnt OUTDOORS
     set north_wall(parent) = here
     set south_wall(parent) = here
     set east_wall(parent) = here
     set west_wall(parent) = here
   endif
   set ground(parent) = here
   look
endif
}

object kryten: ich selber mich
 has           ANIMATE
 short         name "Du"
 quantity      42
 parent        schlafzimmer
 player

{examine
write "Schön wie immer.^"
execute "+inventory"
}

grammar about     >about
grammar ueber     >about
grammar über      >about

{+about
write "Dies ist das Spiel aus dem Tutorium des JACL Author's Guide. "
write "Der Quelltext findet sich im Anhang dieses Handbuchs.^"
}

#include "german.library"
#include "german_verbs.library"
#include "webinterface.library"
#include "webinterface.css"
#include "mapping.library"
