#!../bin/cgijacl

# -----------------------------------------------------------------------------
# OFFSIDE -- ORGANISING FIXTURES FOR SOCIAL IDIOTS DOING EXERCISE
#
# A webapp.library program for running a set of football (soccer)
# competitions. Everything is stored in per-game CSV files in projects/data:
#
#   offside-competitions.csv   id, name, season, owner
#   offside-teams.csv          id, competition id, name
#   offside-players.csv        id, team id, name, position, shirt number
#   offside-fixtures.csv       id, competition id, date (yyyymmdd), home id,
#                              away id, home goals, away goals, kick-off
#                              (hhmm) -- the goals are "-" until the result
#                              is entered; kick-off 2400 means "to be
#                              confirmed", as does a row without the column
#   offside-organisers.csv     id, competition id, Google account id, name
#   offside-invites.csv        id, code, competition id, expiry (unixtime),
#                              name
#   offside-admins.csv         Google account id, name (maintained by hand)
#
# PERMISSIONS: anyone can view everything. Signing in with Google lets you
# create competitions. A competition's teams, players and results can be
# changed by the account that created it (its owner), by the organisers the
# owner adds, and by site admins listed in offside-admins.csv. Deleting a
# competition and choosing its organisers is for the owner and admins only.
# The owner usually adds an organiser with an invite link: whoever opens it
# and signs in becomes an organiser. Each link works once, for a week, and
# its code comes from random, which is drawn from the OS, so it can't be guessed.
#
# DELETES: a Delete link only shows a confirmation; the Confirm button does
# the delete and must carry the one-time token that confirmation issued.
# Link prefetchers and crawlers follow links but don't submit forms, and a
# delete URL left in the history or shared can't be replayed.
# Every handler that changes data checks this itself -- hiding the forms and
# links is only presentation, since anyone can type ?command=delete+team+3.
#
# Competitions created before owners were recorded have only three columns
# and so no owner; only admins can change them. NOTE: field[] values are NOT
# cleared between rows, so a short row would show the previous row's
# field[3]. Always check field_count before reading the owner.
#
# NOTE: the interpreter has a single CSV file handle and closes it whenever
# ANY function exits. That means an iterate/update loop must never call a
# function (execute, macros like {the}, +text etc.) and loops can't be nested.
# Anything that needs data from two files (a results list with team names, the
# league table) first loads the teams into the t_* arrays with +load_teams and
# then makes a single pass over the second file.
#
# NOTE: append and insert silently skip empty strings, which would shift every
# later column left. Required fields are validated as non-empty and optional
# ones are stored as "-".
# -----------------------------------------------------------------------------

constant status_window     0
constant game_title        "OFFSIDE"
constant game_author       "Stuart Allen"
constant game_release      1
constant game_build        1
constant game_publish      false
constant ifid              "JACL-142"

# -----------------------------------------------------------------------------

integer INDEX
integer COUNT
integer errors
integer new_id
integer found
integer swapped
integer gmt
integer now

constant COMPETITIONS     1
constant TEAMS            2
constant RESULTS          3
constant TABLE            4

string tab_names     "OFFSIDE" "Competitions" "Teams" "Fixtures & results" "League table"

# THE CURRENTLY SELECTED COMPETITION AND TEAM ARE PART OF THE SAVED SESSION
# STATE, SO THEY CARRY FROM ONE REQUEST TO THE NEXT
integer current_comp     0
string current_comp_name
integer current_team     0
string current_team_name

# FORM FIELDS. THE <name>_data / <name>_error PAIRS ARE THE CONVENTION
# forms.library USES TO REDISPLAY STICKY VALUES AND ERROR MESSAGES
string comp_name_data
string comp_name_error
string season_data
string season_error
string team_name_data
string team_name_error
string player_name_data
string player_name_error
string position_data
string shirt_data
string shirt_error
string fixture_error

integer home_team        0
integer away_team        0
integer home_goals       0
integer away_goals       0

parameter comp_name      comp_name_data
parameter season         season_data
parameter team_name      team_name_data
parameter player_name    player_name_data
parameter position       position_data
parameter shirt          shirt_data
parameter home_team      home_team     0 65535
parameter away_team      away_team     0 65535
parameter home_goals     home_goals    0 99
parameter away_goals     away_goals    0 99

constant position_values     "Goalkeeper" "Defender" "Midfielder" "Forward"

# A FIXTURE'S DATE IS CHOSEN FROM THREE DROP-DOWNS RATHER THAN TYPED, SO
# cgijacl RANGE-CHECKS EACH PART AS AN INTEGER AND THE PROGRAM NEVER HAS TO
# PARSE FREE TEXT (split LEAVES OLD ELEMENTS BEHIND AND A NON-NUMBER ABORTS
# THE FUNCTION). IT'S STORED AS yyyymmdd SO IT SORTS AS A NUMBER.
# cgijacl CLAMPS AN OUT-OF-RANGE NUMBER TO THE RANGE BUT LEAVES THE VARIABLE
# UNCHANGED WHEN THE VALUE ISN'T A NUMBER OR ISN'T SENT, SO THE SUBMITTED
# fixture_* ARE CLEARED AFTER EVERY REQUEST (A MISSING PART THEN READS AS 0)
# AND THE DATE THE FORM REMEMBERS -- SO A WHOLE ROUND CAN BE ENTERED
# QUICKLY -- IS KEPT SEPARATELY IN chosen_*.
integer fixture_day      0
integer fixture_month    0
integer fixture_year     0
integer chosen_day       0
integer chosen_month     0
integer chosen_year      0

# KICK-OFF AS hhmm (1830 = 6:30pm). 2400 MEANS "TO BE CONFIRMED"; 0 MEANS
# THE FIELD WASN'T SENT. SAME SUBMITTED/REMEMBERED SPLIT AS THE DATE.
constant TIME_TBC        2400
integer fixture_time     0
integer chosen_time      0
parameter fx_time        fixture_time     0 2400
string time_label
string row_time
parameter fx_day         fixture_day      1 31
parameter fx_month       fixture_month    1 12
parameter fx_year        fixture_year     2000 2100

string day_abbr          "Sat" "Sun" "Mon" "Tue" "Wed" "Thu" "Fri"
string month_abbr        "" "Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug" "Sep" "Oct" "Nov" "Dec"
string date_label
string team_label
string score_none        "-"

# THE CURRENT COMPETITION'S FIXTURES, LOADED BY +load_games IN DATE ORDER.
# g_hg / g_ag ARE -1 UNTIL THE RESULT IS ENTERED.
constant MAX_GAMES       400
integer game_count
integer_array g_id       MAX_GAMES
integer_array g_key      MAX_GAMES
integer_array g_home     MAX_GAMES
integer_array g_away     MAX_GAMES
integer_array g_hg       MAX_GAMES
integer_array g_ag       MAX_GAMES
integer_array g_time     MAX_GAMES
integer game_time
integer tl_h
integer tl_m
integer game_key
integer game_pos
integer game_prev
integer game_home
integer game_away
integer game_hg
integer game_ag
integer game_team
integer edit_id
integer moving
integer team_scan
integer days_in_month
integer year_from
integer year_to
integer dl_d
integer dl_m
integer dl_y
integer dl_k
integer dl_j
integer dl_h
integer dl_t

# TEAMS OF THE CURRENT COMPETITION, LOADED BY +load_teams. INDEXED 0 TO
# team_count - 1. t_order HOLDS THE INDEXES SORTED INTO LEAGUE TABLE ORDER
constant MAX_TEAMS     40

integer team_count
integer_array t_id      MAX_TEAMS
string_array t_name     MAX_TEAMS
integer_array t_p       MAX_TEAMS
integer_array t_w       MAX_TEAMS
integer_array t_d       MAX_TEAMS
integer_array t_l       MAX_TEAMS
integer_array t_gf      MAX_TEAMS
integer_array t_ga      MAX_TEAMS
integer_array t_gd      MAX_TEAMS
integer_array t_pts     MAX_TEAMS
integer_array t_order   MAX_TEAMS

integer home_index
integer away_index
integer goals_for
integer goals_against
integer sort_a
integer sort_b

string action
string escaped
string escaped2

# PERMISSIONS, RECALCULATED ON EVERY REQUEST BY +refresh_permissions.
# google_signed_in AND google_sub ARE SET BY THE INTERPRETER, AND ONLY FROM A
# VERIFIED SESSION COOKIE, SO THEY CAN'T BE FORGED WITH A user_id PARAMETER.
integer is_admin
integer can_edit
integer can_manage
integer allowed
integer target_comp
string current_comp_owner
string row_owner

# ONE-TIME DELETE CONFIRMATION. delete_pending NAMES WHAT THE TOKEN IS FOR,
# E.G. "team 3", SO A TOKEN CAN'T BE USED ON A DIFFERENT RECORD.
integer delete_token     0
integer token_param      0
integer delete_id
string delete_pending
string delete_check
parameter token          token_param   0 999999

# ADDING AN ORGANISER
string organiser_id_data
string organiser_id_error
string organiser_name_data
string organiser_name_error
parameter organiser_id   organiser_id_data
parameter organiser_name organiser_name_data

# INVITE LINKS. invite_data IS THE CODE FROM AN OPENED LINK (?invite=...);
# IT STAYS SET UNTIL THE VISITOR HAS SIGNED IN AND IT'S BEEN USED.
constant INVITE_DAYS     7
string invite_data
string invite_name_data
string invite_name_error
string invite_code
string invite_message
string invite_comp_name
integer invite_id
integer invite_comp
integer invite_expires
integer invite_days
integer now_time
integer invite_count
parameter invite         invite_data
parameter invite_name    invite_name_data

# -----------------------------------------------------------------------------
# PAGE FRAMEWORK
# -----------------------------------------------------------------------------

# +header (WHICH CALLS THIS) RUNS BEFORE ANYTHING ELSE ON A FULL PAGE LOAD.
# AJAX REQUESTS SKIP THE HEADER, SO +before REFRESHES THE PERMISSIONS TOO.
{+links_div
execute "+refresh_permissions"
execute "+check_invite"
write "<span id=~compname~>"
execute "+write_comp_label"
write "</span>"
}

{+write_comp_label
ifstring current_comp_name != ""
   escapestring escaped current_comp_name
   write "<b>" escaped "</b>"
else
   write "No competition selected"
endif
}

# THE FIRST REQUEST OF A SESSION ONLY RUNS +intro (NO COMMAND IS DISPATCHED,
# SO +after DOESN'T FIRE), SO DRAW THE CURRENT TAB FROM HERE AS WELL
{+intro
set player = you
execute "+refresh_permissions"
execute "+after"
}

# A NEW SESSION WHOSE FIRST REQUEST ALREADY CARRIES A COMMAND (A BOOKMARKED
# OR SHARED LINK) SKIPS +intro AND GETS +setup INSTEAD
{+setup
set player = you
}

# WORKS OUT WHO THE VISITOR IS AND WHAT THEY MAY CHANGE, AND REFRESHES THE
# CURRENT COMPETITION FROM THE FILE (IT MAY HAVE BEEN DELETED BY SOMEONE ELSE)
{+refresh_permissions
set is_admin = false
if google_signed_in = true
   iterate admins
      ifstring field[0] = google_sub
         set is_admin = true
      endif
   enditerate
endif

# A NEW SESSION STARTS ON THE FIRST COMPETITION, IF THERE IS ONE
set found = false
setstring current_comp_owner "-"
iterate competitions
   if current_comp = 0
      set current_comp = field[0]
   endif
   if field[0] = current_comp
      set found = true
      setstring current_comp_name field[1]
      if field_count > 3
         setstring current_comp_owner field[3]
      endif
   endif
enditerate
if found = false
   set current_comp = 0
   setstring current_comp_name ""
   set current_team = 0
   setstring current_team_name ""
endif

set can_manage = false
set can_edit = false
if current_comp != 0
   set can_manage = is_admin
   if google_signed_in = true
      ifstring current_comp_owner = google_sub
         set can_manage = true
      endif
   endif
   execute "+comp_editable<current_comp"
   set can_edit = allowed
endif
}

# SETS allowed TO WHETHER THE VISITOR IS COMPETITION arg[0]'S OWNER OR AN
# ADMIN: THE PEOPLE WHO CAN DELETE IT AND CHOOSE ITS ORGANISERS
{+comp_manageable
set allowed = is_admin
if google_signed_in = true
   iterate competitions
      if field[0] = arg[0]
         if field_count > 3
            ifstring field[3] = google_sub
               set allowed = true
            endif
         endif
      endif
   enditerate
endif
}

# SETS allowed TO WHETHER THE VISITOR MAY CHANGE COMPETITION arg[0]'S TEAMS,
# PLAYERS AND RESULTS: ITS OWNER, AN ADMIN, OR ONE OF ITS ORGANISERS
{+comp_editable
execute "+comp_manageable<arg[0]"
if allowed = false
   if google_signed_in = true
      iterate organisers
         if field[1] = arg[0]
            ifstring field[2] = google_sub
               set allowed = true
            endif
         endif
      enditerate
   endif
endif
}

{+deny
write "<p class=~notice~>Only this competition's organisers can change it.</p>"
}

{+deny_manage
write "<p class=~notice~>Only the person who created this competition can do that.</p>"
}

# WRITES THE CONFIRM/CANCEL HALF OF A DELETE CONFIRMATION AND ISSUES THE
# ONE-TIME TOKEN. THE CALLER HAS ALREADY WRITTEN THE QUESTION.
# arg[0] = kind ("team" etc.), arg[1] = id
{+confirm_form
set max_rand = 999999
set delete_token = random
setstring delete_pending string_arg[0] " " arg[1]
write "<form>"
write "<input type=~hidden~ name=~command~ value=~delete " string_arg[0] " " arg[1] "~/>"
write "<input type=~hidden~ name=~token~ value=~" delete_token "~/>"
hidden
write "<input type=~submit~ class=~danger~ value=~Delete~> &nbsp; "
hyperlinkNE "Cancel" "blankjacl"
write "</form></div>"
}

# SETS allowed TO WHETHER THIS DELETE CARRIES THE TOKEN ISSUED FOR IT. THE
# TOKEN IS SPENT EITHER WAY. arg[0] = kind, arg[1] = id
{+token_ok
set allowed = false
setstring delete_check string_arg[0] " " arg[1]
ifall token_param != 0 : token_param = delete_token
   ifstring delete_check = delete_pending
      set allowed = true
   endif
endif
set delete_token = 0
setstring delete_pending ""
if allowed = false
   write "<p class=~notice~>Nothing was deleted: that confirmation has expired. "
   write "Use the Delete link again.</p>"
endif
}

{+view_only_note
if can_edit = false
   write "<p class=~key~>View only. "
   if google_signed_in = false
      write "Sign in with Google (the button at the bottom right of the banner) to create and run your own competitions."
   else
      write "Only this competition's organisers can change it. To become one, "
      write "give its creator your account ID from the <b>Competitions</b> tab."
   endif
   write "</p>"
endif
}

# A TAB CLICK ARRIVES WITH NO COMMAND, WHICH THE INTERPRETER TURNS INTO
# 'blankjacl'. IT ONLY NEEDS TO EXIST SO THE PARSER IS HAPPY; +after DOES
# THE DRAWING.
grammar blankjacl     >blankjacl

{+blankjacl
}

{+before
set errors = 0
execute "+refresh_permissions"
return false
}

{+after
# THE HEADER WAS DRAWN BEFORE THE COMMAND RAN, SO A 'select competition' OR
# 'delete competition' WOULD LEAVE IT NAMING THE OLD ONE. COPY THE CURRENT
# LABEL ACROSS. (IT GOES VIA A HIDDEN ELEMENT SO THE NAME NEVER HAS TO BE
# QUOTED AS A JAVASCRIPT STRING.)
write "<span id=~compnow~ hidden>"
execute "+write_comp_label"
write "</span><script>var c = document.getElementById('compname'); "
write "if (c) c.innerHTML = document.getElementById('compnow').innerHTML;</script>"

# THE FORMS ARE GETs, SO AFTER ONE IS SUBMITTED ITS FIELDS AND command= STAY IN
# THE ADDRESS BAR AND A RELOAD WOULD RUN IT AGAIN (ADDING A SECOND INVITE,
# TEAM OR FIXTURE). CUT THE ADDRESS BACK TO THE TAB, KEEPING ONLY WHAT
# IDENTIFIES THE VISITOR AND AN UNACCEPTED ?invite= (CLEARED BELOW ONCE USED)
write "<script>(function() { var q = new URLSearchParams(location.search), k = new URLSearchParams(); "
write "['user_id', 'device', 'invite'].forEach(function(n) { if (q.has(n)) k.set(n, q.get(n)); }); "
write "k.set('mode', '" WEBAPP_mode "'); "
write "var u = location.pathname + '?' + k.toString(); "
write "if (u != location.pathname + location.search) history.replaceState(null, '', u); })();</script>"

ifstring invite_message != ""
   write invite_message
   setstring invite_message ""
   # DROP ?invite=... FROM THE ADDRESS BAR SO A RELOAD OR BOOKMARK DOESN'T
   # CARRY THE CODE ROUND
   ifstring invite_data = ""
      write "<script>history.replaceState(null, '', location.pathname);</script>"
   endif
endif

if WEBAPP_mode = COMPETITIONS
   execute "+display_competitions"
endif
if WEBAPP_mode = TEAMS
   execute "+display_teams"
endif
if WEBAPP_mode = RESULTS
   execute "+display_results"
endif
if WEBAPP_mode = TABLE
   execute "+display_table"
endif

# CLEAR THE PARAMETERS SO THEY DON'T LEAK INTO THE NEXT REQUEST VIA THE
# SAVED SESSION STATE
setstring comp_name_data      ""
setstring comp_name_error     ""
setstring season_data         ""
setstring season_error        ""
setstring team_name_data      ""
setstring team_name_error     ""
setstring player_name_data    ""
setstring player_name_error   ""
setstring position_data       ""
setstring shirt_data          ""
setstring shirt_error         ""
setstring fixture_error       ""
set fixture_day = 0
set fixture_month = 0
set fixture_year = 0
set fixture_time = 0
setstring organiser_id_data   ""
setstring organiser_id_error  ""
setstring organiser_name_data ""
setstring organiser_name_error ""
setstring invite_name_data    ""
setstring invite_name_error   ""
set token_param = 0
set home_team = 0
set away_team = 0
set home_goals = 0
set away_goals = 0
set errors = 0
}

{+no_competition
write "<p>No competition is selected. Choose one from the "
write "<b>Competitions</b> tab, or add a new one there first.</p>"
}

{+submit_row
write "<div class=~row~>"
write "<div class=~label~>&nbsp;</div>"
write "<div class=~input~><input type=~submit~ value=~" string_arg[0] "~></div>"
write "</div>"
}

# -----------------------------------------------------------------------------
# ID ALLOCATION. EACH SCANS ITS FILE FOR THE HIGHEST ID AND LEAVES THE NEXT
# FREE ONE IN new_id. DONE AT THE MOMENT OF THE APPEND RATHER THAN CACHED SO
# TWO BROWSER SESSIONS CAN'T HAND OUT THE SAME ID.
# -----------------------------------------------------------------------------

{+next_comp_id
set new_id = 0
iterate competitions
   if field[0] > new_id
      set new_id = field[0]
   endif
enditerate
set new_id + 1
}

{+next_team_id
set new_id = 0
iterate teams
   if field[0] > new_id
      set new_id = field[0]
   endif
enditerate
set new_id + 1
}

{+next_player_id
set new_id = 0
iterate players
   if field[0] > new_id
      set new_id = field[0]
   endif
enditerate
set new_id + 1
}

{+next_fixture_id
set new_id = 0
iterate fixtures
   if field[0] > new_id
      set new_id = field[0]
   endif
enditerate
set new_id + 1
}

# -----------------------------------------------------------------------------
# COMPETITIONS
# -----------------------------------------------------------------------------

{+display_competitions
write "<h2>Competitions</h2>"
set COUNT = 0
write "<table class=~league~>"
write "<tr><th>Competition</th><th>Season</th><th>Action</th></tr>"
iterate competitions
   escapestring escaped field[1]
   escapestring escaped2 field[2]
   if field[0] = current_comp
      write "<tr class=~selected~>"
   else
      write "<tr>"
   endif
   write "<td>" escaped "</td><td>" escaped2 "</td><td>"
   if field[0] = current_comp
      write "<i>selected</i>"
   else
      setstring action "select competition " field[0] "&mode=" TEAMS
      hyperlinkNE "Select" action
   endif
   # INLINE VERSION OF +comp_editable: NO FUNCTION CALLS INSIDE iterate
   setstring row_owner "-"
   if field_count > 3
      setstring row_owner field[3]
   endif
   set allowed = is_admin
   if google_signed_in = true
      ifstring row_owner = google_sub
         set allowed = true
         write " &middot; <i>yours</i>"
      endif
   endif
   if allowed = true
      write " &middot; "
      setstring action "confirm delete competition " field[0]
      hyperlinkNE "Delete" action
   endif
   write "</td></tr>"
   set COUNT + 1
enditerate
write "</table>"
if COUNT = 0
   write "<p>There are no competitions yet.</p>"
endif

if google_signed_in = false
   write "<p class=~key~>Sign in with Google (the button at the bottom right of the banner) to create and run "
   write "your own competitions.</p>"
   return
endif

write "<h3>Add a competition</h3>"
write "<form>"
execute "+text<Name<comp_name<40"
execute "+text<Season<season<20"
execute "+submit_row<Add competition"
write "<input type=~hidden~ name=~command~ value=~add competition~/>"
hidden
write "</form>"

if can_manage = true
   execute "+display_organisers"
endif

# AN ADMIN OR ORGANISER IS ADDED BY THEIR ACCOUNT ID, SO SHOW SIGNED-IN
# USERS THEIRS
if is_admin = true
   write "<p class=~key~>You're a site admin and can change any competition.</p>"
else
   write "<p class=~key~>Your account ID is " google_sub ".</p>"
endif
}

grammar add competition     >add_competition

{+add_competition
if google_signed_in = false
   write "<p class=~notice~>Sign in with Google (the button at the bottom right of the banner) to create a competition.</p>"
   return
endif
ifstring comp_name_data = ""
   setstring comp_name_error "Please enter a name for the competition."
   set errors + 1
endif
ifstring season_data = ""
   setstring season_data "-"
endif
if errors != 0
   return
endif
execute "+next_comp_id"
append competitions new_id comp_name_data season_data google_sub
escapestring escaped comp_name_data
write "<p class=~notice~>Competition <b>" escaped "</b> added.</p>"

# THE CREATOR WILL WANT TO SET IT UP NEXT, SO MAKE IT THE CURRENT ONE
set current_comp = new_id
setstring current_comp_name comp_name_data
set current_team = 0
setstring current_team_name ""
setstring current_comp_owner google_sub
set can_edit = true
set can_manage = true
}

grammar select competition $integer     >select_competition

{+select_competition
set found = false
iterate competitions
   if field[0] = $integer
      set found = true
      set current_comp = $integer
      setstring current_comp_name field[1]
   endif
enditerate
if found = false
   write "<p class=~notice~>That competition no longer exists.</p>"
   return
endif
set current_team = 0
setstring current_team_name ""
# +before WORKED OUT can_edit FOR THE PREVIOUS COMPETITION
execute "+refresh_permissions"
}

grammar delete competition $integer     >delete_competition

# DELETING A COMPETITION CASCADES TO ITS TEAMS, THEIR PLAYERS AND ITS
# RESULTS. EACH update LIVES IN ITS OWN FUNCTION BECAUSE update ABORTS THE
# CALLING FUNCTION IF ITS FILE DOESN'T EXIST YET.
{+delete_competition
set new_id = $integer
execute "+token_ok<competition<new_id"
if allowed = false
   return
endif
execute "+comp_manageable<new_id"
if allowed = false
   execute "+deny_manage"
   return
endif
execute "+purge_organisers<new_id"
execute "+purge_invites<new_id"
execute "+load_teams<new_id"
execute "+purge_players"
execute "+purge_teams<new_id"
execute "+purge_fixtures<new_id"
execute "+purge_competition<new_id"
if current_comp = new_id
   set current_comp = 0
   setstring current_comp_name ""
   set current_team = 0
   setstring current_team_name ""
endif
write "<p class=~notice~>Competition deleted along with its teams, "
write "players, fixtures and results.</p>"
execute "+refresh_permissions"
}

{+purge_competition
update competitions
   if field[0] != arg[0]
      # REWRITING A PRE-OWNER ROW GIVES IT AN EXPLICIT "NO OWNER"
      setstring row_owner "-"
      if field_count > 3
         setstring row_owner field[3]
      endif
      insert field[0] field[1] field[2] row_owner
   endif
endupdate
}

{+purge_teams
update teams
   if field[1] != arg[0]
      insert field[0] field[1] field[2]
   endif
endupdate
}

{+purge_fixtures
update fixtures
   setstring row_time "2400"
   if field_count > 7
      setstring row_time field[7]
   endif
   if field[1] != arg[0]
      insert field[0] field[1] field[2] field[3] field[4] field[5] field[6] row_time
   endif
endupdate
}

# REMOVES EVERY PLAYER BELONGING TO A TEAM IN THE t_* ARRAYS
{+purge_players
update players
   set found = false
   set INDEX = 0
   while INDEX < team_count
      if field[1] = t_id[INDEX]
         set found = true
      endif
      set INDEX + 1
   endwhile
   if found = false
      insert field[0] field[1] field[2] field[3] field[4]
   endif
endupdate
}

# -----------------------------------------------------------------------------
# TEAMS AND PLAYERS
# -----------------------------------------------------------------------------

# LOADS THE TEAMS OF COMPETITION arg[0] INTO THE t_* ARRAYS AND ZEROES THEIR
# STATISTICS
{+load_teams
set team_count = 0
iterate teams
   ifall field[1] = arg[0] : team_count < MAX_TEAMS
      set t_id[team_count] = field[0]
      setstring t_name[team_count] field[2]
      set t_p[team_count] = 0
      set t_w[team_count] = 0
      set t_d[team_count] = 0
      set t_l[team_count] = 0
      set t_gf[team_count] = 0
      set t_ga[team_count] = 0
      set t_gd[team_count] = 0
      set t_pts[team_count] = 0
      set t_order[team_count] = team_count
      set team_count + 1
   endif
enditerate
}

{+display_teams
if current_comp = 0
   execute "+no_competition"
   return
endif

escapestring escaped current_comp_name
write "<h2>Teams in " escaped "</h2>"

# COUNT EACH TEAM'S PLAYERS INTO t_p (REUSED HERE AS A SQUAD SIZE)
execute "+load_teams<current_comp"
iterate players
   set INDEX = 0
   while INDEX < team_count
      if field[1] = t_id[INDEX]
         set t_p[INDEX] + 1
      endif
      set INDEX + 1
   endwhile
enditerate

if team_count = 0
   write "<p>This competition has no teams yet.</p>"
else
   write "<table class=~league~>"
   write "<tr><th>Team</th><th>Players</th><th>Action</th></tr>"
   set INDEX = 0
   while INDEX < team_count
      escapestring escaped t_name[INDEX]
      if t_id[INDEX] = current_team
         write "<tr class=~selected~>"
      else
         write "<tr>"
      endif
      write "<td>" escaped "</td><td>" t_p[INDEX] "</td><td>"
      setstring action "squad " t_id[INDEX]
      hyperlinkNE "Squad" action
      if can_edit = true
         write " &middot; "
         setstring action "confirm delete team " t_id[INDEX]
         hyperlinkNE "Delete" action
      endif
      write "</td></tr>"
      set INDEX + 1
   endwhile
   write "</table>"
endif

if can_edit = true
   write "<h3>Add a team</h3>"
   write "<form>"
   execute "+text<Team name<team_name<40"
   execute "+submit_row<Add team"
   write "<input type=~hidden~ name=~command~ value=~add team~/>"
   hidden
   write "</form>"
else
   execute "+view_only_note"
endif

if current_team != 0
   execute "+display_squad"
endif
}

grammar add team     >add_team

{+add_team
if current_comp = 0
   write "<p class=~notice~>Select a competition before adding teams.</p>"
   return
endif
if can_edit = false
   execute "+deny"
   return
endif
ifstring team_name_data = ""
   setstring team_name_error "Please enter a team name."
   set errors + 1
   return
endif

# TEAM NAMES MUST BE UNIQUE WITHIN A COMPETITION OR THE RESULTS AND TABLE
# BECOME AMBIGUOUS
iterate teams
   if field[1] = current_comp
      ifstring field[2] = team_name_data
         set errors + 1
      endif
   endif
enditerate
if errors != 0
   setstring team_name_error "That team is already in this competition."
   return
endif

execute "+next_team_id"
append teams new_id current_comp team_name_data
escapestring escaped team_name_data
write "<p class=~notice~>Team <b>" escaped "</b> added.</p>"
}

grammar squad $integer     >squad

{+squad
set found = false
iterate teams
   ifall field[0] = $integer : field[1] = current_comp
      set found = true
      setstring current_team_name field[2]
   endif
enditerate
if found = false
   write "<p class=~notice~>That team isn't in the current competition.</p>"
   return
endif
set current_team = $integer
}

grammar delete team $integer     >delete_team

# A TEAM WITH FIXTURES CAN'T BE DELETED: THEY WOULD BE LEFT POINTING AT A
# TEAM THAT NO LONGER EXISTS AND THE OPPONENTS' TABLE ENTRIES WOULD CHANGE
{+delete_team
set delete_id = $integer
execute "+token_ok<team<delete_id"
if allowed = false
   return
endif
set target_comp = 0
iterate teams
   if field[0] = $integer
      set target_comp = field[1]
   endif
enditerate
execute "+comp_editable<target_comp"
if allowed = false
   execute "+deny"
   return
endif

set COUNT = 0
iterate fixtures
   if field[3] = $integer
      set COUNT + 1
   endif
   if field[4] = $integer
      set COUNT + 1
   endif
enditerate
if COUNT > 0
   write "<p class=~notice~>That team has " COUNT " fixture(s) or result(s). "
   write "Delete them from the <b>Fixtures &amp; results</b> tab first.</p>"
   return
endif
set new_id = $integer
execute "+purge_team<new_id"
execute "+purge_squad<new_id"
if current_team = new_id
   set current_team = 0
   setstring current_team_name ""
endif
write "<p class=~notice~>Team deleted.</p>"
}

{+purge_team
update teams
   if field[0] != arg[0]
      insert field[0] field[1] field[2]
   endif
endupdate
}

{+purge_squad
update players
   if field[1] != arg[0]
      insert field[0] field[1] field[2] field[3] field[4]
   endif
endupdate
}

{+display_squad
escapestring escaped current_team_name
write "<h2>Squad: " escaped "</h2>"
set COUNT = 0
write "<table class=~league~>"
write "<tr><th>No.</th><th>Player</th><th>Position</th><th>Action</th></tr>"
iterate players
   if field[1] = current_team
      escapestring escaped field[2]
      escapestring escaped2 field[4]
      write "<tr><td>" escaped2 "</td><td>" escaped "</td><td>" field[3] "</td><td>"
      if can_edit = true
         setstring action "confirm delete player " field[0]
         hyperlinkNE "Delete" action
      endif
      write "</td></tr>"
      set COUNT + 1
   endif
enditerate
write "</table>"
if COUNT = 0
   write "<p>No players have been added to this team yet.</p>"
endif

if can_edit = false
   return
endif
write "<h3>Add a player</h3>"
write "<form>"
execute "+text<Player name<player_name<40"
execute "+select<Position<position"
execute "+text<Shirt number<shirt<4"
execute "+submit_row<Add player"
write "<input type=~hidden~ name=~command~ value=~add player~/>"
hidden
write "</form>"
}

grammar add player     >add_player

{+add_player
if current_team = 0
   write "<p class=~notice~>Choose a team's <b>Squad</b> before adding players.</p>"
   return
endif
# current_team IS ONLY EVER SET TO A TEAM IN THE CURRENT COMPETITION
if can_edit = false
   execute "+deny"
   return
endif
ifstring player_name_data = ""
   setstring player_name_error "Please enter the player's name."
   set errors + 1
endif
ifstring position_data = ""
   setstring position_data "-"
endif
ifstring shirt_data = ""
   setstring shirt_data "-"
endif
if errors != 0
   return
endif
execute "+next_player_id"
append players new_id current_team player_name_data position_data shirt_data
escapestring escaped player_name_data
write "<p class=~notice~>" escaped " added to the squad.</p>"
}

grammar delete player $integer     >delete_player

{+delete_player
set delete_id = $integer
execute "+token_ok<player<delete_id"
if allowed = false
   return
endif
# PLAYER -> TEAM -> COMPETITION, ONE FILE AT A TIME
set new_id = 0
iterate players
   if field[0] = $integer
      set new_id = field[1]
   endif
enditerate
set target_comp = 0
iterate teams
   if field[0] = new_id
      set target_comp = field[1]
   endif
enditerate
execute "+comp_editable<target_comp"
if allowed = false
   execute "+deny"
   return
endif

update players
   if field[0] != $integer
      insert field[0] field[1] field[2] field[3] field[4]
   endif
endupdate
write "<p class=~notice~>Player deleted.</p>"
}

# -----------------------------------------------------------------------------
# RESULTS
# -----------------------------------------------------------------------------

{+display_results
if current_comp = 0
   execute "+no_competition"
   return
endif

escapestring escaped current_comp_name
write "<h2>Fixtures &amp; results in " escaped "</h2>"

execute "+load_teams<current_comp"
execute "+load_games<current_comp"

# ONE LIST IN DATE AND KICK-OFF ORDER, AS FOOTBALL SITES SHOW IT: GAMES
# ALREADY PLAYED SHOW THEIR SCORE IN PLACE OF "v", SO THE RESULTS COME FIRST
# AND THE NEXT FIXTURE FOLLOWS THE LAST RESULT
if game_count = 0
   write "<p>No fixtures have been added yet.</p>"
else
   execute "+game_table_head"
   set INDEX = 0
   while INDEX < game_count
      execute "+game_row<INDEX"
      set INDEX + 1
   endwhile
   write "</table>"
endif

if can_edit = false
   execute "+view_only_note"
   return
endif

write "<h3>Add a fixture</h3>"
if team_count < 2
   write "<p>Add at least two teams to this competition on the "
   write "<b>Teams</b> tab before adding fixtures.</p>"
   return
endif
write "<p class=~key~>To record a result, use <b>Enter result</b> next to its fixture.</p>"
write "<form>"
ifstring fixture_error != ""
   escapestring escaped fixture_error
   write "<p class=~formerror~>" escaped "</p>"
endif
execute "+default_date"
write "<div class=~row~><div class=~label~>Date:</div><div class=~input~>"
execute "+number_select<fx_day<1<31<chosen_day"
execute "+month_select<chosen_month"
set year_from = chosen_year
set year_from - 1
set year_to = chosen_year
set year_to + 2
execute "+number_select<fx_year<year_from<year_to<chosen_year"
write "</div></div>"
write "<div class=~row~><div class=~label~>Kick-off:</div><div class=~input~>"
execute "+time_select<chosen_time"
write "</div></div>"
write "<div class=~row~><div class=~label~>Home team:</div><div class=~input~>"
execute "+team_select<home_team<home_team"
write "</div></div>"
write "<div class=~row~><div class=~label~>Away team:</div><div class=~input~>"
execute "+team_select<away_team<away_team"
write "</div></div>"
execute "+submit_row<Add fixture"
write "<input type=~hidden~ name=~command~ value=~add fixture~/>"
hidden
write "</form>"
}

{+game_table_head
write "<table class=~league games~>"
write "<tr><th class=~home~>Date</th><th class=~home~>Time</th><th class=~home~>Home</th><th></th><th class=~home~>Away</th>"
if can_edit = true
   write "<th>Action</th>"
endif
write "</tr>"
}

# ONE ROW OF THE FIXTURES OR RESULTS TABLE. arg[0] = INDEX INTO THE g_* ARRAYS
{+game_row
set game_pos = arg[0]
set game_key = g_key[game_pos]
execute "+date_label<game_key"
set game_time = g_time[game_pos]
execute "+time_label<game_time"
if g_hg[game_pos] = -1
   write "<tr>"
else
   write "<tr class=~played~>"
endif
write "<td class=~date~>" date_label "</td><td class=~date~>" time_label "</td><td class=~home~>"
set game_team = g_home[game_pos]
execute "+team_label<game_team"
escapestring escaped team_label
write escaped "</td><td class=~score~>"
if g_hg[game_pos] = -1
   write "v"
else
   write g_hg[game_pos] " - " g_ag[game_pos]
endif
write "</td><td class=~home~>"
set game_team = g_away[game_pos]
execute "+team_label<game_team"
escapestring escaped team_label
write escaped "</td>"
if can_edit = true
   write "<td>"
   setstring action "score fixture " g_id[game_pos]
   if g_hg[game_pos] = -1
      hyperlinkNE "Enter result" action
      write " &middot; "
      setstring action "reschedule fixture " g_id[game_pos]
      hyperlinkNE "Change time" action
   else
      hyperlinkNE "Edit score" action
   endif
   write " &middot; "
   setstring action "confirm delete fixture " g_id[game_pos]
   hyperlinkNE "Delete" action
   write "</td>"
endif
write "</tr>"
}

# LOADS competition arg[0]'S FIXTURES INTO THE g_* ARRAYS IN DATE AND
# KICK-OFF ORDER (TBC LAST ON ITS DAY). AN INSERTION SORT AS EACH ROW
# ARRIVES: FIXTURES ARE USUALLY ADDED ROUND BY ROUND, SO MOST ROWS DON'T
# MOVE. GAMES AT THE SAME DATE AND TIME KEEP THE ORDER THEY WERE ADDED.
{+load_games
set game_count = 0
iterate fixtures
   if field[1] = arg[0]
      if game_count < MAX_GAMES
         set game_key = field[2]
         set game_time = TIME_TBC
         if field_count > 7
            set game_time = field[7]
         endif
         set game_pos = game_count
         set moving = true
         while moving = true
            if game_pos = 0
               set moving = false
            else
               set game_prev = game_pos
               set game_prev - 1
               set found = false
               if g_key[game_prev] > game_key
                  set found = true
               endif
               ifall g_key[game_prev] = game_key : g_time[game_prev] > game_time
                  set found = true
               endif
               if found = true
                  set g_id[game_pos] = g_id[game_prev]
                  set g_time[game_pos] = g_time[game_prev]
                  set g_key[game_pos] = g_key[game_prev]
                  set g_home[game_pos] = g_home[game_prev]
                  set g_away[game_pos] = g_away[game_prev]
                  set g_hg[game_pos] = g_hg[game_prev]
                  set g_ag[game_pos] = g_ag[game_prev]
                  set game_pos - 1
               else
                  set moving = false
               endif
            endif
         endwhile
         set g_id[game_pos] = field[0]
         set g_key[game_pos] = game_key
         set g_time[game_pos] = game_time
         set g_home[game_pos] = field[3]
         set g_away[game_pos] = field[4]
         set g_hg[game_pos] = -1
         set g_ag[game_pos] = -1
         ifstring field[5] != "-"
            set g_hg[game_pos] = field[5]
            set g_ag[game_pos] = field[6]
         endif
         set game_count + 1
      endif
   endif
enditerate
}

# SETS team_label TO THE NAME OF TEAM arg[0] FROM THE LOADED t_* ARRAYS
{+team_label
setstring team_label "?"
set team_scan = 0
while team_scan < team_count
   if t_id[team_scan] = arg[0]
      setstring team_label t_name[team_scan]
   endif
   set team_scan + 1
endwhile
}

# SETS date_label TO yyyymmdd arg[0] AS E.G. "Sat 21 Nov 2026". THE DAY OF
# THE WEEK IS ZELLER'S CONGRUENCE (0 = SATURDAY), TREATING JANUARY AND
# FEBRUARY AS MONTHS 13 AND 14 OF THE PREVIOUS YEAR.
{+date_label
set dl_y = arg[0]
set dl_y / 10000
set dl_m = arg[0]
set dl_m / 100
set dl_m % 100
set dl_d = arg[0]
set dl_d % 100
if dl_m < 1 : dl_m > 12
   setstring date_label "-"
   return
endif
set dl_t = dl_m
set dl_k = dl_y
if dl_t < 3
   set dl_t + 12
   set dl_k - 1
endif
set dl_j = dl_k
set dl_j / 100
set dl_k % 100
set dl_t + 1
set dl_t * 13
set dl_t / 5
set dl_h = dl_d
set dl_h + dl_t
set dl_h + dl_k
set dl_t = dl_k
set dl_t / 4
set dl_h + dl_t
set dl_t = dl_j
set dl_t / 4
set dl_h + dl_t
set dl_t = dl_j
set dl_t * 5
set dl_h + dl_t
set dl_h % 7
setstring date_label day_abbr[dl_h] " " dl_d " " month_abbr[dl_m] " " dl_y
}

# SETS time_label TO hhmm arg[0] AS E.G. "6:30pm", OR "TBC"
{+time_label
ifall arg[0] > 0 : arg[0] < TIME_TBC
   set tl_h = arg[0]
   set tl_h / 100
   set tl_m = arg[0]
   set tl_m % 100
   set dl_t = tl_h
   set dl_t % 12
   if dl_t = 0
      set dl_t = 12
   endif
   if tl_m < 10
      setstring time_label dl_t ":0" tl_m
   else
      setstring time_label dl_t ":" tl_m
   endif
   if tl_h < 12
      setstring time_label time_label "am"
   else
      setstring time_label time_label "pm"
   endif
else
   setstring time_label "TBC"
endif
}

# KICK-OFF DROP-DOWN: TBC, THEN EVERY QUARTER HOUR FROM 6:00am TO 10:45pm
# arg[0] = hhmm TO PRESELECT
{+time_select
write "<select name=~fx_time~ class=~jaclform datepart~>"
write "<option value=~" TIME_TBC "~"
if arg[0] = TIME_TBC
   write " selected"
endif
write ">TBC</option>"
set team_scan = 600
while team_scan < 2300
   execute "+time_label<team_scan"
   write "<option value=~" team_scan "~"
   if team_scan = arg[0]
      write " selected"
   endif
   write ">" time_label "</option>"
   set tl_m = team_scan
   set tl_m % 100
   if tl_m = 45
      set team_scan + 55
   else
      set team_scan + 15
   endif
endwhile
write "</select>"
}

# THE FORM STARTS AT TODAY UNTIL A DATE HAS BEEN CHOSEN
{+default_date
ifall chosen_day != 0 : chosen_month != 0 : chosen_year != 0 : chosen_time != 0
   return
endif
set gmt = unixtime
set now = +adjusted_time<gmt
execute "+process_epoch<now"
set chosen_day = TIME_date
set chosen_month = TIME_month
set chosen_month + 1
set chosen_year = TIME_year
if chosen_time = 0
   set chosen_time = TIME_TBC
endif
}

# arg[0] = field name, arg[1]..arg[2] = range, arg[3] = value to preselect
{+number_select
write "<select name=~" string_arg[0] "~ class=~jaclform datepart~>"
set team_scan = arg[1]
while team_scan <= arg[2]
   write "<option value=~" team_scan "~"
   if team_scan = arg[3]
      write " selected"
   endif
   write ">" team_scan "</option>"
   set team_scan + 1
endwhile
write "</select> "
}

# arg[0] = month to preselect
{+month_select
write "<select name=~fx_month~ class=~jaclform datepart~>"
set team_scan = 1
while team_scan <= 12
   write "<option value=~" team_scan "~"
   if team_scan = arg[0]
      write " selected"
   endif
   write ">" month_abbr[team_scan] "</option>"
   set team_scan + 1
endwhile
write "</select> "
}

# WRITES A TEAM DROP-DOWN FROM THE LOADED t_* ARRAYS
# arg[0] = field name, arg[1] = team id to preselect
{+team_select
write "<select name=~" string_arg[0] "~ class=~jaclform~>"
set team_scan = 0
while team_scan < team_count
   escapestring escaped t_name[team_scan]
   write "<option value=~" t_id[team_scan] "~"
   if t_id[team_scan] = arg[1]
      write " selected"
   endif
   write ">" escaped "</option>"
   set team_scan + 1
endwhile
write "</select>"
}

# arg[0] = field name, arg[1] = goals to preselect
{+goals_select
write "<select name=~" string_arg[0] "~ class=~jaclform goals~>"
set team_scan = 0
while team_scan < 21
   write "<option value=~" team_scan "~"
   if team_scan = arg[1]
      write " selected"
   endif
   write ">" team_scan "</option>"
   set team_scan + 1
endwhile
write "</select>"
}

grammar add fixture     >add_fixture

{+add_fixture
if current_comp = 0
   write "<p class=~notice~>Select a competition before adding fixtures.</p>"
   return
endif
if can_edit = false
   execute "+deny"
   return
endif

# REMEMBER WHAT WAS PICKED SO THE FORM COMES BACK WITH IT, RIGHT OR WRONG
if fixture_day != 0
   set chosen_day = fixture_day
endif
if fixture_month != 0
   set chosen_month = fixture_month
endif
if fixture_year != 0
   set chosen_year = fixture_year
endif
if fixture_time != 0
   set chosen_time = fixture_time
endif
execute "+validate_when"
if errors != 0
   return
endif

if home_team = away_team
   setstring fixture_error "A team can't play itself; choose two different teams."
   set errors + 1
   return
endif

# BOTH TEAMS MUST BELONG TO THE CURRENT COMPETITION
set COUNT = 0
iterate teams
   if field[1] = current_comp
      if field[0] = home_team
         set COUNT + 1
      endif
      if field[0] = away_team
         set COUNT + 1
      endif
   endif
enditerate
if COUNT != 2
   setstring fixture_error "Both teams must be in the current competition."
   set errors + 1
   return
endif

set game_key = fixture_year
set game_key * 100
set game_key + fixture_month
set game_key * 100
set game_key + fixture_day

set COUNT = 0
iterate fixtures
   if field[1] = current_comp
      if field[2] = game_key
         if field[3] = home_team
            if field[4] = away_team
               set COUNT + 1
            endif
         endif
      endif
   endif
enditerate
if COUNT != 0
   setstring fixture_error "That fixture is already on the list."
   set errors + 1
   return
endif

execute "+next_fixture_id"
append fixtures new_id current_comp game_key home_team away_team score_none score_none fixture_time
execute "+load_teams<current_comp"
execute "+date_label<game_key"
execute "+time_label<fixture_time"
setstring date_label date_label ", " time_label
write "<p class=~notice~>Fixture added: "
execute "+write_teams<home_team<away_team"
write ", " date_label ".</p>"
# THE DATE STAYS FOR THE NEXT FIXTURE OF THE ROUND; THE TEAMS DON'T
set home_team = 0
set away_team = 0
}

# CHECKS THE SUBMITTED fixture_day/month/year/time, SETTING fixture_error
# AND errors IF THEY DON'T MAKE A REAL DATE AND KICK-OFF
{+validate_when
# A PART THAT WASN'T SENT, OR WASN'T A NUMBER, IS 0
if fixture_day = 0 : fixture_month = 0 : fixture_year = 0
   setstring fixture_error "Please choose the fixture's date."
   set errors + 1
   return
endif
# THE PARAMETER RANGES STOP IMPOSSIBLE NUMBERS; THIS CATCHES 31 APRIL AND
# 29 FEBRUARY IN A NON-LEAP YEAR
set days_in_month = 31
if fixture_month = 4
   set days_in_month = 30
endif
if fixture_month = 6
   set days_in_month = 30
endif
if fixture_month = 9
   set days_in_month = 30
endif
if fixture_month = 11
   set days_in_month = 30
endif
if fixture_month = 2
   set days_in_month = 28
   execute "+is_leap_year?<fixture_year"
   if TIME_leapyear = true
      set days_in_month = 29
   endif
endif
if fixture_day > days_in_month
   setstring fixture_error "That date doesn't exist; check the day and month."
   set errors + 1
   return
endif
# ONLY THE DROP-DOWN'S VALUES (OR TBC); A HAND-MADE VALUE LIKE 1890 ISN'T A TIME
set tl_m = fixture_time
set tl_m % 100
if fixture_time != TIME_TBC
   if fixture_time = 0 : tl_m > 59 : fixture_time < 600
      setstring fixture_error "Please choose the kick-off time, or TBC."
      set errors + 1
      return
   endif
endif
}

# SETS target_comp, game_key, game_home, game_away, game_hg, game_ag AND
# date_label FROM FIXTURE arg[0]. target_comp IS 0 IF THERE'S NO SUCH FIXTURE.
{+find_fixture
set target_comp = 0
iterate fixtures
   if field[0] = arg[0]
      set target_comp = field[1]
      set game_key = field[2]
      set game_home = field[3]
      set game_away = field[4]
      set game_hg = -1
      set game_ag = -1
      ifstring field[5] != "-"
         set game_hg = field[5]
         set game_ag = field[6]
      endif
      set game_time = TIME_TBC
      if field_count > 7
         set game_time = field[7]
      endif
   endif
enditerate
execute "+date_label<game_key"
execute "+time_label<game_time"
setstring date_label date_label ", " time_label
}

# WRITES "Home v Away", OR "Home 2 - 1 Away" ONCE PLAYED, FOR THE FIXTURE
# +find_fixture LAST FOUND. NEEDS ITS COMPETITION'S TEAMS LOADED.
{+write_match
execute "+team_label<game_home"
escapestring escaped team_label
write escaped
if game_hg = -1
   write " v "
else
   write " " game_hg " - " game_ag " "
endif
execute "+team_label<game_away"
escapestring escaped team_label
write escaped
}

# arg[0] = home team id, arg[1] = away team id
{+write_teams
execute "+team_label<arg[0]"
escapestring escaped team_label
write escaped " v "
execute "+team_label<arg[1]"
escapestring escaped team_label
write escaped
}

# SHOWS THE FORM FOR ENTERING OR CORRECTING A FIXTURE'S SCORE. IT ONLY SHOWS
# A FORM, SO IT'S SAFE AS A LINK; THE CHANGE IS MADE BY 'save score'.
grammar score fixture $integer     >score_fixture

{+score_fixture
set edit_id = $integer
execute "+find_fixture<edit_id"
if target_comp = 0
   return
endif
execute "+comp_editable<target_comp"
if allowed = false
   execute "+deny"
   return
endif
execute "+load_teams<target_comp"
write "<div class=~scoreform~><p><b>"
if game_hg = -1
   write "Enter the result"
else
   write "Correct the score"
endif
write "</b> &middot; " date_label "</p>"
# EACH PART IS ITS OWN ELEMENT SO A PHONE CAN LAY IT OUT AS ONE LINE PER
# TEAM (NAME, THEN ITS GOALS) WHILE A WIDE SCREEN KEEPS "Home 2 - 1 Away"
write "<form class=~scoreentry~>"
execute "+team_label<game_home"
escapestring escaped team_label
write "<span class=~hometeam~>" escaped "</span>"
if game_hg = -1
   set game_hg = 0
   set game_ag = 0
endif
execute "+goals_select<home_goals<game_hg"
write "<span class=~dash~>-</span>"
execute "+goals_select<away_goals<game_ag"
execute "+team_label<game_away"
escapestring escaped team_label
write "<span class=~awayteam~>" escaped "</span>"
write "<input type=~hidden~ name=~command~ value=~save score " edit_id "~/>"
hidden
write "<span class=~buttons~><input type=~submit~ value=~Save result~> "
hyperlinkNE "Cancel" "blankjacl"
write "</span></form>"
execute "+find_fixture<edit_id"
if game_hg != -1
   write "<form>"
   write "<input type=~hidden~ name=~command~ value=~clear score " edit_id "~/>"
   hidden
   write "<input type=~submit~ value=~Clear result~> "
   write "<span class=~key~>(back to a fixture not yet played)</span>"
   write "</form>"
endif
write "</div>"
}

# SHOWS THE FORM FOR MOVING A FIXTURE TO ANOTHER KICK-OFF OR DATE. LIKE
# 'score fixture' IT ONLY SHOWS A FORM; 'save schedule' MAKES THE CHANGE.
grammar reschedule fixture $integer     >reschedule_fixture

{+reschedule_fixture
set edit_id = $integer
execute "+find_fixture<edit_id"
if target_comp = 0
   return
endif
execute "+comp_editable<target_comp"
if allowed = false
   execute "+deny"
   return
endif
execute "+schedule_form<edit_id"
}

# WRITES THE RESCHEDULE FORM FOR FIXTURE arg[0], PRESELECTING THE DATE AND
# KICK-OFF +find_fixture LAST FOUND
{+schedule_form
execute "+load_teams<target_comp"
write "<div class=~scoreform~><p><b>Change the kick-off</b> &middot; "
execute "+write_match"
write "</p><form>"
set dl_y = game_key
set dl_y / 10000
set dl_m = game_key
set dl_m / 100
set dl_m % 100
set dl_d = game_key
set dl_d % 100
execute "+number_select<fx_day<1<31<dl_d"
execute "+month_select<dl_m"
set year_from = dl_y
set year_from - 1
set year_to = dl_y
set year_to + 2
execute "+number_select<fx_year<year_from<year_to<dl_y"
write " &nbsp; "
execute "+time_select<game_time"
write " &nbsp; <input type=~hidden~ name=~command~ value=~save schedule " arg[0] "~/>"
hidden
write "<input type=~submit~ value=~Save~> &nbsp; "
hyperlinkNE "Cancel" "blankjacl"
write "</form></div>"
}

grammar save schedule $integer     >save_schedule

{+save_schedule
set edit_id = $integer
execute "+find_fixture<edit_id"
if target_comp = 0
   return
endif
execute "+comp_editable<target_comp"
if allowed = false
   execute "+deny"
   return
endif
execute "+validate_when"
if errors != 0
   escapestring escaped fixture_error
   write "<p class=~notice~>" escaped "</p>"
   setstring fixture_error ""
   execute "+schedule_form<edit_id"
   return
endif
set game_key = fixture_year
set game_key * 100
set game_key + fixture_month
set game_key * 100
set game_key + fixture_day
execute "+set_when<edit_id<game_key<fixture_time"
execute "+find_fixture<edit_id"
execute "+load_teams<target_comp"
write "<p class=~notice~>Moved: "
execute "+write_match"
write ", now " date_label ".</p>"
}

# REWRITES FIXTURE arg[0] WITH DATE arg[1] (yyyymmdd) AND KICK-OFF arg[2]
{+set_when
update fixtures
   setstring row_time "2400"
   if field_count > 7
      setstring row_time field[7]
   endif
   if field[0] = arg[0]
      insert field[0] field[1] arg[1] field[3] field[4] field[5] field[6] arg[2]
   else
      insert field[0] field[1] field[2] field[3] field[4] field[5] field[6] row_time
   endif
endupdate
}

grammar save score $integer     >save_score

{+save_score
set edit_id = $integer
execute "+find_fixture<edit_id"
if target_comp = 0
   return
endif
execute "+comp_editable<target_comp"
if allowed = false
   execute "+deny"
   return
endif
execute "+set_score<edit_id<home_goals<away_goals"
execute "+find_fixture<edit_id"
execute "+load_teams<target_comp"
write "<p class=~notice~>Result saved: "
execute "+write_match"
write ".</p>"
}

grammar clear score $integer     >clear_score

{+clear_score
set edit_id = $integer
execute "+find_fixture<edit_id"
if target_comp = 0
   return
endif
execute "+comp_editable<target_comp"
if allowed = false
   execute "+deny"
   return
endif
set game_hg = -1
execute "+set_score<edit_id<game_hg<game_hg"
write "<p class=~notice~>Result cleared; it's back in the fixtures.</p>"
}

# REWRITES FIXTURE arg[0] WITH SCORE arg[1] - arg[2], OR AS NOT PLAYED IF
# arg[1] IS -1
{+set_score
update fixtures
   # field[] ISN'T CLEARED BETWEEN ROWS, SO CHECK A KICK-OFF IS REALLY THERE
   setstring row_time "2400"
   if field_count > 7
      setstring row_time field[7]
   endif
   if field[0] = arg[0]
      if arg[1] = -1
         insert field[0] field[1] field[2] field[3] field[4] score_none score_none row_time
      else
         insert field[0] field[1] field[2] field[3] field[4] arg[1] arg[2] row_time
      endif
   else
      insert field[0] field[1] field[2] field[3] field[4] field[5] field[6] row_time
   endif
endupdate
}

grammar delete fixture $integer     >delete_fixture

{+delete_fixture
set edit_id = $integer
execute "+token_ok<fixture<edit_id"
if allowed = false
   return
endif
execute "+find_fixture<edit_id"
if target_comp = 0
   return
endif
execute "+comp_editable<target_comp"
if allowed = false
   execute "+deny"
   return
endif
execute "+remove_fixture<edit_id"
if game_hg = -1
   write "<p class=~notice~>Fixture deleted.</p>"
else
   write "<p class=~notice~>Result deleted.</p>"
endif
}

{+remove_fixture
update fixtures
   setstring row_time "2400"
   if field_count > 7
      setstring row_time field[7]
   endif
   if field[0] != arg[0]
      insert field[0] field[1] field[2] field[3] field[4] field[5] field[6] row_time
   endif
endupdate
}

# -----------------------------------------------------------------------------
# LEAGUE TABLE
# -----------------------------------------------------------------------------

{+display_table
if current_comp = 0
   execute "+no_competition"
   return
endif

escapestring escaped current_comp_name
write "<h2>" escaped " league table</h2>"

execute "+load_teams<current_comp"
if team_count = 0
   write "<p>This competition has no teams yet.</p>"
   return
endif

# ONE PASS OVER THE RESULTS ACCUMULATING EACH TEAM'S RECORD. THREE POINTS
# FOR A WIN, ONE FOR A DRAW.
iterate fixtures
   set found = false
   if field[1] = current_comp
      # FIXTURES NOT YET PLAYED HAVE "-" FOR THE GOALS
      ifstring field[5] != "-"
         set found = true
      endif
   endif
   if found = true
      set home_index = -1
      set away_index = -1
      set INDEX = 0
      while INDEX < team_count
         if t_id[INDEX] = field[3]
            set home_index = INDEX
         endif
         if t_id[INDEX] = field[4]
            set away_index = INDEX
         endif
         set INDEX + 1
      endwhile
      ifall home_index != -1 : away_index != -1
         set goals_for = field[5]
         set goals_against = field[6]
         set t_p[home_index] + 1
         set t_p[away_index] + 1
         set t_gf[home_index] + goals_for
         set t_ga[home_index] + goals_against
         set t_gf[away_index] + goals_against
         set t_ga[away_index] + goals_for
         if goals_for > goals_against
            set t_w[home_index] + 1
            set t_l[away_index] + 1
            set t_pts[home_index] + 3
         endif
         if goals_for < goals_against
            set t_w[away_index] + 1
            set t_l[home_index] + 1
            set t_pts[away_index] + 3
         endif
         if goals_for = goals_against
            set t_d[home_index] + 1
            set t_d[away_index] + 1
            set t_pts[home_index] + 1
            set t_pts[away_index] + 1
         endif
      endif
   endif
enditerate

set INDEX = 0
while INDEX < team_count
   set t_gd[INDEX] = t_gf[INDEX]
   set t_gd[INDEX] - t_ga[INDEX]
   set INDEX + 1
endwhile

# BUBBLE SORT t_order. EACH PASS IS ITS OWN FUNCTION BECAUSE A while CAN'T
# BE NESTED INSIDE ANOTHER while IN THE SAME FUNCTION.
set swapped = true
while swapped = true
   execute "+sort_pass"
endwhile

write "<table class=~league standings~>"
write "<tr><th>Pos</th><th class=~home~>Team</th><th>P</th><th>W</th><th>D</th><th>L</th>"
write "<th>GF</th><th>GA</th><th>GD</th><th>Pts</th></tr>"
set INDEX = 0
while INDEX < team_count
   set sort_a = t_order[INDEX]
   set COUNT = INDEX
   set COUNT + 1
   escapestring escaped t_name[sort_a]
   write "<tr><td>" COUNT "</td><td class=~home~>" escaped "</td>"
   write "<td>" t_p[sort_a] "</td><td>" t_w[sort_a] "</td><td>" t_d[sort_a] "</td><td>" t_l[sort_a] "</td>"
   write "<td>" t_gf[sort_a] "</td><td>" t_ga[sort_a] "</td><td>" t_gd[sort_a] "</td>"
   write "<td class=~points~>" t_pts[sort_a] "</td></tr>"
   set INDEX + 1
endwhile
write "</table>"
write "<p class=~key~>Ordered by points, then goal difference, then goals scored. "
write "Three points for a win, one for a draw.</p>"
}

# ONE BUBBLE-SORT PASS OVER t_order, SETTING swapped IF ANYTHING MOVED
{+sort_pass
set swapped = false
set INDEX = 0
set COUNT = team_count
set COUNT - 1
while INDEX < COUNT
   set sort_a = t_order[INDEX]
   set new_id = INDEX
   set new_id + 1
   set sort_b = t_order[new_id]
   set found = false
   if t_pts[sort_b] > t_pts[sort_a]
      set found = true
   endif
   ifall t_pts[sort_b] = t_pts[sort_a] : t_gd[sort_b] > t_gd[sort_a]
      set found = true
   endif
   ifall t_pts[sort_b] = t_pts[sort_a] : t_gd[sort_b] = t_gd[sort_a] : t_gf[sort_b] > t_gf[sort_a]
      set found = true
   endif
   if found = true
      set t_order[INDEX] = sort_b
      set t_order[new_id] = sort_a
      set swapped = true
   endif
   set INDEX + 1
endwhile
}

# -----------------------------------------------------------------------------
# DELETE CONFIRMATIONS. EACH CHECKS PERMISSION SO IT DOESN'T OFFER A DELETE
# THAT WOULD BE REFUSED, NAMES WHAT WILL GO, AND HANDS OVER TO +confirm_form.
# THE DELETE HANDLERS CHECK EVERYTHING AGAIN.
# -----------------------------------------------------------------------------

grammar confirm delete competition $integer     >confirm_delete_competition

{+confirm_delete_competition
set delete_id = $integer
execute "+comp_manageable<delete_id"
if allowed = false
   execute "+deny_manage"
   return
endif
set found = false
iterate competitions
   if field[0] = delete_id
      set found = true
      escapestring escaped field[1]
   endif
enditerate
if found = false
   return
endif
write "<div class=~confirm~><p>Delete the competition <b>" escaped "</b>? "
write "This also deletes all its teams, their players, its fixtures and results and its "
write "organisers, and can't be undone.</p>"
execute "+confirm_form<competition<delete_id"
}

grammar confirm delete team $integer     >confirm_delete_team

{+confirm_delete_team
set delete_id = $integer
set target_comp = 0
iterate teams
   if field[0] = delete_id
      set target_comp = field[1]
      escapestring escaped field[2]
   endif
enditerate
execute "+comp_editable<target_comp"
if allowed = false
   execute "+deny"
   return
endif
set COUNT = 0
iterate fixtures
   if field[3] = delete_id
      set COUNT + 1
   endif
   if field[4] = delete_id
      set COUNT + 1
   endif
enditerate
if COUNT > 0
   write "<p class=~notice~>That team has " COUNT " fixture(s) or result(s). "
   write "Delete them from the <b>Fixtures &amp; results</b> tab first.</p>"
   return
endif
write "<div class=~confirm~><p>Delete the team <b>" escaped "</b> and its squad?</p>"
execute "+confirm_form<team<delete_id"
}

grammar confirm delete player $integer     >confirm_delete_player

{+confirm_delete_player
set delete_id = $integer
set new_id = 0
iterate players
   if field[0] = delete_id
      set new_id = field[1]
      escapestring escaped field[2]
   endif
enditerate
set target_comp = 0
iterate teams
   if field[0] = new_id
      set target_comp = field[1]
   endif
enditerate
execute "+comp_editable<target_comp"
if allowed = false
   execute "+deny"
   return
endif
write "<div class=~confirm~><p>Remove <b>" escaped "</b> from the squad?</p>"
execute "+confirm_form<player<delete_id"
}

grammar confirm delete fixture $integer     >confirm_delete_fixture

{+confirm_delete_fixture
set edit_id = $integer
execute "+find_fixture<edit_id"
if target_comp = 0
   return
endif
execute "+comp_editable<target_comp"
if allowed = false
   execute "+deny"
   return
endif
execute "+load_teams<target_comp"
write "<div class=~confirm~><p>Delete the "
if game_hg = -1
   write "fixture"
else
   write "result"
endif
write " <b>"
execute "+write_match"
write "</b> (" date_label ")?</p>"
execute "+confirm_form<fixture<edit_id"
}

# -----------------------------------------------------------------------------
# ORGANISERS: PEOPLE THE OWNER LETS CHANGE A COMPETITION'S TEAMS, PLAYERS
# AND RESULTS. ONLY THE OWNER AND ADMINS SEE OR CHANGE THE LIST.
# -----------------------------------------------------------------------------

{+display_organisers
escapestring escaped current_comp_name
write "<h3>Organisers of " escaped "</h3>"
write "<p class=~key~>Organisers can change this competition's teams, players "
write "and results, as well as whoever created it and the site admins.</p>"

# ORGANISERS AND OPEN INVITES ARE ONE LIST: AN INVITE IS AN ORGANISER WHO
# HASN'T ACCEPTED YET, AND THEIR ROW TURNS INTO AN ORGANISER ROW WHEN THEY DO.
# THE TABLE STARTS AT THE FIRST ROW, SO AN EMPTY LIST IS JUST A LINE
set COUNT = 0
iterate organisers
   if field[1] = current_comp
      if COUNT = 0
         execute "+organiser_table_head"
      endif
      escapestring escaped field[3]
      escapestring escaped2 field[2]
      write "<tr><td class=~home~>" escaped "</td><td class=~home~ title=~Account ID "
      write escaped2 "~>Organiser</td><td>"
      setstring action "confirm delete organiser " field[0]
      hyperlinkNE "Remove" action
      write "</td></tr>"
      set COUNT + 1
   endif
enditerate
set now_time = unixtime
set invite_count = 0
iterate invites
   if field[2] = current_comp
      if field[3] > now_time
         if COUNT = 0
            execute "+organiser_table_head"
         endif
         escapestring escaped field[4]
         set invite_days = field[3]
         set invite_days - now_time
         set invite_days + 86399
         set invite_days / 86400
         write "<tr><td class=~home~>" escaped "</td><td class=~home~>Invited &middot; "
         write "<input class=~invitelink~ readonly size=~26~ value=~?invite=" field[1] "~> "
         write "<button type=~button~ onclick=~navigator.clipboard.writeText(this.previousElementSibling.value); this.textContent = 'Copied';~>Copy</button>"
         write " <span class=~expires~>link works once, expires in " invite_days " day"
         if invite_days != 1
            write "s"
         endif
         write "</span></td><td>"
         setstring action "confirm delete invite " field[0]
         hyperlinkNE "Cancel" action
         write "</td></tr>"
         set COUNT + 1
         set invite_count + 1
      endif
   endif
enditerate
if COUNT != 0
   write "</table>"
else
   write "<p>No organisers yet: only "
   ifstring current_comp_owner = google_sub
      write "you"
   else
      ifstring current_comp_owner = "-"
         write "site admins"
      else
         write "its creator and site admins"
      endif
   endif
   write " can change this competition.</p>"
endif
if invite_count != 0
   write "<script>document.querySelectorAll('input.invitelink').forEach(function(i) { "
   write "if (i.value.charAt(0) == '?') i.value = location.origin + location.pathname + i.value; });</script>"
endif

write "<div class=~addway~>"
write "<h4>Invite an organiser</h4>"
write "<p class=~key~>Enter their name and create a link, then send it to them "
write "by message or email. When they open it and sign in with Google, they "
write "become an organiser. Each link works once and expires after 7 days.</p>"
write "<form>"
execute "+text<Their name<invite_name<30"
execute "+submit_row<Create invite link"
write "<input type=~hidden~ name=~command~ value=~create invite~/>"
hidden
write "</form>"

# THE OLDER WAY, KEPT FOR SOMEONE ALREADY SIGNED IN BUT FOLDED AWAY SINCE AN
# INVITE LINK COVERS THEM TOO
write "<details><summary>Add someone who has already signed in, by account ID</summary>"
write "<p class=~key~>Their account ID is shown at the bottom of their "
write "Competitions tab. Ask them for it and they're added straight away, with "
write "no link to send.</p>"
write "<form>"
execute "+text<Name<organiser_name<30"
execute "+text<Account ID<organiser_id<30"
execute "+submit_row<Add organiser"
write "<input type=~hidden~ name=~command~ value=~add organiser~/>"
hidden
write "</form>"
write "</details>"
write "</div>"
}

{+organiser_table_head
write "<table class=~league~>"
write "<tr><th class=~home~>Name</th><th class=~home~>Status</th><th>Action</th></tr>"
}

{+next_organiser_id
set new_id = 0
iterate organisers
   if field[0] > new_id
      set new_id = field[0]
   endif
enditerate
set new_id + 1
}

grammar add organiser     >add_organiser

{+add_organiser
if can_manage = false
   execute "+deny_manage"
   return
endif
ifstring organiser_name_data = ""
   setstring organiser_name_error "Please enter their name."
   set errors + 1
endif
ifstring organiser_id_data = ""
   setstring organiser_id_error "Please enter their account ID."
   set errors + 1
endif
if errors != 0
   return
endif
ifstring organiser_id_data = current_comp_owner
   setstring organiser_id_error "That's the competition's creator, who can already change it."
   set errors + 1
   return
endif
iterate organisers
   if field[1] = current_comp
      ifstring field[2] = organiser_id_data
         set errors + 1
      endif
   endif
enditerate
if errors != 0
   setstring organiser_id_error "They're already an organiser."
   return
endif
execute "+next_organiser_id"
append organisers new_id current_comp organiser_id_data organiser_name_data
escapestring escaped organiser_name_data
write "<p class=~notice~>" escaped " can now change this competition.</p>"
}

grammar confirm delete organiser $integer     >confirm_delete_organiser

{+confirm_delete_organiser
set delete_id = $integer
set target_comp = 0
iterate organisers
   if field[0] = delete_id
      set target_comp = field[1]
      escapestring escaped field[3]
   endif
enditerate
execute "+comp_manageable<target_comp"
if allowed = false
   execute "+deny_manage"
   return
endif
write "<div class=~confirm~><p>Stop <b>" escaped "</b> being an organiser?</p>"
execute "+confirm_form<organiser<delete_id"
}

grammar delete organiser $integer     >delete_organiser

{+delete_organiser
set delete_id = $integer
execute "+token_ok<organiser<delete_id"
if allowed = false
   return
endif
set target_comp = 0
iterate organisers
   if field[0] = delete_id
      set target_comp = field[1]
   endif
enditerate
execute "+comp_manageable<target_comp"
if allowed = false
   execute "+deny_manage"
   return
endif
update organisers
   if field[0] != delete_id
      insert field[0] field[1] field[2] field[3]
   endif
endupdate
write "<p class=~notice~>Organiser removed.</p>"
execute "+refresh_permissions"
}

# PENDING INVITES FOR THE CURRENT COMPETITION, EACH WITH ITS LINK. THE PAGE
# ONLY KNOWS ITS OWN ADDRESS IN THE BROWSER, SO THE LINKS ARE WRITTEN AS
# ?invite=... AND A SCRIPT MAKES THEM ABSOLUTE.
grammar create invite     >create_invite

{+create_invite
if can_manage = false
   execute "+deny_manage"
   return
endif
ifstring invite_name_data = ""
   setstring invite_name_error "Please enter the name of the person you're inviting."
   set errors + 1
   return
endif
execute "+purge_expired_invites"
# THREE DRAWS OF 900000 (random COMES FROM THE OS'S SECURE SOURCE): ABOUT
# 59 BITS, FAR TOO MANY TO GUESS. EACH PART IS SIX DIGITS SO EVERY CODE LOOKS THE SAME.
set max_rand = 900000
set invite_id = random
set invite_id + 99999
setstring invite_code invite_id
set invite_id = random
set invite_id + 99999
setstring invite_code invite_code "-" invite_id
set invite_id = random
set invite_id + 99999
setstring invite_code invite_code "-" invite_id
set new_id = 0
iterate invites
   if field[0] > new_id
      set new_id = field[0]
   endif
enditerate
set new_id + 1
set invite_expires = unixtime
set invite_days = INVITE_DAYS
set invite_days * 86400
set invite_expires + invite_days
append invites new_id invite_code current_comp invite_expires invite_name_data
escapestring escaped invite_name_data
write "<p class=~notice~>Invite link for " escaped " created: copy it from "
write "<b>Invite an organiser</b> below and send it to them.</p>"
}

# RUN ON EVERY FULL PAGE LOAD. IF THE ADDRESS CARRIED ?invite=..., ACCEPT IT
# ONCE THE VISITOR IS SIGNED IN, OR ASK THEM TO SIGN IN. LEAVES ITS MESSAGE
# IN invite_message FOR +after TO SHOW ABOVE THE TAB.
{+check_invite
ifstring invite_data = ""
   return
endif
set invite_id = 0
set now_time = unixtime
iterate invites
   ifstring field[1] = invite_data
      set invite_id = field[0]
      set invite_comp = field[2]
      set invite_expires = field[3]
      setstring invite_name_data field[4]
   endif
enditerate
if invite_id = 0
   setstring invite_message "<p class=~notice~>That invite link has already been used or cancelled. Ask for a new one.</p>"
   setstring invite_data ""
   setstring invite_name_data ""
   return
endif
if invite_expires <= now_time
   setstring invite_message "<p class=~notice~>That invite link has expired. Ask for a new one.</p>"
   setstring invite_data ""
   setstring invite_name_data ""
   return
endif
setstring invite_comp_name ""
iterate competitions
   if field[0] = invite_comp
      escapestring invite_comp_name field[1]
   endif
enditerate
set WEBAPP_mode = COMPETITIONS
if google_signed_in = false
   # KEEP invite_data: SIGNING IN RELOADS THIS ADDRESS AND COMES BACK HERE
   setstring invite_message "<p class=~notice~>You've been invited to help run <b>" invite_comp_name "</b>. Sign in with Google (the button at the bottom right of the banner) to accept.</p>"
   setstring invite_name_data ""
   return
endif
set current_comp = invite_comp
setstring invite_data ""
execute "+comp_editable<invite_comp"
if allowed = true
   # PROBABLY THE OWNER CHECKING THEIR OWN LINK: LEAVE IT FOR ITS RECIPIENT
   setstring invite_message "<p class=~notice~>You can already change <b>" invite_comp_name "</b>, so this invite hasn't been used. Send the link to the person it's for.</p>"
   setstring invite_name_data ""
   execute "+refresh_permissions"
   return
endif
execute "+next_organiser_id"
append organisers new_id invite_comp google_sub invite_name_data
execute "+remove_invite<invite_id"
setstring invite_name_data ""
setstring invite_message "<p class=~notice~>Welcome! You're now an organiser of <b>" invite_comp_name "</b> and can change its teams, players and results.</p>"
execute "+refresh_permissions"
}

{+remove_invite
update invites
   if field[0] != arg[0]
      insert field[0] field[1] field[2] field[3] field[4]
   endif
endupdate
}

{+purge_invites
update invites
   if field[2] != arg[0]
      insert field[0] field[1] field[2] field[3] field[4]
   endif
endupdate
}

{+purge_expired_invites
set now_time = unixtime
update invites
   if field[3] > now_time
      insert field[0] field[1] field[2] field[3] field[4]
   endif
endupdate
}

grammar confirm delete invite $integer     >confirm_delete_invite

{+confirm_delete_invite
set delete_id = $integer
set target_comp = 0
iterate invites
   if field[0] = delete_id
      set target_comp = field[2]
      escapestring escaped field[4]
   endif
enditerate
execute "+comp_manageable<target_comp"
if allowed = false
   execute "+deny_manage"
   return
endif
write "<div class=~confirm~><p>Cancel the invite for <b>" escaped "</b>? Its link will stop working.</p>"
execute "+confirm_form<invite<delete_id"
}

grammar delete invite $integer     >delete_invite

{+delete_invite
set delete_id = $integer
execute "+token_ok<invite<delete_id"
if allowed = false
   return
endif
set target_comp = 0
iterate invites
   if field[0] = delete_id
      set target_comp = field[2]
   endif
enditerate
execute "+comp_manageable<target_comp"
if allowed = false
   execute "+deny_manage"
   return
endif
execute "+remove_invite<delete_id"
write "<p class=~notice~>Invite cancelled.</p>"
}

{+purge_organisers
update organisers
   if field[1] != arg[0]
      insert field[0] field[1] field[2] field[3]
   endif
endupdate
}

# -----------------------------------------------------------------------------
# STYLES. NO LINE MAY START WITH A '.' (IT WOULD END THE print: BLOCK), SO
# EVERY CLASS SELECTOR IS QUALIFIED WITH ITS ELEMENT NAME.
# -----------------------------------------------------------------------------

# GOOGLE'S SIGN-IN BUTTON ARRIVES IN TWO STEPS: ITS SCRIPT FIRST DRAWS A
# PLAIN STAND-IN BUTTON IN THE PAGE, THEN ABOUT HALF A SECOND LATER ITS REAL
# BUTTON LOADS IN A FRAME OF A DIFFERENT SIZE, BOTH SHOWING FOR A MOMENT
# BEFORE THE STAND-IN COLLAPSES. THAT SWAP IS THE FLICKER. KEEP THE SLOT
# INVISIBLE (IT STILL TAKES ITS SPACE) UNTIL THE FRAME HAS A SIZE, THE
# STAND-IN HAS GONE AND NOTHING HAS CHANGED FOR 0.2s, THEN FADE IT IN. AFTER
# 3s SHOW WHATEVER IS THERE (THE FRAME NEVER LOADS ON AN ORIGIN GOOGLE
# HASN'T AUTHORISED, SUCH AS A LOCAL TEST SERVER). A SIGNED-IN VISITOR SEES
# PLAIN TEXT THERE, SO NOTHING WAITS.
{+local_header
ifstring google_client_id = ""
   return
endif
write "<script>document.addEventListener('DOMContentLoaded', function() { "
write "var s = document.getElementById('jaclAuthSlot'); "
write "if (!s || window.JACL_GOOGLE_SIGNED_IN) return; "
write "s.classList.add('settling'); "
write "var last = '', same = 0, ticks = 0; "
write "var t = setInterval(function() { "
write "ticks++; var f = s.querySelector('iframe'), c = s.firstElementChild, k = ''; "
write "if (f && c && f.offsetWidth > 0 && c.firstElementChild && c.firstElementChild.offsetHeight == 0) "
write "k = f.offsetWidth + 'x' + f.offsetHeight + '/' + c.offsetHeight; "
write "if (k && k == last) same++; else same = 0; last = k; "
write "if (same >= 2 || ticks >= 30) { clearInterval(t); s.classList.remove('settling'); } "
write "}, 100); });</script>"
}

{+user_styles
print:
   <style>^
   div#header { position: relative; overflow: hidden; height: auto; }^
   div#header::before { content: ""; position: absolute; top: -30px; left: -30px; right: -30px; bottom: -30px; background: url(/images/offside.jpg) center / cover; filter: blur(16px) brightness(0.5); }^
   div#headerimages { position: relative; z-index: 1; }^
   img.titleimage { display: block; margin: 0px auto; width: 100%; max-width: 1800px; height: min(25vw, 280px); object-fit: cover; object-position: center 55%; }^
   div.linkbar { display: none; }^
   div.links { position: absolute; z-index: 1; top: auto; right: 0px; bottom: 6px; color: white; text-shadow: 0 0 4px black; }^
   h2 { font-family: Verdana, Arial, sans-serif; font-size: 16pt; margin: 18px 0 8px 0; }^
   h3 { font-family: Verdana, Arial, sans-serif; font-size: 12pt; margin: 22px 0 6px 0; }^
   table.league { border-collapse: collapse; font-family: Verdana, Arial, sans-serif; font-size: 11pt; min-width: 50%; }^
   table.league th { background-color: #2e5e2e; color: white; padding: 5px 10px; text-align: center; }^
   table.league td { padding: 4px 10px; border-bottom: 1px solid #b8c8b8; text-align: center; }^
   table.league th.home, table.league td.home { text-align: left; }^
   table.league td.score { font-weight: bold; white-space: nowrap; }^
   table.league td.points { font-weight: bold; }^
   table.league tr.selected td { background-color: #d8ead8; }^
   table.standings tr:nth-child(even) td { background-color: #eef4ee; }^
   p.notice { background-color: #fff6d0; border: 1px solid #d8c070; padding: 6px 10px; }^
   p.key { font-size: 9pt; color: #555555; }^
   div.addway { border-top: 1px solid #b8c8b8; margin-top: 20px; padding-top: 2px; max-width: 920px; }^
   div.addway h4 { margin: 12px 0 2px 0; }^
   div.addway p.key { margin-top: 2px; }^
   div.addway details { margin-top: 14px; }^
   div.addway summary { cursor: pointer; font-size: 10pt; color: #2e5e2e; }^
   span.expires { font-size: 9pt; color: #555555; white-space: nowrap; }^
   span.authslot { display: inline-block; vertical-align: middle; margin-left: 14px; text-shadow: none; }^
   span.authslot a.signout { text-shadow: 0 0 4px black; }^
   span.authslot { transition: opacity 0.3s ease-in; }^
   span.authslot.settling { opacity: 0; }^
   a.signout { color: white; font-size: 10pt; }^
   div.confirm { background-color: #fbe9e7; border: 1px solid #c62828; padding: 6px 14px 12px 14px; margin-bottom: 14px; font-family: Verdana, Arial, sans-serif; }^
   input.danger { background-color: #c62828; color: white; border: none; padding: 4px 14px; }^
   p.formerror { color: #a02020; font-family: Verdana, Arial, sans-serif; }^
   select.goals { width: 4em; }^
   table.league td.date { text-align: left; white-space: nowrap; }^
   table.games { table-layout: fixed; width: 100%; max-width: 64em; }^
   table.games th:nth-child(1) { width: 9.5em; }^
   table.games th:nth-child(2) { width: 4.5em; }^
   table.games th:nth-child(4) { width: 4em; }^
   table.games th:nth-child(6) { width: 22em; }^
   table.games td:nth-child(6) { white-space: nowrap; }^
   table.games td { overflow: hidden; text-overflow: ellipsis; }^
   table.games tr.played td { background-color: #eef4ee; }^
   select.datepart { width: auto; margin-right: 4px; }^
   div.scoreform { background-color: #e6f2e6; border: 1px solid #2e5e2e; padding: 6px 14px 12px 14px; margin-bottom: 14px; font-family: Verdana, Arial, sans-serif; }^
   div.scoreform form { display: inline-block; margin-right: 12px; }^
   form.scoreentry span { margin: 0 4px; }^
   form.scoreentry span.buttons { margin-left: 14px; }^
   form.scoreentry span.buttons a { margin-left: 8px; }^
   @media (max-width: 700px) {^
      div#main { padding: 12px 10px; }^
      h2 { font-size: 14pt; margin-top: 4px; }^
      div.links { position: relative; top: auto; bottom: auto; right: auto; display: flex; align-items: center; justify-content: space-between; gap: 8px; height: 40px; box-sizing: border-box; padding: 0 10px; font-size: 10pt; text-align: left; white-space: nowrap; }^
      span#compname { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; }^
      span.authslot { margin-left: auto; flex: none; }^
      div.mode { align-items: stretch; }^
      div#header::before { background-image: url(/images/offside-mobile.jpg); }^
      div.tab, div.selectedtab { flex: 1 1 0; min-width: 0; padding: 0; height: auto; line-height: 1.25; display: flex; align-items: center; justify-content: center; font-size: 10pt; }^
      div.selectedtab { padding: 10px 3px; }^
      a.tablink { display: block; width: 100%; padding: 10px 3px; font-size: 10pt; }^
      table.league { font-size: 10pt; min-width: 0; width: 100%; }^
      table.league th, table.league td { padding: 5px 3px; }^
      table.games, table.games tbody { display: block; width: 100%; max-width: none; }^
      table.games tr:has(th) { display: none; }^
      table.games tr { display: grid; grid-template-columns: 1fr auto 1fr; column-gap: 10px; padding: 8px 4px; border-bottom: 1px solid #b8c8b8; }^
      table.games tr.played { background-color: #eef4ee; }^
      table.games td { display: block; border: none; padding: 0; overflow: visible; white-space: normal; background: none; }^
      table.games tr.played td { background: none; }^
      table.games td:nth-child(1) { grid-column: 1 / 3; grid-row: 1; font-size: 9pt; color: #555555; }^
      table.games td:nth-child(2) { grid-column: 3; grid-row: 1; font-size: 9pt; color: #555555; text-align: right; }^
      table.games td:nth-child(3) { grid-column: 1; grid-row: 2; text-align: right; padding-top: 3px; }^
      table.games td:nth-child(4) { grid-column: 2; grid-row: 2; text-align: center; padding-top: 3px; }^
      table.games td:nth-child(5) { grid-column: 3; grid-row: 2; text-align: left; padding-top: 3px; }^
      table.games td:nth-child(6) { grid-column: 1 / 4; grid-row: 3; text-align: center; white-space: normal; padding-top: 2px; }^
      table.games td:nth-child(6) a { display: inline-block; padding: 8px 6px; font-size: 11pt; }^
      div.row { display: block; margin-bottom: 8px; }^
      div.label { float: none; display: block; width: auto; text-align: left; margin: 0 0 2px 0; }^
      div.input { float: none; display: block; margin: 0; }^
      input, select { font-size: 16px; max-width: 100%; }^
      div.scoreform { padding: 6px 10px 12px 10px; }^
      div.scoreform form { display: block; margin: 8px 0 0 0; }^
      div.scoreform form.scoreentry { display: grid; grid-template-columns: 1fr auto; gap: 10px 12px; align-items: center; }^
      form.scoreentry select { width: 5em; }^
      form.scoreentry span { margin: 0; }^
      form.scoreentry span.hometeam { grid-row: 1; grid-column: 1; }^
      form.scoreentry select:nth-of-type(1) { grid-row: 1; grid-column: 2; }^
      form.scoreentry span.dash { display: none; }^
      form.scoreentry span.awayteam { grid-row: 2; grid-column: 1; }^
      form.scoreentry select:nth-of-type(2) { grid-row: 2; grid-column: 2; }^
      form.scoreentry span.buttons { grid-row: 3; grid-column: 1 / 3; margin: 4px 0 0 0; }^
      form.scoreentry span.buttons input { padding: 8px 18px; }^
      form.scoreentry span.buttons a { margin-left: 16px; }^
   }^
   </style>^
.
}

location stadium

object you

constant title_image         "/images/offside.jpg"
constant desktop_title_image "/images/offside.jpg"
# A PHONE GETS A LIGHTER COPY OF THE BANNER: 1200px WIDE IS STILL SHARP ON A
# 3x SCREEN, AT A FIFTH OF THE SIZE, WHICH MATTERS ON MOBILE DATA AT THE GROUND
constant mobile_title_image  "/images/offside-mobile.jpg"
constant footer_image        "none"
constant header_colour       "#1e3e1e"
constant header_height       280
constant linkbar_colour      "#c0b098"
constant maintext_colour     "#dddddd"
constant tab_colour          "#2e5e2e"

#include "forms.library"
#include "time.library"
#include "webapp.library"
#include "webapp.css"
