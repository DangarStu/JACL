#!../bin/jacl
#                                                                    KEHIDUPAN DESA
# -----------------------------------------------------------------------------
# An Indonesian language learning game set in a Balinese village.
# -----------------------------------------------------------------------------

constant game_title		"Kehidupan Desa"
constant game_author	"Stuart Allen"
constant game_version	1
constant game_publish true

constant header_colour "#5a7a3a"
constant linkbar_colour "#6e8c52"
constant maintext_colour "#f5f0e8"

# -----------------------------------------------------------------------------
# LOCATIONS
# -----------------------------------------------------------------------------

location rumah : rumah pondok gubuk
 short         name "Rumah"
 x             3
 y             1

{look
write "Kamu berada di dalam rumahmu yang kecil tapi nyaman. "
write "Dindingnya terbuat dari bambu dan atapnya dari daun "
write "kelapa. Ada sebuah tikar di lantai dan sebuah meja "
write "kayu kecil di sudut. "
if pintu has CLOSED
   write "Sebuah pintu kayu ke selatan tertutup.^"
else
   write "Sebuah pintu kayu ke selatan terbuka, menuju sawah.^"
endif
}

{movement
if compass = south
   if destination = nowhere
      write "Pintu tertutup. Kamu harus membukanya terlebih dahulu.^"
      return
   endall
return false
}

object pintu : pintu
 short         sebuah "pintu kayu"
 has           CLOSABLE CLOSED
 mass          scenery

{examine
if pintu has CLOSED
   write "Sebuah pintu kayu sederhana yang tertutup. Pintunya mengarah ke selatan.^"
else
   write "Sebuah pintu kayu sederhana yang terbuka. Melalui pintu, kamu bisa melihat sawah.^"
endif
}

{open_override
ensure pintu hasnt CLOSED
write "Kamu membuka pintu kayu.^"
set rumah(south) = sawah
set sawah(north) = rumah
}

{close_override
ensure pintu has CLOSED
write "Kamu menutup pintu kayu.^"
set rumah(south) = nowhere
set sawah(north) = nowhere
}

object tikar : tikar
 short         sebuah "tikar"
 mass          scenery

{examine
write "Tikar ini terbuat dari anyaman pandan. Kamu tidur di atasnya setiap malam.^"
}

{take
write "Tikar itu terlalu berat untuk dibawa sendiri.^"
set time = false
}

object meja : meja kayu
 short         sebuah "meja kayu"
 has           SURFACE
 mass          scenery

{examine
write "Meja kayu kecil yang sederhana. Permukaannya halus karena sudah sering dipakai.^"
}

object cangkir : cangkir kopi
 short         sebuah "cangkir kopi"
 long          "Sebuah cangkir kopi ada di atas meja.^"
 parent        meja
 mass          5

{examine
write "Cangkir keramik berisi kopi hitam yang masih hangat.^"
}

{drink
write "Kamu menyeruput kopi hitam. Pahit tapi enak.^"
}

object atap_rumah : atap
 short         sebuah "atap"
 mass          scenery

{examine
write "Atap rumahmu terbuat dari daun kelapa kering yang diikat rapat. "
write "Melindungi dari hujan dan panas.^"
}

object daun_kelapa : daun kelapa
 short         name "daun kelapa"
 mass          scenery

{examine
write "Daun kelapa kering yang dianyam dan digunakan sebagai bahan atap rumah tradisional.^"
}

object sudut : sudut pojok
 short         sebuah "sudut"
 mass          scenery

{examine
write "Sudut ruangan tempat meja kayu kecilmu diletakkan.^"
}

# -----------------------------------------------------------------------------

location sawah : sawah padi
 short         name "Sawah"
 has           OUTDOORS
 west          jalan_utama
 x             3
 y             2

{look
print:
   Kamu berdiri di tepi sawah yang luas. Tanaman padi
   berwarna hijau terang bergoyang tertiup angin. Di
   kejauhan, kamu bisa melihat gunung. Rumahmu yang kecil
   terletak di sebelah utara. Jalan menuju desa ada di
   sebelah barat.^
.
execute "+weather_line"
}

object segehan : segehan sesajen_tanah persembahan
 short         sebuah "segehan"
 long          "Sebuah segehan diletakkan di tanah dekat pintu rumahmu.^"
 mass          scenery

{examine
print:
   Segehan adalah sesajen kecil untuk para bhuta kala,
   roh-roh rendah yang menjaga keseimbangan alam. Terbuat
   dari potongan daun pisang berisi nasi warna-warni,
   garam kasar, sekerat jahe, bawang merah, dan beberapa
   kelopak bunga. Di sebelahnya tersulut sebatang dupa
   yang asapnya mengepul pelan. Ibumu meletakkannya
   setiap pagi dan sore di depan pintu, di persimpangan,
   dan di sudut halaman, agar rumah tetap damai dan
   terhindar dari gangguan.^
.
}

{take
write "Segehan itu sedang dipersembahkan. Sebaiknya jangan diganggu.^"
set time = false
}

object padi : padi tanaman
 short         name "padi"
 mass          scenery

{examine
write "Tanaman padi tumbuh subur. Butirnya hampir siap dipanen.^"
}

object capung : capung
 short         seekor "capung"
 mass          scenery

{examine
write "Capung berwarna biru terbang rendah di atas air sawah.^"
}

object kuntul : kuntul burung bangau putih
 short         seekor "kuntul putih"
 long          "Seekor kuntul putih berdiri diam di tepi sawah, mengawasi air.^"
 has           ANIMATE
 mass          scenery

{examine
write "Burung kuntul putih dengan kaki panjang dan paruh kuning. "
write "Dia berdiri sabar menunggu ikan atau katak kecil di air sawah.^"
}

{take
write "Kuntul itu terbang menjauh sebelum kamu bisa mendekat.^"
set time = false
}

{talk
write "Kuntul itu memiringkan kepalanya dan menatapmu sejenak, lalu kembali mengawasi air.^"
}

object gunung : gunung
 short         sebuah "gunung"
 mass          scenery

{examine
write "Gunung biru menjulang tinggi di kejauhan. "
write "Puncaknya kadang tertutup awan.^"
}

object angin : angin
 short         name "angin"
 mass          scenery

{examine
write "Angin sejuk berhembus dari arah gunung, menggoyangkan tanaman padi dengan lembut.^"
}

object tepi_sawah : tepi
 short         name "tepi sawah"
 mass          scenery

{examine
write "Tanah pematang yang membatasi petak-petak sawah. "
write "Cukup lebar untuk dilewati satu orang.^"
}

# -----------------------------------------------------------------------------

location jalan_utama : jalan utama
 short         name "Jalan Utama"
 has           OUTDOORS
 east          sawah
 north         warung
 south         banjar
 northeast     gang
 west          pura
 southwest     pasar
 x             1
 y             2

{look
print:
   Kamu berada di jalan utama desa. Jalan tanah ini
   menghubungkan seluruh desa. Di sebelah utara ada
   sebuah warung kecil. Sebuah jalan kecil menuju ke
   selatan ke banjar. Ke timur, jalan mengarah ke sawah.
   Sebuah gang sempit mengarah ke timur laut. Ke barat
   terlihat gerbang pura desa, dan ke barat daya ada
   pasar yang ramai.^
.
execute "+weather_line"
}

object anak : anak made
 short         name "Made"
 long          "Seorang anak kecil bernama Made sedang bermain di jalan.^"
 has           ANIMATE
 mass          heavy
 parent        jalan_utama

{examine
write "Anak kecil berumur sekitar tujuh tahun. Dia memakai kaus oranye "
write "dan celana pendek. Matanya berbinar penuh rasa ingin tahu.^"
}

{talk_to
write "~Halo, Kakak!~ kata Made sambil melambai. ~Mau main?~^"
}

{ask_about_nama
write "~Nama saya Made,~ katanya. ~Saya tinggal di sebelah warung.~^"
}

{ask_about_sekolah
write "~Saya kelas dua SD,~ kata Made bangga. ~Guru saya baik sekali.~^"
}

{ask_about_permainan
write "~Saya suka main bola dan layang-layang,~ kata Made. "
write "~Tapi kalau hujan, saya main di rumah saja.~^"
}

{ask_about_hujan
write "~Saya tidak takut hujan!~ kata Made sambil tertawa. "
write "~Tapi Ibu marah kalau saya basah.~^"
}

{ask_about_ibu
write "~Ibu saya tinggal dekat sini,~ kata Made. "
write "~Dia sedang memasak nasi untuk makan siang.~^"
}

object jalan_tanah : jalan tanah
 short         name "jalan tanah"
 mass          scenery

{examine
write "Jalan tanah yang dipadatkan oleh kaki-kaki warga desa. "
write "Menghubungkan seluruh sudut desa.^"
}

# -----------------------------------------------------------------------------

location gang : gang lorong jalan_sempit
 short         name "Gang sempit"
 has           OUTDOORS
 southwest     jalan_utama
 northeast     rumah_teman
 x             2
 y             1

{look
print:
   Kamu berada di sebuah gang sempit di antara dua rumah
   bambu. Dindingnya penuh dengan jemuran pakaian dan
   beberapa pot tanaman. Jalan utama ada di sebelah
   barat daya. Rumah sahabatmu, Ketut, terlihat di
   ujung timur laut; pintu depannya sedang terbuka
   lebar menyambut tamu.^
.
execute "+weather_line"
}

object pohon : pohon besar
 short         sebuah "pohon besar"
 mass          scenery

{examine
write "Pohon beringin yang besar dan tua. Akarnya menjalar ke mana-mana.^"
}

object anjing : anjing
 short         seekor "anjing"
 long          "Seekor anjing tidur di bawah pohon.^"
 mass          scenery

{examine
write "Anjing kampung yang kurus sedang tidur di bawah pohon. "
write "Telinganya bergerak-gerak mengusir lalat.^"
}

{talk_to
write "Anjing itu mengangkat kepalanya sebentar, lalu tidur lagi.^"
}

object rumah_bambu : rumah bambu
 short         dua "rumah bambu"
 mass          scenery

{examine
write "Dua rumah bambu tradisional berdiri di kiri dan kanan gang. "
write "Dindingnya terbuat dari anyaman bambu yang rapat, atapnya dari daun kelapa.^"
}

object jemuran : jemuran pakaian baju
 short         sebuah "jemuran pakaian"
 mass          scenery

{examine
write "Pakaian warna-warni tergantung di tali bambu, dijemur di bawah sinar matahari pagi.^"
}

object pot_tanaman : pot tanaman
 short         beberapa "pot tanaman"
 mass          scenery

{examine
write "Beberapa pot tanah liat berisi tanaman hias kecil. Daunnya hijau segar.^"
}

# -----------------------------------------------------------------------------

location rumah_teman : pondok
 short         name "Rumah Ketut"
 southwest     gang
 x             3
 y             0

{look
print:
   Kamu berada di ruang tamu rumah sahabatmu, Ketut.
   Ruangan ini kecil tapi hangat dan nyaman — khas rumah
   desa yang selalu siap menerima tamu. Dua kursi kayu
   mengapit sebuah meja rendah di tengah, di atasnya
   tersaji teh hangat dan sepiring kue manis. Dinding
   bambu dihiasi foto keluarga, dan jendela terbuka
   menghadap halaman kecil dengan pohon kamboja. Pintu
   depan mengarah ke barat daya, kembali ke gang.^
.
}

object pintu_depan : pintu depan
 short         sebuah "pintu depan"
 mass          scenery

{examine
write "Pintu kayu sederhana yang menjadi batas antara rumah dan gang. "
write "Pagi ini sengaja dibuka lebar agar tamu merasa dipersilakan masuk.^"
}

{knock_on
write "Kamu mengetuk pintu pelan sebagai tanda sopan. "
write "~Silakan, jangan sungkan, pintu sudah terbuka!~ sahut Ketut sambil tertawa.^"
}

object ketut : ketut pemuda
 short         name "Ketut"
 long          "Ketut, sahabatmu, duduk santai di kursi sambil menyambutmu dengan hangat.^"
 has           ANIMATE
 mass          heavy

{examine
write "Ketut adalah sahabat lamamu sejak kecil. Pemuda ramah yang "
write "selalu senang menerima tamu. Dia mengenakan kain sarung dan "
write "kaus putih sederhana. Senyumnya hangat dan sopan.^"
}

{talk_to
write "~Selamat datang di rumah saya, sahabatku!~ kata Ketut sambil "
write "berdiri menyambutmu. ~Terima kasih sudah berkunjung. Silakan "
write "duduk dulu, kita ngobrol sebentar. Tehnya masih hangat.~^"
}

{ask_about_kunjungan
write "~Kunjunganmu hari ini membuat saya senang,~ kata Ketut. "
write "~Di desa kami, berkunjung ke rumah teman adalah cara menjaga "
write "persahabatan.~^"
}

{ask_about_silaturahmi
write "~Silaturahmi artinya merawat hubungan baik antar saudara, "
write "kawan, dan tetangga,~ jelas Ketut. ~Dengan bertamu dan "
write "menerima tamu, kita tetap akrab walaupun sibuk.~^"
}

{ask_about_buku_tamu
write "~Tamu adalah raja, kata orang tua dulu,~ ujar Ketut tersenyum. "
write "~Seorang tuan rumah yang baik wajib menyambut tamunya dengan "
write "ramah dan menghidangkan minuman.~^"
}

{ask_about_berkunjung : ask_about_bertamu : ask_about_mampir : ask_about_bertandang
write "~Berkunjung, bertamu, mampir, atau bertandang — semuanya berarti "
write "datang ke rumah orang lain,~ kata Ketut. ~Yang penting tuan rumah "
write "merasa dihormati dan tamu merasa diterima.~^"
}

{ask_about_teman : ask_about_sahabat : ask_about_kawan
write "~Kita sudah berteman sejak kecil,~ kenang Ketut. "
write "~Sahabat sejati itu seperti saudara. Kawan lama memang paling "
write "enak diajak ngobrol berjam-jam tanpa bosan.~^"
}

{ask_about_rumah
write "~Rumah sederhana ini milik keluarga saya,~ kata Ketut. "
write "~Tidak besar, tapi cukup untuk menjamu teman. Anggap saja "
write "rumah sendiri kalau mampir ke sini.~^"
}

{ask_about_teh : ask_about_minuman
write "~Silakan minum tehnya selagi hangat,~ kata Ketut mempersilakan. "
write "~Teh manis adalah sajian wajib untuk tamu di desa kami.~^"
}

{ask_about_kue : ask_about_hidangan : ask_about_sajian
write "~Kue ini buatan ibu saya pagi tadi,~ kata Ketut bangga. "
write "~Onde-onde, klepon, dan pisang goreng — hidangan kecil untuk "
write "menemani obrolan kita.~^"
}

{ask_about_keluarga
write "~Ayah saya bekerja di sawah, ibu saya menjual kue di pasar,~ "
write "kata Ketut. ~Adik saya sekolah di kota. Keluarga kami sederhana "
write "tapi rukun.~^"
}

{ask_about_desa
write "~Desa kita ramah dan tenang,~ kata Ketut. ~Tetangga saling "
write "kenal, dan pintu rumah selalu terbuka untuk tamu. Itulah "
write "silaturahmi.~^"
}

{ask_about_undangan : ask_about_mengundang
write "~Kapan-kapan kamu harus datang lagi,~ kata Ketut. ~Anggap "
write "ini undangan tetap — mampirlah kapan saja kamu lewat gang. "
write "Saya akan selalu mengundangmu untuk ngobrol.~^"
}

{ask_about_pamit
write "~Tidak perlu buru-buru pamit,~ kata Ketut sambil tertawa. "
write "~Tapi kalau harus pulang, cukup bilang ~selamat tinggal~. "
write "Jangan lupa salam untuk keluargamu di rumah.~^"
}

{ask_about_sopan : ask_about_hormat : ask_about_menghormati
write "~Tamu yang sopan selalu memberi salam dulu sebelum masuk,~ "
write "kata Ketut. ~Dan tuan rumah yang baik menghormati tamu dengan "
write "menyajikan yang terbaik.~^"
}

{ask_about_salam : ask_about_sambutan : ask_about_menyambut
write "~Kalau datang, ucapkan salam: ~Permisi!~ atau ~Kulanuwun!~ ~ "
write "kata Ketut. ~Saya akan menjawab, ~Selamat datang, silakan "
write "masuk!~ Itu tanda tamu diterima dengan hati terbuka.~^"
}

{ask_about_ngobrol : ask_about_obrolan : ask_about_percakapan
write "~Ngobrol santai dengan kawan itu obat hati,~ kata Ketut. "
write "~Percakapan yang hangat sambil minum teh membuat hari menjadi "
write "lebih ringan.~^"
}

{ask_about_ramah : ask_about_tuan_rumah
write "~Tuan rumah yang ramah adalah kebanggaan keluarga,~ kata Ketut. "
write "~Kita menyambut tamu dengan senyum dan hati terbuka — itulah "
write "adat desa kami.~^"
}

object kursi : kursi kayu
 short         sebuah "kursi kayu"
 long          "Dua kursi kayu mengapit meja rendah di tengah ruangan.^"
 mass          scenery

{examine
write "Kursi kayu sederhana yang nyaman untuk duduk berlama-lama "
write "sambil ngobrol dengan tuan rumah.^"
}

{sit_on
write "Kamu duduk di kursi kayu. Ketut tersenyum lebar. "
write "~Nah begitu, anggap rumah sendiri. Mari kita ngobrol.~^"
}

object meja_rendah : meja rendah
 short         sebuah "meja rendah"
 has           SURFACE
 mass          scenery

{examine
write "Meja kayu rendah di tengah ruang tamu. Di atasnya tersaji "
write "teh hangat dan sepiring kue — sajian khas untuk menyambut tamu.^"
}

object teh : teh hangat
 short         secangkir "teh hangat"
 long          "Secangkir teh hangat mengepul di atas meja — sajian untuk tamu.^"
 parent        meja_rendah
 mass          2

{examine
write "Teh manis yang masih mengepul. Wanginya melati. "
write "Hangat sekali dipegang di tangan.^"
}

{drink
write "Kamu menyeruput teh hangatnya pelan-pelan. "
write "~Terima kasih sudah menikmati sajian saya,~ kata Ketut senang. "
write "~Tamu harus menghabiskan hidangan tuan rumah.~^"
}

{take
write "Sebaiknya teh itu dinikmati di tempat, sebagai tamu yang sopan.^"
set time = false
}

object kue : kue gorengan onde klepon
 short         sepiring "kue manis"
 long          "Sepiring kue manis disajikan di atas meja untuk tamu.^"
 parent        meja_rendah
 mass          1

{examine
write "Berbagai kue kecil: onde-onde berbalut wijen, klepon hijau "
write "berisi gula merah, dan pisang goreng yang masih hangat. "
write "Hidangan khas untuk menyambut tamu.^"
}

{eat
write "Kamu mencicipi satu kue. Manis dan gurih sekaligus. "
write "~Nikmati saja, masih banyak,~ kata Ketut ramah. "
write "~Tuan rumah senang kalau tamunya makan dengan lahap.~^"
}

{take
write "Sebaiknya kue itu dinikmati di tempat bersama tuan rumah.^"
set time = false
}

object foto_keluarga : foto keluarga gambar
 short         sebuah "foto keluarga"
 mass          scenery

{examine
write "Foto hitam putih keluarga Ketut. Orang tuanya berdiri tegak, "
write "adik kecilnya tersenyum lebar. Foto ini digantung dengan "
write "bangga di dinding ruang tamu.^"
}

object jendela_teman : jendela
 short         sebuah "jendela"
 mass          scenery

{examine
write "Jendela kayu terbuka lebar. Angin sejuk masuk dari halaman, "
write "membawa wangi bunga kamboja.^"
}

object kamboja : pohon kamboja
 short         sebuah "pohon kamboja"
 mass          scenery

{examine
write "Pohon kamboja tumbuh di halaman, bunganya putih dengan "
write "tengah kuning. Aromanya lembut dan harum.^"
}

