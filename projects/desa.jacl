{examine
write "Ruang tamu sederhana — tempat Ketut biasa menerima teman dan tetangga yang berkunjung.^"
}

object dinding_bambu : dinding bambu
 short         name "dinding bambu"
 mass          scenery

{examine
write "Dinding rumah Ketut terbuat dari anyaman bambu yang rapi, "
write "dihiasi beberapa foto keluarga.^"
}

